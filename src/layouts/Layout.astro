---
import '../styles/components.css';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  canonical?: string;
  type?: 'website' | 'article';
  publishDate?: string;
}

const {
  title = "Müfettiş | Sınav Hazırlık Notları, Makaleler ve Çözümlü Deneme Sınavları",
  description = "Banka Müfettişliği, SPL Lisanslama, MASAK Uyum Görevlisi ve CIA sınavlarına hazırlık için kapsamlı ders notları, mevzuat özetleri ve çözümlü testler.",
  image = "/wp-content/uploads/2026/04/mufettis.org_-scaled.png",
  canonical = Astro.url.href,
  type = "website",
  publishDate
} = Astro.props;

const siteName = "mufettis.org";
const fullTitle = title.includes("Müfettiş") || title.includes("mufettis") ? title : `${title} | Müfettiş.org`;
const ogImage = image ? (image.startsWith('http') ? image : `https://mufettis.org${image}`) : 'https://mufettis.org/wp-content/uploads/2026/04/mufettis.org_-scaled.png';
---

<!doctype html>
<html lang="tr" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/png" href="/wp-content/uploads/2026/04/cropped-mufettis.org-favicon-1-180x180.png" />
    <link rel="canonical" href={canonical} />

    <!-- Primary Meta Tags -->
    <title>{fullTitle}</title>
    <meta name="title" content={fullTitle} />
    <meta name="description" content={description} />
    <meta name="author" content="mufettis.org" />
    <meta name="robots" content="index, follow" />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:site_name" content={siteName} />
    {publishDate && <meta property="article:published_time" content={publishDate} />}

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={canonical} />
    <meta property="twitter:title" content={fullTitle} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={ogImage} />

    <!-- Google Structured Data (Schema.org JSON-LD) -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@graph": [
        {
          "@type": "WebSite",
          "@id": "https://mufettis.org/#website",
          "url": "https://mufettis.org/",
          "name": "Müfettiş.org",
          "description": "Banka Müfettişliği, SPL, MASAK ve CIA Sınav Hazırlık Portalı",
          "publisher": {
            "@type": "EducationalOrganization",
            "name": "mufettis.org",
            "url": "https://mufettis.org/",
            "logo": {
              "@type": "ImageObject",
              "url": "https://mufettis.org/wp-content/uploads/2026/04/cropped-mufettis.org-favicon-1-180x180.png"
            }
          },
          "potentialAction": {
            "@type": "SearchAction",
            "target": "https://mufettis.org/?s={search_term_string}",
            "query-input": "required name=search_term_string"
          }
        },
        ...(type === 'article' ? [{
          "@type": "Article",
          "@id": `${canonical}#article`,
          "isPartOf": { "@id": "https://mufettis.org/#website" },
          "headline": fullTitle,
          "description": description,
          "image": ogImage,
          "datePublished": publishDate || "2026-04-01T00:00:00Z",
          "author": {
            "@type": "Organization",
            "name": "mufettis.org Denetim ve Mevzuat Kurulu",
            "url": "https://mufettis.org/"
          },
          "publisher": {
            "@type": "EducationalOrganization",
            "name": "mufettis.org",
            "url": "https://mufettis.org/"
          }
        }] : [])
      ]
    })} />

    <!-- Fonts: Plus Jakarta Sans for UI + Lora for Editorial -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800;900&family=Lora:ital,wght@0,400;0,500;0,600;1,400&family=JetBrains+Mono:wght@400;600&display=swap" rel="stylesheet">

    <!-- Theme Initialization Script -->
    <script is:inline>
      const theme = (() => {
        if (typeof localStorage !== 'undefined' && localStorage.getItem('theme')) {
          return localStorage.getItem('theme');
        }
        if (window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches) {
          return 'dark';
        }
        return 'light';
      })();
      if (theme === 'dark') {
        document.documentElement.classList.add('dark');
      } else {
        document.documentElement.classList.remove('dark');
      }
    </script>
  </head>
  <body class="bg-[#f8fafc] text-slate-800 dark:bg-[#060d16] dark:text-slate-100 font-sans antialiased min-h-screen flex flex-col selection:bg-brand-600 selection:text-white transition-colors duration-200">
    
    <!-- Top Financial / Announcement Bar -->
    <div class="bg-[#071626] text-slate-300 text-[11px] border-b border-brand-900/60 py-2 px-4 select-none">
      <div class="max-w-7xl mx-auto flex flex-wrap items-center justify-between gap-3">
        
        <!-- Live Financial Ticker & Announcements -->
        <div class="flex items-center gap-4 overflow-x-auto whitespace-nowrap scrollbar-none py-0.5">
          <span class="inline-flex items-center gap-1.5 font-extrabold text-amber-400 bg-amber-950/60 border border-amber-800/40 px-2.5 py-0.5 rounded-full text-[10px] uppercase tracking-wider shadow-xs">
            <span class="w-1.5 h-1.5 rounded-full bg-amber-400 animate-ping"></span>
            Canlı Finans
          </span>
          <span class="text-slate-300"><strong>BIST 100:</strong> <span class="text-emerald-400 font-semibold">9.145,20 ▲</span></span>
          <span class="text-slate-600">•</span>
          <span class="text-slate-300"><strong>USD/TRY:</strong> 34,28</span>
          <span class="text-slate-600">•</span>
          <span class="text-slate-300"><strong>EUR/TRY:</strong> 37,22</span>
          <span class="text-slate-600">•</span>
          <span class="text-slate-300"><strong>Gram Altın:</strong> <span class="text-emerald-400 font-semibold">3.035 TL ▲</span></span>
          <span class="text-slate-600">•</span>
          <span class="text-amber-300 font-semibold flex items-center gap-1">
