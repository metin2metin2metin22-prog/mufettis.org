---
interface Props {
  title?: string;
  description?: string;
  image?: string;
  canonical?: string;
  type?: 'website' | 'article';
  publishDate?: string;
}

const {
  title = "Müfettiş | Sınav Hazırlık Notları, Makaleler ve Çözümlü Deneme Sınavları",
  description = "Banka Müfettişliği, SPL Lisanslama, MASAK Uyum Görevlisi ve CIA sınavlarına hazırlık için kapsamlı ders notları, mevzuat özetleri ve çözümlü testler.",
  image = "/wp-content/uploads/2026/04/mufettis.org_-scaled.png",
  canonical = Astro.url.href,
  type = "website",
  publishDate
} = Astro.props;

const siteName = "mufettis.org";
const fullTitle = title.includes("Müfettiş") || title.includes("mufettis") ? title : `${title} | Müfettiş`;
---

<!doctype html>
<html lang="tr" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/png" href="/wp-content/uploads/2026/04/cropped-mufettis.org-favicon-1-180x180.png" />
    <link rel="canonical" href={canonical} />

    <!-- Primary Meta Tags -->
    <title>{fullTitle}</title>
    <meta name="title" content={fullTitle} />
    <meta name="description" content={description} />
    <meta name="author" content="mufettis.org" />
    <meta name="robots" content="index, follow" />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={image} />
    <meta property="og:site_name" content={siteName} />
    {publishDate && <meta property="article:published_time" content={publishDate} />}

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={canonical} />
    <meta property="twitter:title" content={fullTitle} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={image} />

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&family=Merriweather:ital,wght@0,300;0,400;0,700;1,300&display=swap" rel="stylesheet">

    <!-- Theme Mode Initialization Script -->
    <script is:inline>
      const theme = (() => {
        if (typeof localStorage !== 'undefined' && localStorage.getItem('theme')) {
          return localStorage.getItem('theme');
        }
        if (window.matchMedia('(prefers-color-scheme: dark)').matches) {
          return 'dark';
        }
        return 'light';
      })();
      if (theme === 'dark') {
        document.documentElement.classList.add('dark');
      } else {
        document.documentElement.classList.remove('dark');
      }
    </script>
  </head>
  <body class="bg-slate-50 text-slate-800 dark:bg-slate-950 dark:text-slate-100 font-sans antialiased min-h-screen flex flex-col selection:bg-brand-500 selection:text-white">
    
    <!-- Top Announcement Bar -->
    <header class="bg-brand-950 text-slate-300 text-xs border-b border-brand-900 py-2 px-4">
      <div class="max-w-7xl mx-auto flex items-center justify-between">
        <div class="flex items-center gap-2">
          <span class="inline-block w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
          <span class="font-medium text-slate-200">2026 Sınav Dönemi:</span>
          <span class="hidden sm:inline text-slate-400">SPL, MASAK ve CIA Çözümlü Deneme Setleri Yayında</span>
        </div>
        <div class="flex items-center gap-4">
          <a href="/deneme-sinavlari/" class="hover:text-amber-400 transition-colors flex items-center gap-1">
            <span>⚡ Deneme Sınavları</span>
          </a>
          <button id="theme-toggle" type="button" aria-label="Karanlık Mod Geçişi" class="p-1 rounded-md hover:bg-brand-900 text-slate-300 hover:text-white transition-colors">
            <span class="dark:hidden">🌙 Koyu Mod</span>
            <span class="hidden dark:inline">☀️ Aydınlık Mod</span>
          </button>
        </div>
      </div>
    </header>

    <!-- Main Navigation Bar -->
    <nav class="sticky top-0 z-40 bg-white/95 dark:bg-slate-900/95 backdrop-blur-md border-b border-slate-200 dark:border-slate-800 shadow-sm transition-colors">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex items-center justify-between h-18">
          
          <!-- Logo -->
          <a href="/" class="flex items-center gap-3 group">
            <div class="w-10 h-10 rounded-xl bg-gradient-to-br from-brand-900 via-brand-800 to-brand-600 flex items-center justify-center text-white shadow-md shadow-brand-900/20 group-hover:scale-105 transition-transform">
              <svg class="w-5 h-5 text-amber-400" fill="currentColor" viewBox="0 0 24 24">
                <path d="M12 1L3 5v6c0 5.55 3.84 10.74 9 12 5.16-1.26 9-6.45 9-12V5l-9-4zm0 10.99h7c-.53 4.12-3.28 7.79-7 8.94V12H5V6.3l7-3.11v8.8z"/>
              </svg>
            </div>
            <div class="flex flex-col">
              <span class="text-xl font-extrabold tracking-tight text-slate-900 dark:text-white flex items-center">
                MÜFETTİŞ<span class="text-brand-600 dark:text-brand-400">.ORG</span>
              </span>
              <span class="text-[11px] font-medium tracking-wide text-slate-500 dark:text-slate-400 -mt-1">
                Denetim, Sınav & Finans Kütüphanesi
              </span>
            </div>
          </a>

          <!-- Desktop Navigation Links -->
          <div class="hidden md:flex items-center gap-1 font-medium text-sm text-slate-700 dark:text-slate-300">
            <a href="/" class="px-3 py-2 rounded-lg hover:text-brand-600 dark:hover:text-brand-400 hover:bg-slate-100 dark:hover:bg-slate-800 transition-colors">Anasayfa</a>
            <a href="/category/spl-ders-notlari/" class="px-3 py-2 rounded-lg hover:text-brand-600 dark:hover:text-brand-400 hover:bg-slate-100 dark:hover:bg-slate-800 transition-colors">SPL Notları</a>
            <a href="/category/masak-uyum-gorevlisi-yetkilendirme-ders-notlari/" class="px-3 py-2 rounded-lg hover:text-brand-600 dark:hover:text-brand-400 hover:bg-slate-100 dark:hover:bg-slate-800 transition-colors">MASAK</a>
            <a href="/category/cia-ders-notlari/" class="px-3 py-2 rounded-lg hover:text-brand-600 dark:hover:text-brand-400 hover:bg-slate-100 dark:hover:bg-slate-800 transition-colors">CIA Part 1</a>
            <a href="/category/banka-denetimi/" class="px-3 py-2 rounded-lg hover:text-brand-600 dark:hover:text-brand-400 hover:bg-slate-100 dark:hover:bg-slate-800 transition-colors">Banka Denetimi</a>
            <a href="/deneme-sinavlari/" class="px-3 py-2 rounded-lg text-amber-600 dark:text-amber-400 font-semibold hover:bg-amber-50 dark:hover:bg-amber-950/30 transition-colors flex items-center gap-1.5">
              <span class="w-2 h-2 rounded-full bg-amber-500 animate-ping"></span>
              Çözümlü Sınavlar
            </a>
          </div>

          <!-- Search Trigger & CTA -->
          <div class="flex items-center gap-2">
            <button id="search-trigger" type="button" aria-label="Ara" class="p-2.5 rounded-xl text-slate-600 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800 transition-colors flex items-center gap-2 border border-slate-200 dark:border-slate-700/60 text-sm">
              <svg class="w-4 h-4 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path></svg>
              <span class="hidden sm:inline text-xs text-slate-400">Konu veya soru ara...</span>
              <kbd class="hidden sm:inline-block px-1.5 py-0.5 text-[10px] font-semibold text-slate-400 bg-slate-100 dark:bg-slate-800 border border-slate-200 dark:border-slate-700 rounded">Ctrl K</kbd>
            </button>
            <a href="/admin/" target="_blank" class="hidden lg:inline-flex items-center gap-1.5 text-xs font-semibold text-brand-700 dark:text-brand-300 bg-brand-50 dark:bg-brand-950/50 hover:bg-brand-100 dark:hover:bg-brand-900/60 px-3 py-2 rounded-xl border border-brand-200 dark:border-brand-800 transition-colors">
              <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path></svg>
              Panel
            </a>
          </div>

        </div>
      </div>
    </nav>

    <!-- Main Content Area -->
    <main class="flex-grow">
      <slot />
    </main>

    <!-- Site Footer -->
    <footer class="bg-brand-950 text-slate-400 border-t border-brand-900/80 pt-16 pb-12 mt-20">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="grid grid-cols-1 md:grid-cols-4 gap-10 pb-12 border-b border-brand-900">
          
          <!-- Column 1: Brand Info -->
          <div class="md:col-span-1 space-y-4">
            <a href="/" class="flex items-center gap-2">
              <div class="w-8 h-8 rounded-lg bg-brand-800 flex items-center justify-center text-amber-400">
                <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M12 1L3 5v6c0 5.55 3.84 10.74 9 12 5.16-1.26 9-6.45 9-12V5l-9-4zm0 10.99h7c-.53 4.12-3.28 7.79-7 8.94V12H5V6.3l7-3.11v8.8z"/></svg>
              </div>
              <span class="text-lg font-bold text-white tracking-tight">mufettis.org</span>
            </a>
            <p class="text-sm text-slate-400 leading-relaxed">
              Müfettişlik, denetim, SPL lisanslama ve MASAK sınavlarına hazırlanan adaylar ve kariyerine yön veren profesyoneller için bağımsız kaynak portalı.
            </p>
            <div class="text-xs text-slate-400">
              ⚡ 52+ Özgün Makale & Çözümlü Sınav Modülü
            </div>
          </div>

          <!-- Column 2: Sınav Kategorileri -->
          <div>
            <h4 class="text-sm font-semibold text-white uppercase tracking-wider mb-4">Sınav Notları</h4>
            <ul class="space-y-2.5 text-sm">
              <li><a href="/category/spl-ders-notlari/" class="hover:text-white transition-colors">SPL Lisanslama Notları</a></li>
              <li><a href="/category/masak-uyum-gorevlisi-yetkilendirme-ders-notlari/" class="hover:text-white transition-colors">MASAK Uyum Görevlisi</a></li>
              <li><a href="/category/cia-ders-notlari/" class="hover:text-white transition-colors">CIA Part 1 Notları</a></li>
              <li><a href="/category/banka-denetimi/" class="hover:text-white transition-colors">Banka Denetimi & Mevzuat</a></li>
              <li><a href="/category/mali-analiz-kutuphanesi/" class="hover:text-white transition-colors">Mali Analiz Kütüphanesi</a></li>
            </ul>
          </div>

          <!-- Column 3: Çözümlü Testler & Denemeler -->
          <div>
            <h4 class="text-sm font-semibold text-white uppercase tracking-wider mb-4">Deneme Sınavları</h4>
            <ul class="space-y-2.5 text-sm">
              <li><a href="/deneme-sinavi-genis-kapsamli-sermaye-piyasasi-mevzuati-ve-meslek-kurallari-1/" class="hover:text-white transition-colors">SPL Mevzuat Deneme Sınavı</a></li>
              <li><a href="/cia-part-1-deneme-sorulari-20-soru-cozumlu-ve-aciklamali-test/" class="hover:text-white transition-colors">CIA Part 1 Çözümlü Test 1</a></li>
              <li><a href="/masak-uyum-gorevlisi-yetkilendirme-deneme-sinavi-modul-1/" class="hover:text-white transition-colors">MASAK Modül 1 Denemesi</a></li>
              <li><a href="/spl-yatirim-kuruluslari-deneme-sinavi/" class="hover:text-white transition-colors">SPL Yatırım Kuruluşları Testi</a></li>
              <li><a href="/deneme-sinavlari/" class="hover:text-amber-400 font-medium transition-colors">Tüm Sınavları Gör →</a></li>
            </ul>
          </div>

          <!-- Column 4: Kurumsal & Bağlantılar -->
          <div>
            <h4 class="text-sm font-semibold text-white uppercase tracking-wider mb-4">Kurumsal</h4>
            <ul class="space-y-2.5 text-sm">
              <li><a href="/hakkimizda/" class="hover:text-white transition-colors">Hakkımızda</a></li>
              <li><a href="/iletisim/" class="hover:text-white transition-colors">İletişim</a></li>
              <li><a href="/privacy-policy/" class="hover:text-white transition-colors">Gizlilik Politikası</a></li>
              <li><a href="/sitemap-index.xml" class="hover:text-white transition-colors">Site Haritası (XML)</a></li>
              <li><a href="/admin/" class="hover:text-white transition-colors">İçerik Yönetim Paneli</a></li>
            </ul>
          </div>

        </div>

        <div class="pt-8 flex flex-col sm:flex-row items-center justify-between text-xs text-slate-400 gap-4">
          <p>© {new Date().getFullYear()} mufettis.org – Tüm hakları saklıdır. Bu sitede yer alan içerikler eğitim ve sınavlara hazırlık amaçlıdır.</p>
          <p class="flex items-center gap-2">
            <span>Sıfır Sunucu Kesintisi</span>
            <span>•</span>
            <span class="text-emerald-400 font-medium">100% SEO Korumalı</span>
          </p>
        </div>
      </div>
    </footer>

    <!-- Search Modal Component -->
    <div id="search-modal" class="fixed inset-0 z-50 hidden bg-slate-900/70 backdrop-blur-sm p-4 sm:p-6 md:p-20 flex justify-center items-start overflow-y-auto">
      <div class="bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-2xl w-full max-w-2xl shadow-2xl overflow-hidden mt-10">
        <div class="p-4 border-b border-slate-200 dark:border-slate-800 flex items-center gap-3">
          <svg class="w-5 h-5 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path></svg>
          <input id="search-input" type="text" placeholder="Sınav konusu, kanun, makale veya soru ara..." class="w-full bg-transparent text-slate-900 dark:text-white placeholder-slate-400 outline-none text-base sm:text-lg" />
          <button id="search-close" type="button" class="text-xs bg-slate-100 dark:bg-slate-800 hover:bg-slate-200 dark:hover:bg-slate-700 text-slate-500 rounded px-2 py-1">ESC</button>
        </div>
        <div id="search-results" class="max-h-96 overflow-y-auto p-4 space-y-2 text-sm">
          <div class="text-center py-8 text-slate-400">Aramak istediğiniz konuyu yazın...</div>
        </div>
      </div>
    </div>

    <!-- Theme Toggle & Search Logic -->
    <script>
      // Theme toggle
      const toggle = document.getElementById('theme-toggle');
      if (toggle) {
        toggle.addEventListener('click', () => {
          const isDark = document.documentElement.classList.toggle('dark');
          localStorage.setItem('theme', isDark ? 'dark' : 'light');
        });
      }

      // Search Modal
      const modal = document.getElementById('search-modal');
      const trigger = document.getElementById('search-trigger');
      const closeBtn = document.getElementById('search-close');
      const input = document.getElementById('search-input') as HTMLInputElement;
      const results = document.getElementById('search-results');

      let allPosts = [];
      fetch('/api/search.json')
        .then(res => res.json())
        .then(data => { allPosts = data; })
        .catch(() => {});

      function openSearch() {
        modal?.classList.remove('hidden');
        input?.focus();
      }
      function closeSearch() {
        modal?.classList.add('hidden');
      }

      trigger?.addEventListener('click', openSearch);
      closeBtn?.addEventListener('click', closeSearch);

      window.addEventListener('keydown', (e) => {
        if ((e.metaKey || e.ctrlKey) && e.key === 'k') {
          e.preventDefault();
          openSearch();
        }
        if (e.key === 'Escape' && !modal?.classList.contains('hidden')) {
          closeSearch();
        }
      });

      modal?.addEventListener('click', (e) => {
        if (e.target === modal) closeSearch();
      });

      input?.addEventListener('input', (e) => {
        const q = (e.target as HTMLInputElement).value.toLowerCase().trim();
        if (!q || q.length < 2) {
          if (results) results.innerHTML = '<div class="text-center py-8 text-slate-400">Aramak istediğiniz konuyu yazın...</div>';
          return;
        }

        const filtered = allPosts.filter((p: any) => 
          p.title.toLowerCase().includes(q) || 
          (p.excerpt && p.excerpt.toLowerCase().includes(q)) ||
          (p.categories && p.categories.some((c: any) => c.name.toLowerCase().includes(q)))
        ).slice(0, 8);

        if (filtered.length === 0) {
          if (results) results.innerHTML = `<div class="text-center py-8 text-slate-400">"${q}" ile eşleşen sınav notu bulunamadı.</div>`;
          return;
        }

        if (results) {
          results.innerHTML = filtered.map((p: any) => `
            <a href="${p.url}" class="block p-3 rounded-xl hover:bg-slate-100 dark:hover:bg-slate-800 transition-colors border border-transparent hover:border-slate-200 dark:hover:border-slate-700">
              <div class="font-semibold text-slate-900 dark:text-white text-base">${p.title}</div>
              <p class="text-xs text-slate-500 dark:text-slate-400 mt-1 line-clamp-1">${p.excerpt || ''}</p>
            </a>
          `).join('');
        }
      });
    </script>
  </body>
</html>
