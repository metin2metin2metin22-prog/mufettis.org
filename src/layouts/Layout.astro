                    </div>
                    <div>
                      <h4 class="font-bold text-xs text-slate-900 dark:text-white group-hover/item:text-amber-600 dark:group-hover/item:text-amber-400 transition-colors">Banka Denetimi & BDDK</h4>
                      <p class="text-[11px] text-slate-500 dark:text-slate-400">Teftiş Kurulu Mevzuatı & Risk Yönetimi</p>
                    </div>
                  </a>

                  <div class="pt-2 border-t border-slate-100 dark:border-slate-800">
                    <a href="/deneme-sinavlari/" class="flex items-center justify-center gap-1.5 py-2 rounded-xl bg-amber-500 hover:bg-amber-400 text-slate-950 font-black text-xs transition-colors shadow-xs">
                      <svg class="w-3.5 h-3.5 text-slate-950 fill-current" viewBox="0 0 24 24"><path d="M13 10V3L4 14h7v7l9-11h-7z"/></svg>
                      <span>12+ Çözümlü Deneme Sınavını Gör →</span>
                    </a>
                  </div>

                </div>
              </div>
            </div>

            <!-- 2. Denetim & Kariyer Dropdown -->
            <div class="relative group">
              <button type="button" class="flex items-center gap-1 px-3.5 py-2 rounded-xl hover:text-brand-600 dark:hover:text-sky-400 hover:bg-slate-100 dark:hover:bg-slate-800/80 transition-colors cursor-pointer">
                <span>Denetim & Finans</span>
                <svg class="w-3.5 h-3.5 text-slate-400 group-hover:rotate-180 transition-transform duration-200" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path></svg>
              </button>
              
              <!-- Dropdown Card -->
              <div class="absolute left-0 top-full pt-2 w-72 opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-200 pointer-events-none group-hover:pointer-events-auto z-50">
                <div class="p-3 bg-white dark:bg-[#0c1827] rounded-3xl shadow-2xl border-2 border-slate-200 dark:border-slate-800 space-y-1 backdrop-blur-xl">
                  
