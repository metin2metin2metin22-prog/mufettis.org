          <!-- Column 3: Exams -->
          <div>
            <h4 class="text-xs font-bold text-white uppercase tracking-wider mb-4 border-l-2 border-amber-500 pl-2">Çözümlü Denemeler</h4>
            <ul class="space-y-2.5 text-xs font-medium">
