---
import '../styles/components.css';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  canonical?: string;
  type?: 'website' | 'article';
  publishDate?: string;
}

const {
  title = "Müfettiş | Sınav Hazırlık Notları, Makaleler ve Çözümlü Deneme Sınavları",
  description = "Banka Müfettişliği, SPL Lisanslama, MASAK Uyum Görevlisi ve CIA sınavlarına hazırlık için kapsamlı ders notları, mevzuat özetleri ve çözümlü testler.",
  image = "/wp-content/uploads/2026/04/mufettis.org_-scaled.png",
  canonical = Astro.url.href,
  type = "website",
  publishDate
} = Astro.props;

const siteName = "mufettis.org";
const fullTitle = title.includes("Müfettiş") || title.includes("mufettis") ? title : `${title} | Müfettiş.org`;
const ogImage = image ? (image.startsWith('http') ? image : `https://mufettis.org${image}`) : 'https://mufettis.org/wp-content/uploads/2026/04/mufettis.org_-scaled.png';
---

<!doctype html>
<html lang="tr" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/png" sizes="32x32" href="/brand/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/brand/favicon-16x16.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/brand/apple-touch-icon.png" />
    <link rel="canonical" href={canonical} />

    <!-- Primary Meta Tags -->
    <title>{fullTitle}</title>
    <meta name="title" content={fullTitle} />
    <meta name="description" content={description} />
    <meta name="author" content="mufettis.org" />
    <meta name="robots" content="index, follow" />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:site_name" content={siteName} />
    {publishDate && <meta property="article:published_time" content={publishDate} />}

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={canonical} />
    <meta property="twitter:title" content={fullTitle} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={ogImage} />

    <!-- Google Structured Data (Schema.org JSON-LD) -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@graph": [
        {
          "@type": "WebSite",
          "@id": "https://mufettis.org/#website",
          "url": "https://mufettis.org/",
          "name": "Müfettiş.org",
          "description": "Banka Müfettişliği, SPL, MASAK ve CIA Sınav Hazırlık Portalı",
          "publisher": {
            "@type": "EducationalOrganization",
            "name": "mufettis.org",
            "url": "https://mufettis.org/",
            "logo": {
              "@type": "ImageObject",
              "url": "https://mufettis.org/wp-content/uploads/2026/04/cropped-mufettis.org-favicon-1-180x180.png"
            }
          },
          "potentialAction": {
            "@type": "SearchAction",
            "target": "https://mufettis.org/?s={search_term_string}",
            "query-input": "required name=search_term_string"
          }
        },
        ...(type === 'article' ? [{
          "@type": "Article",
          "@id": `${canonical}#article`,
          "isPartOf": { "@id": "https://mufettis.org/#website" },
          "headline": fullTitle,
          "description": description,
          "image": ogImage,
          "datePublished": publishDate || "2026-04-01T00:00:00Z",
          "author": {
            "@type": "Organization",
            "name": "mufettis.org Denetim ve Mevzuat Kurulu",
            "url": "https://mufettis.org/"
          },
          "publisher": {
            "@type": "EducationalOrganization",
            "name": "mufettis.org",
            "url": "https://mufettis.org/"
          }
        }] : [])
      ]
    })} />

    <!-- Fonts: Plus Jakarta Sans for UI + Lora for Editorial -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800;900&family=Lora:ital,wght@0,400;0,500;0,600;1,400&family=JetBrains+Mono:wght@400;600&display=swap" rel="stylesheet">

    <!-- Theme Initialization Script -->
    <script is:inline>
      const theme = (() => {
        if (typeof localStorage !== 'undefined' && localStorage.getItem('theme')) {
          return localStorage.getItem('theme');
        }
        if (window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches) {
          return 'dark';
        }
        return 'light';
      })();
      if (theme === 'dark') {
        document.documentElement.classList.add('dark');
      } else {
        document.documentElement.classList.remove('dark');
      }
    </script>
  </head>
  <body class="bg-[#f8fafc] text-slate-800 dark:bg-[#060d16] dark:text-slate-100 font-sans antialiased min-h-screen flex flex-col selection:bg-brand-600 selection:text-white transition-colors duration-200">
    
    <!-- Top Financial / Announcement Bar -->
    <div class="bg-[#050f1a] text-slate-300 text-[11px] border-b border-brand-900/60 py-2 px-4 select-none">
      <div class="max-w-7xl mx-auto flex flex-wrap items-center justify-between gap-3">
        
        <!-- Live Financial Ticker & Announcements -->
        <div class="flex items-center gap-4 overflow-x-auto whitespace-nowrap scrollbar-none py-0.5">
          <span class="inline-flex items-center gap-1.5 font-black text-emerald-400 bg-emerald-950/70 border border-emerald-800/50 px-2.5 py-0.5 rounded-full text-[10px] uppercase tracking-wider shadow-xs">
            <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-ping"></span>
            Canlı Piyasa
          </span>
          <span class="text-slate-300"><strong>BIST 100:</strong> <span class="text-emerald-400 font-semibold inline-flex items-center gap-1">9.145,20 <svg class="w-3 h-3 text-emerald-400 inline" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 15l7-7 7 7"/></svg> (+%1.2)</span></span>
          <span class="text-slate-600">•</span>
          <span class="text-slate-300"><strong>USD/TRY:</strong> 34,28</span>
          <span class="text-slate-600">•</span>
          <span class="text-slate-300"><strong>EUR/TRY:</strong> 37,22</span>
          <span class="text-slate-600">•</span>
          <span class="text-slate-300"><strong>Gram Altın:</strong> <span class="text-emerald-400 font-semibold inline-flex items-center gap-1">3.035 TL <svg class="w-3 h-3 text-emerald-400 inline" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 15l7-7 7 7"/></svg></span></span>
          <span class="text-slate-600">•</span>
          <span class="text-amber-300 font-semibold flex items-center gap-1.5">
            <svg class="w-3.5 h-3.5 text-amber-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/></svg> 2026 SPL, MASAK & CIA Güncel Soru Setleri
          </span>
        </div>

        <!-- Controls -->
        <div class="flex items-center gap-3 text-[11px] ml-auto shrink-0">
          <a href="/maas-hesaplayici/" class="text-emerald-400 hover:text-emerald-300 font-bold hidden lg:flex items-center gap-1 transition-colors">
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 7h6m0 10v-3m-3 3h.01M9 17h.01M9 14h.01M12 14h.01M15 11h.01M12 11h.01M9 11h.01M7 21h10a2 2 0 002-2V5a2 2 0 00-2-2H7a2 2 0 00-2 2v14a2 2 0 002 2z"></path></svg>
            <span>Maaş Hesapla</span>
          </a>
          <span class="text-slate-700 hidden lg:inline">|</span>
          <a href="/bilgi-kartlari/" class="text-sky-400 hover:text-sky-300 font-bold hidden lg:flex items-center gap-1 transition-colors">
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"></path></svg>
            <span>Akıl Kartları</span>
          </a>
          <span class="text-slate-700 hidden lg:inline">|</span>
          <button id="saved-questions-trigger" type="button" class="text-amber-400 hover:text-amber-300 font-bold flex items-center gap-1.5 cursor-pointer bg-amber-500/10 hover:bg-amber-500/20 px-2.5 py-0.5 rounded-full border border-amber-500/30 transition-all">
            <svg class="w-3.5 h-3.5 fill-current" viewBox="0 0 24 24"><path d="M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z"/></svg>
            <span>Hata Defterim</span>
            <span id="saved-count-badge" class="px-1.5 py-0.2 rounded-full bg-amber-500 text-slate-950 font-black text-[9.5px]">0</span>
          </button>
          <span class="text-slate-700">|</span>
          <button id="theme-toggle" type="button" aria-label="Karanlık Mod Geçişi" class="p-1 rounded-md hover:bg-slate-800 text-slate-300 hover:text-white transition-colors flex items-center gap-1.5 cursor-pointer font-medium">
            <span class="dark:hidden flex items-center gap-1">
              <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z"></path></svg>
              <span>Koyu</span>
            </span>
            <span class="hidden dark:flex items-center gap-1 text-amber-300">
              <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z"></path></svg>
              <span>Aydınlık</span>
            </span>
          </button>
        </div>

      </div>
    </div>

    <!-- Main Portal Header -->
    <header class="sticky top-0 z-40 bg-white/95 dark:bg-[#071322]/95 backdrop-blur-xl border-b border-slate-200/90 dark:border-slate-800/90 shadow-sm transition-colors">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex items-center justify-between h-20">
          
          <!-- Dual-Mode Authentic Site Emblem & Brand Identity -->
          <a href="/" class="flex items-center gap-3.5 group shrink-0" title="mufettis.org Akademi Anasayfa">
            <div class="relative flex items-center justify-center shrink-0">
              <img 
                src="/brand/mufettis-emblem-light.png" 
                alt="Müfettiş.org Amblemi" 
                class="h-11 sm:h-12 w-auto object-contain dark:hidden group-hover:scale-105 transition-transform drop-shadow-sm" 
                width="44" 
                height="50"
                loading="eager"
              />
              <img 
                src="/brand/mufettis-emblem-dark.png" 
                alt="Müfettiş.org Amblemi" 
                class="h-11 sm:h-12 w-auto object-contain hidden dark:block group-hover:scale-105 transition-transform drop-shadow-md" 
                width="44" 
                height="50"
