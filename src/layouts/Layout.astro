    <!-- CLIENT SCRIPTS -->
    <script>
      // 1. Theme toggle
      const toggle = document.getElementById('theme-toggle');
      if (toggle) {
        toggle.addEventListener('click', () => {
          const isDark = document.documentElement.classList.toggle('dark');
          localStorage.setItem('theme', isDark ? 'dark' : 'light');
        });
      }

      // 2. Mobile Menu Drawer
      const mobileBtn = document.getElementById('mobile-menu-btn');
      const mobileDrawer = document.getElementById('mobile-menu-drawer');
      const mobileClose = document.getElementById('mobile-menu-close');

      mobileBtn?.addEventListener('click', () => mobileDrawer?.classList.remove('hidden'));
      mobileClose?.addEventListener('click', () => mobileDrawer?.classList.add('hidden'));
      mobileDrawer?.addEventListener('click', (e) => {
        if (e.target === mobileDrawer) mobileDrawer.classList.add('hidden');
      });

      // 3. Instant Search Engine
      const modal = document.getElementById('search-modal');
      const trigger = document.getElementById('search-trigger');
      const closeBtn = document.getElementById('search-close');
      const input = document.getElementById('search-input') as HTMLInputElement;
      const results = document.getElementById('search-results');
      const filterChips = document.querySelectorAll('.search-filter-chip');

      let allPosts: any[] = [];
      let activeFilter = 'all';

      fetch('/api/search.json')
        .then(res => res.json())
        .then(data => { allPosts = data; renderInitialSuggestions(); })
        .catch(() => {});

      function openSearch() {
        modal?.classList.remove('hidden');
        input?.focus();
        if (!input.value.trim()) renderInitialSuggestions();
      }

      function closeSearch() {
        modal?.classList.add('hidden');
      }

      trigger?.addEventListener('click', openSearch);
      closeBtn?.addEventListener('click', closeSearch);

      window.addEventListener('keydown', (e) => {
        if ((e.metaKey || e.ctrlKey) && e.key === 'k') {
          e.preventDefault();
          openSearch();
        }
        if (e.key === 'Escape' && !modal?.classList.contains('hidden')) {
          closeSearch();
        }
      });

      modal?.addEventListener('click', (e) => {
        if (e.target === modal) closeSearch();
      });

      // Filter chips handling
      filterChips.forEach(chip => {
        chip.addEventListener('click', () => {
          filterChips.forEach(c => {
            c.classList.remove('bg-brand-600', 'text-white', 'font-bold');
            c.classList.add('bg-slate-100', 'dark:bg-slate-800', 'text-slate-700', 'dark:text-slate-300', 'font-semibold');
          });
          chip.classList.remove('bg-slate-100', 'dark:bg-slate-800', 'text-slate-700', 'dark:text-slate-300');
          chip.classList.add('bg-brand-600', 'text-white', 'font-bold');
          activeFilter = chip.getAttribute('data-filter') || 'all';
          performSearch();
        });
      });

      function renderInitialSuggestions() {
        if (!results) return;
        const featured = allPosts.slice(0, 6);
        results.innerHTML = `
          <div class="px-2 pt-1 pb-2 text-[11px] font-bold uppercase tracking-wider text-slate-400">Öne Çıkan Rehberler ve Çözümlü Denemeler:</div>
          <div class="space-y-2">
            ${featured.map(renderPostCard).join('')}
          </div>
        `;
      }

      function renderPostCard(p: any) {
        const catName = p.categories && p.categories[0] ? p.categories[0].name : 'Sınav Notu';
        const isQuizBadge = p.is_quiz 
          ? '<span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-md bg-amber-500 text-slate-950 font-black text-[10px] uppercase"><svg class="w-2.5 h-2.5 fill-current" viewBox="0 0 24 24"><path d="M13 10V3L4 14h7v7l9-11h-7z"/></svg> Deneme</span>'
          : '<span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-md bg-sky-100 dark:bg-sky-950 text-sky-700 dark:text-sky-300 font-bold text-[10px] uppercase"><svg class="w-2.5 h-2.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"/></svg> Ders Notu</span>';

        return `
          <a href="${p.url}" class="search-result-item flex items-center gap-3.5 p-3 rounded-2xl bg-white dark:bg-slate-900 hover:bg-slate-100 dark:hover:bg-slate-800/80 transition-all border border-slate-200/80 dark:border-slate-800 group shadow-xs">
            ${p.featured_image ? `
              <div class="w-16 h-12 rounded-xl overflow-hidden bg-slate-950 shrink-0 border border-slate-200 dark:border-slate-800">
                <img src="${p.featured_image}" alt="${p.title}" class="w-full h-full object-cover group-hover:scale-105 transition-transform" />
              </div>
            ` : ''}
            <div class="flex-grow min-w-0">
              <div class="flex items-center gap-2 mb-1">
                ${isQuizBadge}
                <span class="text-[10.5px] font-bold text-slate-400 truncate">${catName}</span>
                <span class="text-[10.5px] text-slate-400 ml-auto shrink-0 inline-flex items-center gap-1">
                  <svg class="w-3 h-3 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                  ${p.reading_time || 5} dk
                </span>
              </div>
              <h4 class="font-bold text-slate-900 dark:text-white text-xs sm:text-sm group-hover:text-brand-600 dark:group-hover:text-sky-400 transition-colors truncate">
                ${p.title}
              </h4>
            </div>
          </a>
        `;
      }

      function performSearch() {
        const q = input?.value.toLowerCase().trim() || '';
        if (!results) return;

        let filtered = allPosts;

        // Apply category filter
        if (activeFilter === 'spl') {
          filtered = filtered.filter(p => p.categories && p.categories.some((c: any) => c.slug.includes('spl')));
        } else if (activeFilter === 'masak') {
          filtered = filtered.filter(p => p.categories && p.categories.some((c: any) => c.slug.includes('masak')));
        } else if (activeFilter === 'cia') {
          filtered = filtered.filter(p => p.categories && p.categories.some((c: any) => c.slug.includes('cia')));
        } else if (activeFilter === 'banka') {
          filtered = filtered.filter(p => p.categories && p.categories.some((c: any) => c.slug.includes('banka') || c.slug.includes('kariyer')));
        } else if (activeFilter === 'quiz') {
          filtered = filtered.filter(p => p.is_quiz);
        }

        // Apply text query
        if (q.length > 0) {
          filtered = filtered.filter(p => 
            p.title.toLowerCase().includes(q) || 
            (p.excerpt && p.excerpt.toLowerCase().includes(q))
          );
        }

        const topMatches = filtered.slice(0, 10);

        if (topMatches.length === 0) {
          results.innerHTML = `
            <div class="text-center py-12 text-slate-400">
              <svg class="w-10 h-10 mx-auto mb-3 text-slate-400 opacity-60" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/></svg>
              <p class="font-bold text-slate-700 dark:text-slate-300">"${q}" ile eşleşen sınav notu veya soru bulunamadı.</p>
              <p class="text-xs text-slate-500 mt-1">Farklı bir kelimeyle aramayı deneyebilir veya üstteki kategori filtrelerini kullanabilirsiniz.</p>
            </div>
          `;
          return;
        }

        results.innerHTML = `
          <div class="px-2 pt-1 pb-2 text-[11px] font-bold uppercase tracking-wider text-slate-400">${topMatches.length} İçerik Bulundu:</div>
          <div class="space-y-2">
            ${topMatches.map(renderPostCard).join('')}
          </div>
        `;
      }

      input?.addEventListener('input', performSearch);

      // 4. Hata Defterim Drawer Logic
      const savedDrawer = document.getElementById('saved-questions-drawer');
      const savedTrigger = document.getElementById('saved-questions-trigger');
      const savedClose = document.getElementById('saved-drawer-close');
      const savedList = document.getElementById('saved-questions-list');
      const savedBadge = document.getElementById('saved-count-badge');
      const clearSavedBtn = document.getElementById('clear-saved-btn');

      function updateSavedBadge() {
        try {
          const saved = JSON.parse(localStorage.getItem('mufettis_saved_questions') || '[]');
          if (savedBadge) savedBadge.textContent = saved.length.toString();
        } catch (e) {}
      }

      function renderSavedQuestions() {
        if (!savedList) return;
        try {
          const saved = JSON.parse(localStorage.getItem('mufettis_saved_questions') || '[]');
          if (saved.length === 0) {
            savedList.innerHTML = `
              <div class="text-center py-12 text-slate-400">
                <svg class="w-10 h-10 mx-auto mb-3 text-amber-500/50" fill="currentColor" viewBox="0 0 24 24"><path d="M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z"/></svg>
                <p class="font-bold text-slate-700 dark:text-slate-300">Henüz kayıtlı soru yok.</p>
                <p class="text-xs text-slate-500 mt-1">Sınav çözerken zorlandığınız soruların üstündeki "Kaydet" butonuna basarak buraya ekleyebilirsiniz.</p>
              </div>
            `;
            return;
          }

          savedList.innerHTML = saved.map((item: any, idx: number) => `
            <div class="p-3.5 rounded-2xl bg-slate-50 dark:bg-slate-900 border border-slate-200 dark:border-slate-800 flex items-start justify-between gap-3 group">
              <a href="${item.url}" class="flex-grow min-w-0">
                <span class="text-[10px] font-bold text-amber-500 block mb-0.5">Soru Kaydı #${idx + 1}</span>
                <h4 class="font-bold text-xs text-slate-800 dark:text-slate-200 group-hover:text-amber-500 line-clamp-2 transition-colors">
                  ${item.title}
                </h4>
              </a>
              <button type="button" class="delete-saved-item text-slate-400 hover:text-rose-500 p-1" data-idx="${idx}" title="Sil">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
              </button>
            </div>
          `).join('');

          savedList.querySelectorAll('.delete-saved-item').forEach(b => {
            b.addEventListener('click', (e) => {
              const idx = parseInt((e.currentTarget as HTMLElement).getAttribute('data-idx') || '0', 10);
              const saved = JSON.parse(localStorage.getItem('mufettis_saved_questions') || '[]');
              saved.splice(idx, 1);
              localStorage.setItem('mufettis_saved_questions', JSON.stringify(saved));
              updateSavedBadge();
              renderSavedQuestions();
            });
          });
        } catch (e) {}
      }

      savedTrigger?.addEventListener('click', () => {
        updateSavedBadge();
        renderSavedQuestions();
        savedDrawer?.classList.remove('hidden');
      });

      savedClose?.addEventListener('click', () => savedDrawer?.classList.add('hidden'));
      savedDrawer?.addEventListener('click', (e) => {
        if (e.target === savedDrawer) savedDrawer.classList.add('hidden');
      });

      clearSavedBtn?.addEventListener('click', () => {
        if (confirm('Tüm kayıtlı soruları temizlemek istediğinize emin misiniz?')) {
          localStorage.removeItem('mufettis_saved_questions');
          updateSavedBadge();
          renderSavedQuestions();
        }
      });

      updateSavedBadge();

      // 5. Back to Top Button Logic
      const backToTopBtn = document.getElementById('back-to-top-btn');
      window.addEventListener('scroll', () => {
        if (window.scrollY > 350) {
          backToTopBtn?.classList.remove('hidden');
        } else {
          backToTopBtn?.classList.add('hidden');
        }
      });
      backToTopBtn?.addEventListener('click', () => {
        window.scrollTo({ top: 0, behavior: 'smooth' });
      });

      // 6. Mobile Drawer Link Closure
      const drawerLinks = mobileDrawer?.querySelectorAll('a');
      drawerLinks?.forEach(link => {
        link.addEventListener('click', () => mobileDrawer?.classList.add('hidden'));
      });
    </script>
    
    <!-- Floating Back to Top Button -->
    <button 
      id="back-to-top-btn" 
      type="button" 
      aria-label="Yukarı Çık" 
      class="fixed bottom-6 right-6 z-40 hidden p-3 rounded-2xl bg-brand-600 hover:bg-brand-500 text-white shadow-2xl transition-all duration-300 hover:scale-110 border-2 border-white/20 cursor-pointer"
    >
      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 10l7-7m0 0l7 7m-7-7v18"></path></svg>
    </button>
  </body>
</html>
