              <!-- Dropdown Card -->
              <div class="absolute left-0 top-full pt-2 w-72 opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-200 pointer-events-none group-hover:pointer-events-auto z-50">
                <div class="p-3 bg-white dark:bg-[#0c1827] rounded-3xl shadow-2xl border-2 border-slate-200 dark:border-slate-800 space-y-1 backdrop-blur-xl">
                  
                  <a href="/category/mali-analiz-kutuphanesi/" class="flex items-start gap-3 p-2.5 rounded-2xl hover:bg-teal-50 dark:hover:bg-teal-950/40 transition-colors group/item">
                    <div class="w-8 h-8 rounded-xl bg-teal-500/10 text-teal-600 dark:text-teal-400 flex items-center justify-center shrink-0 border border-teal-500/20 group-hover/item:scale-110 transition-transform">
                      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"></path></svg>
                    </div>
                    <div>
                      <h4 class="font-bold text-xs text-slate-900 dark:text-white group-hover/item:text-teal-600 dark:group-hover/item:text-teal-400 transition-colors">Mali Analiz & Bilanço</h4>
                      <p class="text-[11px] text-slate-500 dark:text-slate-400">Rasyolar & Çek Riski Analizi</p>
                    </div>
                  </a>

                  <a href="/category/kariyer-meslek-rehberi/" class="flex items-start gap-3 p-2.5 rounded-2xl hover:bg-rose-50 dark:hover:bg-rose-950/40 transition-colors group/item">
                    <div class="w-8 h-8 rounded-xl bg-rose-500/10 text-rose-600 dark:text-rose-400 flex items-center justify-center shrink-0 border border-rose-500/20 group-hover/item:scale-110 transition-transform">
                      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 13.255A23.931 23.931 0 0112 15c-3.183 0-6.22-.62-9-1.745M16 6V4a2 2 0 00-2-2h-4a2 2 0 00-2 2v2m4 6h.01M5 20h14a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path></svg>
                    </div>
