---
import '../styles/components.css';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  canonical?: string;
  type?: 'website' | 'article';
  publishDate?: string;
  preloadImage?: string;
}

const {
  title = "Müfettiş | Sınav Hazırlık Notları, Makaleler ve Çözümlü Deneme Sınavları",
  description = "Banka Müfettişliği, SPL Lisanslama, MASAK Uyum Görevlisi ve CIA sınavlarına hazırlık için kapsamlı ders notları, mevzuat özetleri ve çözümlü testler.",
  image = "/wp-content/uploads/2026/04/mufettis.org_-scaled.png",
  canonical = Astro.url.href,
  type = "website",
  publishDate,
  preloadImage
} = Astro.props;

const siteName = "mufettis.org";
const fullTitle = title.includes("Müfettiş") || title.includes("mufettis") ? title : `${title} | Müfettiş.org`;
const ogImage = image ? (image.startsWith('http') ? image : `https://mufettis.org${image}`) : 'https://mufettis.org/wp-content/uploads/2026/04/mufettis.org_-scaled.png';
const currentPath = Astro.url.pathname;
const isHome = currentPath === '/';
const isModules = currentPath.startsWith('/category/');
const isExams = currentPath.startsWith('/deneme-sinavlari/');
const isSalary = currentPath.startsWith('/maas-hesaplayici/');
const isFlashcards = currentPath.startsWith('/bilgi-kartlari/');
---

<!doctype html>
<html lang="tr" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#060d16" media="(prefers-color-scheme: dark)" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="format-detection" content="telephone=no" />
    <link rel="icon" type="image/png" sizes="32x32" href="/brand/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/brand/favicon-16x16.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/brand/apple-touch-icon.png" />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" type="application/rss+xml" title="Müfettiş.org Mevzuat Akışı" href="/rss.xml" />

    <!-- Primary Meta Tags -->
    <title>{fullTitle}</title>
    <meta name="title" content={fullTitle} />
    <meta name="description" content={description} />
    <meta name="author" content="mufettis.org" />
    <meta name="robots" content="index, follow" />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:site_name" content={siteName} />
    {publishDate && <meta property="article:published_time" content={publishDate} />}

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={canonical} />
    <meta property="twitter:title" content={fullTitle} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={ogImage} />

    <!-- Google Structured Data (Schema.org JSON-LD) -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@graph": [
        {
          "@type": "WebSite",
          "@id": "https://mufettis.org/#website",
          "url": "https://mufettis.org/",
          "name": "Müfettiş.org",
          "description": "Banka Müfettişliği, SPL, MASAK ve CIA Sınav Hazırlık Portalı",
          "publisher": {
            "@type": "EducationalOrganization",
            "name": "mufettis.org",
            "url": "https://mufettis.org/",
            "logo": {
              "@type": "ImageObject",
              "url": "https://mufettis.org/wp-content/uploads/2026/04/cropped-mufettis.org-favicon-1-180x180.png"
            }
          },
          "potentialAction": {
            "@type": "SearchAction",
            "target": "https://mufettis.org/?s={search_term_string}",
            "query-input": "required name=search_term_string"
          }
        },
        ...(type === 'article' ? [{
          "@type": "Article",
          "@id": `${canonical}#article`,
          "isPartOf": { "@id": "https://mufettis.org/#website" },
          "headline": fullTitle,
          "description": description,
          "image": ogImage,
          "datePublished": publishDate || "2026-04-01T00:00:00Z",
          "author": {
            "@type": "Organization",
            "name": "mufettis.org Denetim ve Mevzuat Kurulu",
            "url": "https://mufettis.org/"
          },
          "publisher": {
            "@type": "EducationalOrganization",
            "name": "mufettis.org",
            "url": "https://mufettis.org/"
          }
        }] : [])
      ]
    })} />

    <!-- LCP Image Preload for Instant Render -->
    {preloadImage && (
      <link rel="preload" as="image" href={preloadImage} fetchpriority="high" type="image/webp" />
    )}

    <!-- Fonts: Preconnect & High-Performance Non-blocking Fonts (No Render Blocking) -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;600;700;800&family=Lora:wght@400;600&display=swap" media="print" onload="this.media='all'">
    <noscript>
      <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;600;700;800&family=Lora:wght@400;600&display=swap">
    </noscript>

    <!-- Theme Initialization Script -->
    <script is:inline>
      const theme = (() => {
        if (typeof localStorage !== 'undefined' && localStorage.getItem('theme')) {
          return localStorage.getItem('theme');
        }
        if (window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches) {
          return 'dark';
        }
        return 'light';
      })();
      if (theme === 'dark') {
        document.documentElement.classList.add('dark');
      } else {
        document.documentElement.classList.remove('dark');
      }
    </script>
  </head>
  <body class="bg-[#f8fafc] text-slate-800 dark:bg-[#060d16] dark:text-slate-100 font-sans antialiased min-h-screen flex flex-col selection:bg-brand-600 selection:text-white transition-colors duration-200">
    
    <!-- Top Financial / Announcement Bar -->
    <div class="bg-[#050f1a] text-slate-300 text-[11px] border-b border-brand-900/60 py-1.5 sm:py-2 px-3 sm:px-4 select-none">
      <div class="max-w-7xl mx-auto flex items-center justify-between gap-2 sm:gap-3 overflow-hidden">
        
        <!-- Live Financial Ticker & Announcements -->
        <div class="flex items-center gap-3 sm:gap-4 overflow-x-auto whitespace-nowrap scrollbar-none no-scrollbar py-0.5 flex-grow min-w-0">
          <span class="inline-flex items-center gap-1.5 font-black text-emerald-400 bg-emerald-950/70 border border-emerald-800/50 px-2 sm:px-2.5 py-0.5 rounded-full text-[9.5px] sm:text-[10px] uppercase tracking-wider shadow-xs shrink-0">
            <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-ping"></span>
            Canlı Piyasa
          </span>
          <span class="text-slate-300 shrink-0"><strong>BIST:</strong> <span class="text-emerald-400 font-semibold inline-flex items-center gap-0.5">9.145 <svg class="w-2.5 h-2.5 text-emerald-400 inline" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 15l7-7 7 7"/></svg></span></span>
          <span class="text-slate-600 shrink-0">•</span>
          <span class="text-slate-300 shrink-0"><strong>USD:</strong> 34,28</span>
          <span class="text-slate-600 shrink-0">•</span>
          <span class="text-slate-300 shrink-0"><strong>EUR:</strong> 37,22</span>
          <span class="text-slate-600 shrink-0">•</span>
          <span class="text-slate-300 shrink-0"><strong>Gram:</strong> <span class="text-emerald-400 font-semibold inline-flex items-center gap-0.5">3.035 TL <svg class="w-2.5 h-2.5 text-emerald-400 inline" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 15l7-7 7 7"/></svg></span></span>
          <span class="text-slate-600 shrink-0">•</span>
          <span class="text-amber-300 font-semibold flex items-center gap-1.5 shrink-0">
            <svg class="w-3.5 h-3.5 text-amber-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/></svg> 2026 SPL, MASAK & CIA Güncel Setleri
          </span>
        </div>

        <!-- Controls -->
        <div class="flex items-center gap-2 sm:gap-3 text-[11px] ml-auto shrink-0">
          <a href="/maas-hesaplayici/" class="text-emerald-400 hover:text-emerald-300 font-bold hidden lg:flex items-center gap-1 transition-colors">
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 7h6m0 10v-3m-3 3h.01M9 17h.01M9 14h.01M12 14h.01M15 11h.01M12 11h.01M9 11h.01M7 21h10a2 2 0 002-2V5a2 2 0 00-2-2H7a2 2 0 00-2 2v14a2 2 0 002 2z"></path></svg>
            <span>Maaş Hesapla</span>
          </a>
          <span class="text-slate-700 hidden lg:inline">|</span>
          <a href="/bilgi-kartlari/" class="text-sky-400 hover:text-sky-300 font-bold hidden lg:flex items-center gap-1 transition-colors">
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"></path></svg>
            <span>Bilgi Kartları</span>
          </a>
          <span class="text-slate-700 hidden lg:inline">|</span>
          <button id="saved-questions-trigger" type="button" aria-label="Hata Defterim" class="text-amber-400 hover:text-amber-300 font-bold flex items-center gap-1 sm:gap-1.5 cursor-pointer bg-amber-500/10 hover:bg-amber-500/20 px-2 sm:px-2.5 py-0.5 rounded-full border border-amber-500/30 transition-all active:scale-95">
            <svg class="w-3.5 h-3.5 fill-current" viewBox="0 0 24 24"><path d="M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z"/></svg>
            <span class="hidden xs:inline">Defterim</span>
            <span id="saved-count-badge" class="px-1.5 py-0.2 rounded-full bg-amber-500 text-slate-950 font-black text-[9.5px]">0</span>
          </button>
          <span class="text-slate-700">|</span>
          <button id="theme-toggle" type="button" aria-label="Karanlık Mod Geçişi" class="p-1 rounded-md hover:bg-slate-800 text-slate-300 hover:text-white transition-colors flex items-center gap-1 sm:gap-1.5 cursor-pointer font-medium active:scale-95">
            <span class="dark:hidden flex items-center gap-1">
              <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z"></path></svg>
              <span class="hidden sm:inline">Koyu</span>
            </span>
            <span class="hidden dark:flex items-center gap-1 text-amber-300">
              <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z"></path></svg>
              <span class="hidden sm:inline">Aydınlık</span>
            </span>
          </button>
        </div>

      </div>
    </div>

    <!-- Main Portal Header -->
    <header class="sticky top-0 z-40 bg-white/95 dark:bg-[#071322]/95 backdrop-blur-xl border-b border-slate-200/90 dark:border-slate-800/90 shadow-sm transition-colors">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex items-center justify-between h-16 sm:h-20">
          
          <!-- Dual-Mode Authentic Site Emblem & Brand Identity -->
          <a href="/" class="flex items-center gap-2.5 sm:gap-3.5 group shrink-0" title="mufettis.org Akademi Anasayfa">
            <div class="relative flex items-center justify-center shrink-0">
              <img 
                src="/brand/mufettis-emblem-light.webp" 
                alt="Müfettiş.org Amblemi" 
                class="h-9 sm:h-11 xl:h-12 w-auto object-contain dark:hidden group-hover:scale-105 transition-transform drop-shadow-sm" 
                width="44" 
                height="50"
                loading="eager"
                decoding="async"
              />
              <img 
                src="/brand/mufettis-emblem-dark.webp" 
                alt="Müfettiş.org Amblemi" 
                class="h-9 sm:h-11 xl:h-12 w-auto object-contain hidden dark:block group-hover:scale-105 transition-transform drop-shadow-md" 
                width="44" 
                height="50"
                loading="eager"
                decoding="async"
              />
            </div>
            <div class="flex flex-col">
              <div class="flex items-center gap-1.5 sm:gap-2">
                <span class="text-lg sm:text-2xl font-black tracking-tight text-slate-900 dark:text-white leading-none">
                  mufettis<span class="text-brand-600 dark:text-sky-400 font-extrabold">.org</span>
                </span>
                <span class="px-1.5 sm:px-2 py-0.5 rounded-full text-[8.5px] sm:text-[9px] font-black uppercase tracking-wider bg-sky-500/10 text-sky-700 dark:text-sky-300 border border-sky-500/30">
                  Akademi
                </span>
              </div>
              <span class="text-[9.5px] sm:text-[10px] font-bold tracking-wider text-slate-400 dark:text-slate-400 uppercase mt-0.5 hidden xs:block">
                Denetim, Sınav & Mevzuat Portalı
              </span>
            </div>
          </a>

          <!-- Master Navigation Menu -->
          <nav class="hidden xl:flex items-center gap-1 text-[13px] font-bold text-slate-700 dark:text-slate-200">
            
            <a href="/" class="px-3.5 py-2 rounded-xl hover:text-brand-600 dark:hover:text-sky-400 hover:bg-slate-100 dark:hover:bg-slate-800/80 transition-colors">
              Anasayfa
            </a>

            <!-- 1. Sınav Kütüphanesi Mega-Dropdown -->
            <div class="relative group">
              <button type="button" class="flex items-center gap-1 px-3.5 py-2 rounded-xl hover:text-brand-600 dark:hover:text-sky-400 hover:bg-slate-100 dark:hover:bg-slate-800/80 transition-colors cursor-pointer">
                <span>Sınav Kütüphanesi</span>
                <svg class="w-3.5 h-3.5 text-slate-400 group-hover:rotate-180 transition-transform duration-200" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path></svg>
              </button>
              
              <!-- Dropdown Card -->
              <div class="absolute left-0 top-full pt-2 w-[340px] opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-200 pointer-events-none group-hover:pointer-events-auto z-50">
                <div class="p-3 bg-white dark:bg-[#0c1827] rounded-3xl shadow-2xl border-2 border-slate-200 dark:border-slate-800 space-y-1 backdrop-blur-xl">
                  
                  <a href="/category/spl-ders-notlari/" class="flex items-start gap-3 p-2.5 rounded-2xl hover:bg-sky-50 dark:hover:bg-sky-950/40 transition-colors group/item">
                    <div class="w-8 h-8 rounded-xl bg-sky-500/10 text-sky-600 dark:text-sky-400 flex items-center justify-center shrink-0 border border-sky-500/20 group-hover/item:scale-110 transition-transform">
                      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6"></path></svg>
                    </div>
                    <div>
                      <h4 class="font-bold text-xs text-slate-900 dark:text-white group-hover/item:text-sky-600 dark:group-hover/item:text-sky-400 transition-colors">SPL Lisanslama Sınavları</h4>
                      <p class="text-[11px] text-slate-500 dark:text-slate-400">Düzey 1, 2, 3 Notları, Takas & Operasyon</p>
                    </div>
                  </a>

                  <a href="/category/masak-uyum-gorevlisi-yetkilendirme-ders-notlari/" class="flex items-start gap-3 p-2.5 rounded-2xl hover:bg-emerald-50 dark:hover:bg-emerald-950/40 transition-colors group/item">
                    <div class="w-8 h-8 rounded-xl bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 flex items-center justify-center shrink-0 border border-emerald-500/20 group-hover/item:scale-110 transition-transform">
                      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"></path></svg>
                    </div>
                    <div>
                      <h4 class="font-bold text-xs text-slate-900 dark:text-white group-hover/item:text-emerald-600 dark:group-hover/item:text-emerald-400 transition-colors">MASAK Uyum Görevlisi</h4>
                      <p class="text-[11px] text-slate-500 dark:text-slate-400">5549 Sayılı Kanun, AML/CFT, Modül 1 & 2</p>
                    </div>
                  </a>

                  <a href="/category/cia-ders-notlari/" class="flex items-start gap-3 p-2.5 rounded-2xl hover:bg-purple-50 dark:hover:bg-purple-950/40 transition-colors group/item">
                    <div class="w-8 h-8 rounded-xl bg-purple-500/10 text-purple-600 dark:text-purple-400 flex items-center justify-center shrink-0 border border-purple-500/20 group-hover/item:scale-110 transition-transform">
                      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 14l9-5-9-5-9 5 9 5z"></path><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 14l6.16-3.422a12.083 12.083 0 01.665 6.479A11.952 11.952 0 0012 20.055a11.952 11.952 0 00-6.824-2.998 12.078 12.078 0 01.665-6.479L12 14z"></path></svg>
                    </div>
                    <div>
                      <h4 class="font-bold text-xs text-slate-900 dark:text-white group-hover/item:text-purple-600 dark:group-hover/item:text-purple-400 transition-colors">CIA Part 1 Sertifikası</h4>
                      <p class="text-[11px] text-slate-500 dark:text-slate-400">IIA Küresel Standartları ve İç Denetim</p>
                    </div>
                  </a>

                  <a href="/category/denetim-kutuphanesi/" class="flex items-start gap-3 p-2.5 rounded-2xl hover:bg-amber-50 dark:hover:bg-amber-950/40 transition-colors group/item">
                    <div class="w-8 h-8 rounded-xl bg-amber-500/10 text-amber-600 dark:text-amber-400 flex items-center justify-center shrink-0 border border-amber-500/20 group-hover/item:scale-110 transition-transform">
