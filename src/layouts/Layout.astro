              </button>
              
              <!-- Dropdown Card -->
              <div class="absolute left-0 top-full pt-2 w-[340px] opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-200 pointer-events-none group-hover:pointer-events-auto z-50">
                <div class="p-3 bg-white dark:bg-[#0c1827] rounded-3xl shadow-2xl border-2 border-slate-200 dark:border-slate-800 space-y-1 backdrop-blur-xl">
                  
                  <a href="/category/spl-ders-notlari/" class="flex items-start gap-3 p-2.5 rounded-2xl hover:bg-sky-50 dark:hover:bg-sky-950/40 transition-colors group/item">
                    <div class="w-8 h-8 rounded-xl bg-sky-500/10 text-sky-600 dark:text-sky-400 flex items-center justify-center shrink-0 border border-sky-500/20 group-hover/item:scale-110 transition-transform">
                      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6"></path></svg>
                    </div>
                    <div>
                      <h4 class="font-bold text-xs text-slate-900 dark:text-white group-hover/item:text-sky-600 dark:group-hover/item:text-sky-400 transition-colors">SPL Lisanslama Sınavları</h4>
                      <p class="text-[11px] text-slate-500 dark:text-slate-400">Düzey 1, 2, 3 Notları, Takas & Operasyon</p>
                    </div>
                  </a>

                  <a href="/category/masak-uyum-gorevlisi-yetkilendirme-ders-notlari/" class="flex items-start gap-3 p-2.5 rounded-2xl hover:bg-emerald-50 dark:hover:bg-emerald-950/40 transition-colors group/item">
                    <div class="w-8 h-8 rounded-xl bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 flex items-center justify-center shrink-0 border border-emerald-500/20 group-hover/item:scale-110 transition-transform">
                      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"></path></svg>
                    </div>
                    <div>
