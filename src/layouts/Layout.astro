          <button id="saved-questions-trigger" type="button" class="text-amber-400 hover:text-amber-300 font-bold flex items-center gap-1 cursor-pointer">
            <span>⭐ Hata Defterim</span>
            <span id="saved-count-badge" class="px-1.5 py-0.5 rounded-full bg-amber-500 text-slate-950 font-black text-[10px]">0</span>
          </button>
          <span class="text-slate-700">|</span>
          <a href="/deneme-sinavlari/" class="text-amber-400 hover:text-amber-300 font-bold flex items-center gap-1.5 bg-amber-500/10 hover:bg-amber-500/20 px-2.5 py-0.5 rounded-md border border-amber-500/30 transition-colors">
            <span>🎯 Sınav Çöz</span>
          </a>
          <span class="text-slate-700">|</span>
          <button id="theme-toggle" type="button" aria-label="Karanlık Mod Geçişi" class="p-1 rounded-md hover:bg-slate-800 text-slate-300 hover:text-white transition-colors flex items-center gap-1 cursor-pointer font-medium">
