                    <div class="w-8 h-8 rounded-xl bg-purple-500/10 text-purple-600 dark:text-purple-400 flex items-center justify-center shrink-0 border border-purple-500/20 group-hover/item:scale-110 transition-transform">
                      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 14l9-5-9-5-9 5 9 5z"></path><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 14l6.16-3.422a12.083 12.083 0 01.665 6.479A11.952 11.952 0 0012 20.055a11.952 11.952 0 00-6.824-2.998 12.078 12.078 0 01.665-6.479L12 14z"></path></svg>
                    </div>
                    <div>
                      <h4 class="font-bold text-xs text-slate-900 dark:text-white group-hover/item:text-purple-600 dark:group-hover/item:text-purple-400 transition-colors">CIA Part 1 Sertifikası</h4>
                      <p class="text-[11px] text-slate-500 dark:text-slate-400">IIA Küresel Standartları ve İç Denetim</p>
                    </div>
                  </a>

                  <a href="/category/denetim-kutuphanesi/" class="flex items-start gap-3 p-2.5 rounded-2xl hover:bg-amber-50 dark:hover:bg-amber-950/40 transition-colors group/item">
