            <div class="flex flex-col">
              <div class="flex items-center gap-2">
                <span class="text-xl sm:text-2xl font-black tracking-tight text-slate-900 dark:text-white leading-none">
                  mufettis<span class="text-brand-600 dark:text-sky-400 font-extrabold">.org</span>
                </span>
                <span class="px-2 py-0.5 rounded-full text-[9px] font-black uppercase tracking-wider bg-sky-500/10 text-sky-700 dark:text-sky-300 border border-sky-500/30">
                  Akademi
                </span>
              </div>
              <span class="text-[10px] font-bold tracking-wider text-slate-400 dark:text-slate-400 uppercase mt-1 hidden sm:block">
                Denetim, Sınav & Mevzuat Portalı
              </span>
            </div>
          </a>

          <!-- Master Navigation Menu -->
          <nav class="hidden xl:flex items-center gap-1 text-[13px] font-bold text-slate-700 dark:text-slate-200">
            
            <a href="/" class="px-3.5 py-2 rounded-xl hover:text-brand-600 dark:hover:text-sky-400 hover:bg-slate-100 dark:hover:bg-slate-800/80 transition-colors">
              Anasayfa
            </a>

            <!-- 1. Sınav Kütüphanesi Mega-Dropdown -->
