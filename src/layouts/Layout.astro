    <!-- CLIENT SCRIPTS -->
    <script>
      // 0. Body Scroll Locking Helpers (iOS & Android friendly)
      function lockScroll() {
        document.body.classList.add('overflow-hidden');
      }
      function unlockScroll() {
        document.body.classList.remove('overflow-hidden');
      }

      // 1. Theme toggle
      const toggle = document.getElementById('theme-toggle');
      const drawerThemeToggle = document.getElementById('drawer-theme-toggle');
      function switchTheme() {
        const isDark = document.documentElement.classList.toggle('dark');
        localStorage.setItem('theme', isDark ? 'dark' : 'light');
      }
      toggle?.addEventListener('click', switchTheme);
      drawerThemeToggle?.addEventListener('click', switchTheme);

      // 2. Mobile Menu Drawer (Smooth Glide-in + Backdrop Blur + Scroll Lock)
      const mobileBtn = document.getElementById('mobile-menu-btn');
      const mobileDrawer = document.getElementById('mobile-menu-drawer');
      const mobileOverlay = document.getElementById('mobile-menu-overlay');
      const mobilePanel = document.getElementById('mobile-menu-panel');
      const mobileClose = document.getElementById('mobile-menu-close');

      function openMobileDrawer() {
        mobileDrawer?.classList.remove('pointer-events-none');
        mobileDrawer?.classList.add('pointer-events-auto');
        mobileOverlay?.classList.remove('opacity-0');
        mobileOverlay?.classList.add('opacity-100');
        mobilePanel?.classList.remove('translate-x-full');
        mobilePanel?.classList.add('translate-x-0');
        lockScroll();
      }

      function closeMobileDrawer() {
        mobileOverlay?.classList.remove('opacity-100');
        mobileOverlay?.classList.add('opacity-0');
        mobilePanel?.classList.remove('translate-x-0');
        mobilePanel?.classList.add('translate-x-full');
        setTimeout(() => {
          mobileDrawer?.classList.remove('pointer-events-auto');
          mobileDrawer?.classList.add('pointer-events-none');
          unlockScroll();
        }, 280);
      }

      mobileBtn?.addEventListener('click', openMobileDrawer);
      mobileClose?.addEventListener('click', closeMobileDrawer);
      mobileOverlay?.addEventListener('click', closeMobileDrawer);

      // 3. Instant Search Engine
      const modal = document.getElementById('search-modal');
      const trigger = document.getElementById('search-trigger');
      const closeBtn = document.getElementById('search-close');
      const clearBtn = document.getElementById('search-clear');
      const input = document.getElementById('search-input') as HTMLInputElement;
      const results = document.getElementById('search-results');
      const filterChips = document.querySelectorAll('.search-filter-chip');

      let allPosts: any[] = [];
      let activeFilter = 'all';
      let searchLoaded = false;

      function loadSearchData(callback?: () => void) {
        if (searchLoaded) {
          if (callback) callback();
          return;
        }
        searchLoaded = true;
        fetch('/api/search.json')
          .then(res => res.json())
          .then(data => { 
            allPosts = data; 
            if (callback) callback();
            else if (input && !input.value.trim()) renderInitialSuggestions(); 
          })
          .catch(() => {});
      }

      function openSearch() {
        loadSearchData(() => {
          if (!input.value.trim()) renderInitialSuggestions();
        });
        modal?.classList.remove('hidden');
        lockScroll();
        input?.focus();
        if (allPosts.length > 0 && !input.value.trim()) renderInitialSuggestions();
      }

      function closeSearch() {
        modal?.classList.add('hidden');
        unlockScroll();
      }

      trigger?.addEventListener('click', openSearch);
      trigger?.addEventListener('pointerenter', () => loadSearchData(), { once: true });
      closeBtn?.addEventListener('click', closeSearch);

      window.addEventListener('keydown', (e) => {
        if ((e.metaKey || e.ctrlKey) && e.key === 'k') {
          e.preventDefault();
          loadSearchData();
          openSearch();
        }
        if (e.key === 'Escape' && !modal?.classList.contains('hidden')) {
          closeSearch();
        }
      });

      modal?.addEventListener('click', (e) => {
        if (e.target === modal) closeSearch();
      });

      // Filter chips handling
      filterChips.forEach(chip => {
        chip.addEventListener('click', () => {
          filterChips.forEach(c => {
            c.classList.remove('bg-brand-600', 'text-white', 'font-bold');
            c.classList.add('bg-slate-100', 'dark:bg-slate-800', 'text-slate-700', 'dark:text-slate-300', 'font-semibold');
          });
          chip.classList.remove('bg-slate-100', 'dark:bg-slate-800', 'text-slate-700', 'dark:text-slate-300');
          chip.classList.add('bg-brand-600', 'text-white', 'font-bold');
          activeFilter = chip.getAttribute('data-filter') || 'all';
          performSearch();
        });
      });

      // Turkish-aware normalization helper
      function trNormalize(str: string): string {
        if (!str) return '';
        return str
          .toLowerCase()
          .replace(/ı/g, 'i')
          .replace(/ğ/g, 'g')
          .replace(/ü/g, 'u')
          .replace(/ş/g, 's')
          .replace(/ö/g, 'o')
          .replace(/ç/g, 'c')
          .normalize('NFD')
          .replace(/[\u0300-\u036f]/g, '')
          .trim();
      }

      // Safe keyword highlighting helper
      function highlightKeywords(text: string, rawQuery: string): string {
        if (!text || !rawQuery) return text;
        const tokens = rawQuery.trim().split(/\s+/).filter(t => t.length > 0);
        if (!tokens.length) return text;

        const charMap: Record<string, string> = {
          'i': '[iİıI]', 'ı': '[iİıI]',
          's': '[sSşŞ]', 'ş': '[sSşŞ]',
          'c': '[cCçÇ]', 'ç': '[cCçÇ]',
          'o': '[oOöÖ]', 'ö': '[oOöÖ]',
          'u': '[uUüÜ]', 'ü': '[uUüÜ]',
          'g': '[gGğĞ]', 'ğ': '[gGğĞ]'
        };

        const patterns = tokens.map(tok => {
          return tok.split('').map(ch => {
            const low = ch.toLowerCase();
            return charMap[low] || ch.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
          }).join('');
        });

        try {
          const regex = new RegExp(`(${patterns.join('|')})`, 'gi');
          return text.replace(regex, '<mark class="bg-amber-300 dark:bg-amber-400/40 text-amber-950 dark:text-amber-100 font-extrabold px-1 rounded">$1</mark>');
        } catch (e) {
          return text;
        }
      }

      function renderInitialSuggestions() {
        if (!results) return;
        const featured = allPosts.slice(0, 6);
        results.innerHTML = `
          <div class="px-2 pt-1 pb-2 flex items-center justify-between text-[11px] font-bold uppercase tracking-wider text-slate-400">
            <span>Öne Çıkan Rehberler & Sınavlar:</span>
            <span class="text-[10px] text-slate-400 font-normal">Mevzuat maddesi veya kavram arayabilirsiniz</span>
          </div>
          <div class="space-y-2">
            ${featured.map(p => renderSearchResultCard(p, false, p.excerpt || '')).join('')}
          </div>
        `;
      }

      function renderSearchResultCard(p: any, matchInContent: boolean, snippet: string, rawQuery: string = '') {
        const catName = p.categories && p.categories[0] ? p.categories[0].name : 'Sınav Notu';
        const isQuizBadge = p.is_quiz 
          ? '<span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-md bg-amber-500 text-slate-950 font-black text-[10px] uppercase shadow-2xs"><svg class="w-2.5 h-2.5 fill-current" viewBox="0 0 24 24"><path d="M13 10V3L4 14h7v7l9-11h-7z"/></svg> Deneme</span>'
          : '<span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-md bg-sky-100 dark:bg-sky-950 text-sky-700 dark:text-sky-300 font-bold text-[10px] uppercase border border-sky-200 dark:border-sky-800/60"><svg class="w-2.5 h-2.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"/></svg> Ders Notu</span>';

        const contentBadge = matchInContent 
          ? '<span class="inline-flex items-center gap-1 text-[10px] font-bold text-emerald-700 dark:text-emerald-300 bg-emerald-50 dark:bg-emerald-950/70 border border-emerald-300/80 dark:border-emerald-800 px-2 py-0.5 rounded-md"><svg class="w-2.5 h-2.5 text-emerald-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"/></svg> İlgili Madde / İçerik Eşleşmesi</span>'
          : '';

        const highlightedTitle = rawQuery ? highlightKeywords(p.title, rawQuery) : p.title;
        const highlightedSnippet = rawQuery ? highlightKeywords(snippet, rawQuery) : snippet;

        return `
          <a href="${p.url}" class="search-result-item block p-3.5 sm:p-4 rounded-2xl bg-white dark:bg-[#0c1827] hover:bg-slate-50 dark:hover:bg-slate-800/90 transition-all border border-slate-200 dark:border-slate-800 hover:border-brand-500 dark:hover:border-sky-500 group shadow-2xs hover:shadow-md">
            <div class="flex items-start gap-3.5">
              ${p.featured_image ? `
                <div class="w-16 h-14 sm:w-20 sm:h-16 rounded-xl overflow-hidden bg-slate-950 shrink-0 border border-slate-200 dark:border-slate-800 mt-0.5">
                  <img src="${p.featured_image}" alt="${p.title}" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300" loading="lazy" />
                </div>
              ` : ''}

              <div class="flex-grow min-w-0">
                <div class="flex flex-wrap items-center gap-1.5 sm:gap-2 mb-1.5">
                  ${isQuizBadge}
                  <span class="text-[10.5px] font-bold text-slate-500 dark:text-slate-400 bg-slate-100 dark:bg-slate-800 px-2 py-0.5 rounded-md">${catName}</span>
                  ${contentBadge}
                  <span class="text-[10.5px] text-slate-400 ml-auto shrink-0 inline-flex items-center gap-1">
                    <svg class="w-3 h-3 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                    ${p.reading_time || 5} dk
                  </span>
                </div>

                <h4 class="font-extrabold text-slate-900 dark:text-white text-xs sm:text-sm group-hover:text-brand-600 dark:group-hover:text-sky-400 transition-colors leading-snug">
                  ${highlightedTitle}
                </h4>

                ${highlightedSnippet ? `
                  <p class="text-[11.5px] sm:text-xs text-slate-600 dark:text-slate-300 mt-1.5 leading-relaxed bg-slate-50 dark:bg-slate-950/60 p-2 sm:p-2.5 rounded-xl border border-slate-100 dark:border-slate-800/80 font-sans line-clamp-2">
                    <span class="text-[9.5px] uppercase font-bold text-slate-400 dark:text-slate-500 mr-1.5 tracking-wider">İlgili Pasaj:</span>
                    ${highlightedSnippet}
                  </p>
                ` : ''}
              </div>
            </div>
          </a>
        `;
      }

      function performSearch() {
        const rawQ = input?.value || '';
        const q = rawQ.trim();
        if (!results) return;

        if (clearBtn) clearBtn.classList.toggle('hidden', !q);

        if (!q) {
          renderInitialSuggestions();
          return;
        }

        const normQ = trNormalize(q);
        const tokens = normQ.split(/\s+/).filter(t => t.length > 0);

        let filtered = allPosts;

        // Apply category filter
        if (activeFilter === 'spl') {
          filtered = filtered.filter(p => p.categories && p.categories.some((c: any) => c.slug.includes('spl')));
        } else if (activeFilter === 'masak') {
          filtered = filtered.filter(p => p.categories && p.categories.some((c: any) => c.slug.includes('masak')));
        } else if (activeFilter === 'cia') {
          filtered = filtered.filter(p => p.categories && p.categories.some((c: any) => c.slug.includes('cia')));
        } else if (activeFilter === 'banka') {
          filtered = filtered.filter(p => p.categories && p.categories.some((c: any) => c.slug.includes('banka') || c.slug.includes('kariyer')));
        } else if (activeFilter === 'quiz') {
          filtered = filtered.filter(p => p.is_quiz);
        }

        // Score and find snippet for every post
        const scoredMatches: any[] = [];

        for (const p of filtered) {
          const normTitle = p._normTitle || (p._normTitle = trNormalize(p.title));
          const normExcerpt = p._normExcerpt || (p._normExcerpt = trNormalize(p.excerpt));
          const normContent = p._normContent || (p._normContent = trNormalize(p.content));

          let score = 0;
          let matchInContent = false;
          let bestPos = -1;

          // 1. Exact phrase in title
          if (normTitle.includes(normQ)) {
            score += 300;
          }

          // 2. Individual tokens in title
          tokens.forEach(tok => {
            if (normTitle.includes(tok)) score += 70;
          });

          // 3. Excerpt match
          if (normExcerpt && normExcerpt.includes(normQ)) score += 60;
          tokens.forEach(tok => {
            if (normExcerpt && normExcerpt.includes(tok)) score += 20;
          });

          // 4. Content match
          const fullContentIdx = normContent.indexOf(normQ);
          if (fullContentIdx !== -1) {
            score += 150;
            matchInContent = true;
            bestPos = fullContentIdx;
          } else {
            let tokenHits = 0;
            for (const tok of tokens) {
              const idx = normContent.indexOf(tok);
              if (idx !== -1) {
                tokenHits++;
                score += 25;
                if (bestPos === -1) bestPos = idx;
              }
            }
            if (tokenHits > 0) matchInContent = true;
          }

          // Check categories & tags
          if (p.categories) {
            p.categories.forEach((cat: any) => {
              const normCat = trNormalize(cat.name);
              if (normCat.includes(normQ)) score += 80;
            });
          }

          if (score > 0) {
            // Extract snippet
            let snippet = '';
            if (bestPos !== -1 && p.content) {
              const start = Math.max(0, bestPos - 45);
              const end = Math.min(p.content.length, bestPos + 135);
              snippet = (start > 0 ? '...' : '') + p.content.slice(start, end).trim() + (end < p.content.length ? '...' : '');
            } else if (p.excerpt) {
              snippet = p.excerpt;
            } else if (p.content) {
              snippet = p.content.slice(0, 140) + '...';
            }

            scoredMatches.push({
              post: p,
              score,
              matchInContent,
              snippet
            });
          }
        }

        // Sort by score descending
        scoredMatches.sort((a, b) => b.score - a.score);

        const topMatches = scoredMatches.slice(0, 12);

        if (topMatches.length === 0) {
          results.innerHTML = `
            <div class="text-center py-12 px-4 text-slate-400">
              <div class="w-12 h-12 mx-auto mb-3 rounded-2xl bg-slate-100 dark:bg-slate-800 flex items-center justify-center text-slate-400">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/></svg>
              </div>
              <p class="font-bold text-slate-800 dark:text-slate-200 text-sm">"${q}" ile eşleşen mevzuat veya soru bulunamadı.</p>
              <p class="text-xs text-slate-500 dark:text-slate-400 mt-1.5 max-w-sm mx-auto">
                Farklı bir kanun maddesi, kısaltma (örn: 5549, AML, Takasbank, CIA) veya üstteki kategori filtrelerini deneyebilirsiniz.
              </p>
            </div>
          `;
          return;
        }

        results.innerHTML = `
          <div class="px-2 pt-1 pb-2 flex items-center justify-between text-[11px] font-bold uppercase tracking-wider text-slate-400">
            <span>"${q}" İçin ${topMatches.length} Sonuç:</span>
            <span class="text-brand-600 dark:text-sky-400 font-semibold lowercase">içerik ve mevzuat dahil</span>
          </div>
          <div class="space-y-2.5">
            ${topMatches.map(m => renderSearchResultCard(m.post, m.matchInContent, m.snippet, q)).join('')}
          </div>
        `;
      }

      input?.addEventListener('input', performSearch);
      clearBtn?.addEventListener('click', () => {
        if (input) {
          input.value = '';
          performSearch();
          input.focus();
        }
      });

      // Global Access to Search Engine for Hero Omnibar & Jump Chips
      (window as any).openSearchModal = openSearch;
      (window as any).openSearchWithQuery = function(q: string) {
        openSearch();
        if (input) {
          input.value = q;
          performSearch();
        }
      };

      // 4. Hata Defterim Drawer Logic (Smooth Glide + Lock Scroll)
      const savedDrawer = document.getElementById('saved-questions-drawer');
      const savedOverlay = document.getElementById('saved-drawer-overlay');
      const savedPanel = document.getElementById('saved-drawer-panel');
      const savedTrigger = document.getElementById('saved-questions-trigger');
      const drawerSavedTrigger = document.getElementById('drawer-saved-trigger');
      const savedClose = document.getElementById('saved-drawer-close');
      const savedList = document.getElementById('saved-questions-list');
      const savedBadge = document.getElementById('saved-count-badge');
      const drawerSavedBadge = document.getElementById('drawer-saved-badge');
      const clearSavedBtn = document.getElementById('clear-saved-btn');

      function updateSavedBadge() {
        try {
          const saved = JSON.parse(localStorage.getItem('mufettis_saved_questions') || '[]');
          const count = saved.length.toString();
          if (savedBadge) savedBadge.textContent = count;
          if (drawerSavedBadge) drawerSavedBadge.textContent = count;
        } catch (e) {}
      }

      function renderSavedQuestions() {
        if (!savedList) return;
        try {
          const saved = JSON.parse(localStorage.getItem('mufettis_saved_questions') || '[]');
          if (saved.length === 0) {
            savedList.innerHTML = `
              <div class="text-center py-12 px-4 text-slate-400">
                <div class="w-16 h-16 mx-auto mb-4 rounded-2xl bg-amber-500/10 border border-amber-500/20 flex items-center justify-center text-amber-500 shadow-sm">
                  <svg class="w-8 h-8 fill-current" viewBox="0 0 24 24"><path d="M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z"/></svg>
                </div>
                <p class="font-extrabold text-sm sm:text-base text-slate-800 dark:text-slate-200">Henüz kayıtlı soru bulunmuyor.</p>
                <p class="text-xs text-slate-500 dark:text-slate-400 mt-2 max-w-xs mx-auto leading-relaxed">
                  Deneme sınavlarında yanlış çözdüğünüz veya <strong class="text-amber-500">yıldızladığınız</strong> sorular burada toplanır; tek tıkla doğrudan o soruya odaklanarak tekrar çözebilirsiniz.
                </p>
              </div>
            `;
            return;
          }

          savedList.innerHTML = saved.map((item: any, idx: number) => {
            const isWrong = (item.reason === 'wrong');
            const qNum = item.qNum || (idx + 1);
            const examTitle = item.examTitle || 'Deneme Sınavı';
            const shortTitle = item.title || `Soru #${qNum}`;
            const targetUrl = item.url || (item.path ? `${item.path}#${item.id || ('soru-' + qNum)}` : '#');
            const targetPath = item.path || (item.url ? item.url.split('#')[0] : '');
            const cardId = item.id || `soru-${qNum}`;

            const badgeColor = isWrong 
              ? 'bg-rose-50 text-rose-600 dark:bg-rose-950/60 dark:text-rose-300 border-rose-200 dark:border-rose-900/80' 
              : 'bg-amber-50 text-amber-600 dark:bg-amber-950/60 dark:text-amber-300 border-amber-200 dark:border-amber-900/80';
            const badgeLabel = isWrong ? '❌ Hatalı Çözüm' : '⭐ Kaydedilen';

            return `
              <div class="p-4 rounded-2xl bg-white dark:bg-[#0c1827] border-2 border-slate-200 dark:border-slate-800 hover:border-amber-500/60 transition-all duration-200 shadow-xs flex flex-col justify-between gap-3 group" data-card-id="${cardId}" data-target-path="${targetPath}">
                <div>
                  <div class="flex items-center justify-between gap-2 mb-2">
                    <div class="flex items-center gap-1.5 flex-wrap">
                      <span class="px-2 py-0.5 rounded-md text-[10px] font-bold border ${badgeColor}">
                        ${badgeLabel}
                      </span>
                      <span class="px-2 py-0.5 rounded-md text-[10px] font-black bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300 border border-slate-200 dark:border-slate-700">
                        Soru ${qNum}
                      </span>
                    </div>
                    <div class="flex items-center gap-1.5">
                      <span class="text-[10px] text-slate-400 font-medium">${item.date || ''}</span>
                      <button type="button" class="delete-saved-item text-slate-400 hover:text-rose-500 p-1 rounded-lg hover:bg-rose-50 dark:hover:bg-rose-950/40 cursor-pointer transition-colors" data-idx="${idx}" title="Bu soruyu defterden sil">
                        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
                      </button>
                    </div>
                  </div>

                  <span class="text-[11px] font-bold text-slate-400 dark:text-slate-500 block truncate mb-1">
                    ${examTitle}
                  </span>
                  <h4 class="font-bold text-xs text-slate-900 dark:text-white line-clamp-2 leading-relaxed">
                    ${shortTitle}
                  </h4>
                </div>

                <a href="${targetUrl}" class="retry-question-link w-full py-2 px-3 rounded-xl bg-amber-500 hover:bg-amber-400 text-slate-950 font-black text-xs flex items-center justify-center gap-1.5 shadow-sm transition-all active:scale-[0.98]">
                  <span>Soruyu Tekrar Çöz</span>
                  <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M13 7l5 5m0 0l-5 5m5-5H6"></path></svg>
                </a>
              </div>
            `;
          }).join('');

          // Bind delete buttons
          savedList.querySelectorAll('.delete-saved-item').forEach(b => {
            b.addEventListener('click', (e) => {
              e.stopPropagation();
              const idx = parseInt((e.currentTarget as HTMLElement).getAttribute('data-idx') || '0', 10);
              const saved = JSON.parse(localStorage.getItem('mufettis_saved_questions') || '[]');
              saved.splice(idx, 1);
              localStorage.setItem('mufettis_saved_questions', JSON.stringify(saved));
              updateSavedBadge();
              renderSavedQuestions();
            });
          });

          // Bind retry links so they close the drawer and trigger smooth focus even on the same page
          savedList.querySelectorAll('.retry-question-link').forEach(link => {
            link.addEventListener('click', (e) => {
              closeSavedDrawer();
              const href = (link as HTMLAnchorElement).getAttribute('href') || '';
              const [path, hash] = href.split('#');
              if (hash && (window.location.pathname === path || !path)) {
                e.preventDefault();
                if (window.location.hash !== '#' + hash) {
                  window.location.hash = hash;
                } else {
                  // Trigger manually if hash hasn't changed
                  window.dispatchEvent(new Event('hashchange'));
                }
              }
            });
          });

        } catch (e) {}
      }

      function openSavedDrawer() {
        updateSavedBadge();
        renderSavedQuestions();
        savedDrawer?.classList.remove('pointer-events-none');
        savedDrawer?.classList.add('pointer-events-auto');
        savedOverlay?.classList.remove('opacity-0');
        savedOverlay?.classList.add('opacity-100');
        savedPanel?.classList.remove('translate-x-full');
        savedPanel?.classList.add('translate-x-0');
        lockScroll();
      }

      function closeSavedDrawer() {
        savedOverlay?.classList.remove('opacity-100');
        savedOverlay?.classList.add('opacity-0');
        savedPanel?.classList.remove('translate-x-0');
        savedPanel?.classList.add('translate-x-full');
        setTimeout(() => {
          savedDrawer?.classList.remove('pointer-events-auto');
          savedDrawer?.classList.add('pointer-events-none');
          unlockScroll();
        }, 280);
      }

      savedTrigger?.addEventListener('click', openSavedDrawer);
      drawerSavedTrigger?.addEventListener('click', () => {
        closeMobileDrawer();
        setTimeout(openSavedDrawer, 300);
      });
      savedClose?.addEventListener('click', closeSavedDrawer);
      savedOverlay?.addEventListener('click', closeSavedDrawer);

      clearSavedBtn?.addEventListener('click', () => {
        if (confirm('Hata Defterinizdeki tüm kayıtlı soruları temizlemek istediğinize emin misiniz?')) {
          localStorage.removeItem('mufettis_saved_questions');
          updateSavedBadge();
          renderSavedQuestions();
        }
      });

      // Global drawer bindings for interactive quiz cross-calls
      (window as any).updateSavedBadge = updateSavedBadge;
      (window as any).renderSavedQuestions = renderSavedQuestions;
      (window as any).openSavedDrawer = openSavedDrawer;
      (window as any).closeSavedDrawer = closeSavedDrawer;

      updateSavedBadge();

      // 5. Back to Top Button Logic
      const backToTopBtn = document.getElementById('back-to-top-btn');
      window.addEventListener('scroll', () => {
        if (window.scrollY > 350) {
          backToTopBtn?.classList.remove('hidden');
        } else {
          backToTopBtn?.classList.add('hidden');
        }
      });
      backToTopBtn?.addEventListener('click', () => {
        window.scrollTo({ top: 0, behavior: 'smooth' });
      });

      // 6. Mobile Drawer Link Closure
      const drawerLinks = mobileDrawer?.querySelectorAll('a');
      drawerLinks?.forEach(link => {
        link.addEventListener('click', closeMobileDrawer);
      });

      // 7. Footer Interactive Handlers (Newsletter & Triggers)
      const newsletterForm = document.getElementById('newsletter-form');
      const newsletterEmail = document.getElementById('newsletter-email') as HTMLInputElement | null;
      const newsletterStatus = document.getElementById('newsletter-status');
      const newsletterSubmitBtn = document.getElementById('newsletter-submit-btn');

      newsletterForm?.addEventListener('submit', (e) => {
        e.preventDefault();
        if (newsletterEmail && newsletterEmail.value) {
          try {
            const raw = localStorage.getItem('mufettis_newsletter_subscribers');
            const list = raw ? JSON.parse(raw) : [];
            list.push({ email: newsletterEmail.value, date: new Date().toISOString() });
            localStorage.setItem('mufettis_newsletter_subscribers', JSON.stringify(list));
          } catch(err) {}

          if (newsletterStatus) {
            newsletterStatus.innerHTML = `<span class="text-emerald-400 font-bold flex items-center gap-1.5"><svg class="w-4 h-4 text-emerald-400 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"/></svg> Kaydınız başarıyla oluşturuldu! İlk e-bülteniniz Pazartesi günü iletilecektir.</span>`;
          }
          newsletterEmail.disabled = true;
          if (newsletterSubmitBtn) {
            (newsletterSubmitBtn as HTMLButtonElement).disabled = true;
            newsletterSubmitBtn.classList.add('opacity-75', 'cursor-default');
            newsletterSubmitBtn.innerHTML = `<span class="flex items-center gap-1.5"><svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"/></svg> Kaydedildi</span>`;
          }
        }
      });

      document.getElementById('footer-back-to-top')?.addEventListener('click', () => {
        window.scrollTo({ top: 0, behavior: 'smooth' });
      });

      document.querySelectorAll('.footer-search-trigger').forEach(b => {
        b.addEventListener('click', () => {
          document.getElementById('search-trigger')?.click();
        });
      });

      document.querySelectorAll('.footer-saved-trigger').forEach(b => {
        b.addEventListener('click', openSavedDrawer);
      });

      // 8. Mobile Bottom Dock Triggers
      document.getElementById('bottom-dock-menu')?.addEventListener('click', openMobileDrawer);
      document.getElementById('bottom-dock-search')?.addEventListener('click', openSearch);
    </script>
    
    <!-- Floating Back to Top Button (Positioned safely above bottom dock on mobile) -->
    <button 
      id="back-to-top-btn" 
      type="button" 
      aria-label="Yukarı Çık" 
      class="fixed bottom-[calc(4.75rem+env(safe-area-inset-bottom))] xl:bottom-6 right-4 sm:right-6 z-40 hidden p-3 rounded-2xl bg-brand-600 hover:bg-brand-500 text-white shadow-2xl transition-all duration-300 hover:scale-110 border-2 border-white/20 cursor-pointer active:scale-95"
    >
      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 10l7-7m0 0l7 7m-7-7v18"></path></svg>
    </button>

    <!-- MOBILE APP BOTTOM NAVIGATION DOCK (Thumb Ergonomics, Safe-Area Compliant, Dynamic Active State) -->
    <nav id="mobile-bottom-dock" aria-label="Mobil Hızlı Menü" class="xl:hidden fixed bottom-0 inset-x-0 z-40 bg-white/95 dark:bg-[#071322]/95 backdrop-blur-xl border-t border-slate-200/90 dark:border-slate-800/90 shadow-[0_-4px_24px_rgba(0,0,0,0.08)]" style="padding-bottom: max(0.5rem, env(safe-area-inset-bottom));">
      <div class="grid grid-cols-5 h-14 max-w-lg mx-auto px-1 items-center">
        
        <!-- 1. Anasayfa -->
        <a href="/" class={`flex flex-col items-center justify-center gap-0.5 py-1 active:scale-90 transition-transform ${isHome ? 'text-sky-600 dark:text-sky-400 font-extrabold' : 'text-slate-500 dark:text-slate-400 font-semibold hover:text-brand-600'}`} aria-label="Anasayfa">
          <svg class="w-5 h-5 transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width={isHome ? '2.5' : '2'} d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"/></svg>
          <span class="text-[9.5px] tracking-tight">Anasayfa</span>
          {isHome && <span class="w-1 h-1 rounded-full bg-sky-500 animate-pulse -mt-0.5"></span>}
        </a>

        <!-- 2. Sınav Modülleri & Ders Notları -->
        <button type="button" id="bottom-dock-menu" class={`flex flex-col items-center justify-center gap-0.5 py-1 active:scale-90 transition-transform cursor-pointer ${isModules ? 'text-sky-600 dark:text-sky-400 font-extrabold' : 'text-slate-500 dark:text-slate-400 font-semibold hover:text-brand-600'}`} aria-label="Modüller">
          <svg class="w-5 h-5 transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width={isModules ? '2.5' : '2'} d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"/></svg>
          <span class="text-[9.5px] tracking-tight">Modüller</span>
          {isModules && <span class="w-1 h-1 rounded-full bg-sky-500 animate-pulse -mt-0.5"></span>}
        </button>

        <!-- 3. Çözümlü Deneme Sınavları (Hero Elevated Button) -->
        <a href="/deneme-sinavlari/" class="flex flex-col items-center justify-center -mt-5 active:scale-90 transition-transform group" aria-label="Çözümlü Denemeler">
          <div class={`w-12 h-12 rounded-2xl bg-gradient-to-tr from-amber-500 via-amber-400 to-amber-500 text-slate-950 flex items-center justify-center shadow-lg border-2 border-white dark:border-[#071322] group-hover:scale-105 transition-transform ${isExams ? 'ring-4 ring-amber-400/50 shadow-amber-500/50 scale-105' : 'shadow-amber-500/35'}`}>
            <svg class="w-6 h-6 fill-current text-slate-950" viewBox="0 0 24 24"><path d="M13 10V3L4 14h7v7l9-11h-7z"/></svg>
          </div>
          <span class="text-[9.5px] font-black text-amber-600 dark:text-amber-400 mt-0.5 tracking-tight">Denemeler</span>
        </a>

        <!-- 4. Maaş 2026 -->
        <a href="/maas-hesaplayici/" class={`flex flex-col items-center justify-center gap-0.5 py-1 active:scale-90 transition-transform ${isSalary ? 'text-emerald-500 dark:text-emerald-400 font-extrabold' : 'text-slate-500 dark:text-slate-400 font-semibold hover:text-emerald-600'}`} aria-label="Maaş Hesaplayıcı">
          <svg class="w-5 h-5 text-emerald-500 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width={isSalary ? '2.5' : '2'} d="M9 7h6m0 10v-3m-3 3h.01M9 17h.01M9 14h.01M12 14h.01M15 11h.01M12 11h.01M9 11h.01M7 21h10a2 2 0 002-2V5a2 2 0 00-2-2H7a2 2 0 00-2 2v14a2 2 0 002 2z"/></svg>
          <span class="text-[9.5px] tracking-tight">Maaş 2026</span>
          {isSalary && <span class="w-1 h-1 rounded-full bg-emerald-500 animate-pulse -mt-0.5"></span>}
        </a>

        <!-- 5. Hızlı Arama -->
