---
import Layout from '../layouts/Layout.astro';
import { getAllPosts } from '../utils/posts';

const posts = getAllPosts();
const quizList = posts.filter(p => p.is_quiz);

const splQuizzes = quizList.filter(p => p.categories && p.categories.some(c => c.slug.includes('spl')));
const masakQuizzes = quizList.filter(p => p.categories && p.categories.some(c => c.slug.includes('masak')));
const ciaQuizzes = quizList.filter(p => p.categories && p.categories.some(c => c.slug.includes('cia')));
---

<Layout 
  title="Çözümlü Deneme Sınavları & Testler"
  description="Banka Müfettişliği, SPL, MASAK ve CIA sınavlarına hazırlananlar için ayrıntılı çözümlü ve açıklamalı deneme testleri."
  canonical="https://mufettis.org/deneme-sinavlari/"
>
  <!-- Hero Section -->
  <section class="bg-gradient-to-b from-[#07192a] via-[#092237] to-[#05111d] text-white pt-16 pb-20 px-4 border-b border-brand-800 relative overflow-hidden">
    <div class="absolute right-0 top-0 w-96 h-96 bg-amber-500/10 rounded-full blur-3xl pointer-events-none"></div>

    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
      
      <!-- Breadcrumb -->
      <nav class="flex items-center gap-2 text-xs text-slate-400 mb-6">
        <a href="/" class="hover:text-white transition-colors">Anasayfa</a>
        <span>/</span>
        <span class="text-white font-bold">Deneme Sınavları</span>
      </nav>

      <div class="max-w-3xl">
        <div class="inline-flex items-center gap-1.5 px-3.5 py-1.5 rounded-full bg-amber-500/20 text-amber-300 text-xs font-black uppercase tracking-wider mb-4 border border-amber-500/40 shadow-sm">
          <svg class="w-3.5 h-3.5 text-amber-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M13 10V3L4 14h7v7l9-11h-7z"></path></svg>
          <span>Gerçek Sınav Simülatörü</span>
        </div>
        
        <h1 class="text-3xl sm:text-5xl font-black text-white tracking-tight leading-tight">
          Çözümlü Deneme Sınavları
        </h1>
        
        <p class="text-slate-300 text-sm sm:text-base mt-3 leading-relaxed">
          Tüm sorular SPL, MASAK ve IIA sınav formatına uygun olarak hazırlanmış olup, her sorunun altında <strong class="text-emerald-400 font-bold">detaylı mevzuat referansı ve kanun gerekçesi</strong> yer almaktadır.
        </p>

        <!-- Stats Counter -->
        <div class="mt-8 flex flex-wrap items-center gap-4 text-xs font-bold">
          <div class="px-4 py-2 rounded-2xl bg-white/10 backdrop-blur-sm border border-white/10 flex items-center gap-2">
            <svg class="w-4 h-4 text-amber-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path></svg>
            <span>{quizList.length} İnteraktif Test Seti</span>
          </div>
          <div class="px-4 py-2 rounded-2xl bg-white/10 backdrop-blur-sm border border-white/10 flex items-center gap-2">
            <svg class="w-4 h-4 text-emerald-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 6l3 1m0 0l-3 9a5.002 5.002 0 006.001 0M6 7l3 9M6 7l6-2m6 2l3-1m-3 1l-3 9a5.002 5.002 0 006.001 0M18 7l3 9m-3-9l-6-2m0-2v2m0 16V5m0 16H9m3 0h3"></path></svg>
            <span>200+ Çözümlü & Açıklamalı Soru</span>
          </div>
          <div class="px-4 py-2 rounded-2xl bg-white/10 backdrop-blur-sm border border-white/10 flex items-center gap-2">
            <svg class="w-4 h-4 text-sky-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><circle cx="12" cy="12" r="10" stroke-width="2"></circle><circle cx="12" cy="12" r="6" stroke-width="2"></circle><circle cx="12" cy="12" r="2" stroke-width="2"></circle></svg>
            <span>Anında Doğru / Yanlış & Karne</span>
          </div>
        </div>
      </div>

    </div>
  </section>

  <!-- Filter & Quiz Grid Section -->
  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-10 pb-28">
    
    <!-- Filter Chips (Touch Carousel on Mobile, Wrapped on Desktop) -->
    <div class="flex items-center justify-between pb-6 mb-8 border-b-2 border-slate-200 dark:border-slate-800 flex-wrap gap-4">
      <div class="flex items-center gap-2 overflow-x-auto whitespace-nowrap no-scrollbar pb-1 -mx-4 px-4 sm:mx-0 sm:px-0 sm:flex-wrap max-w-full">
        <button type="button" class="quiz-filter-btn active px-4 py-2 rounded-xl bg-amber-500 text-slate-950 font-black text-xs transition-all cursor-pointer shadow-sm shrink-0 active:scale-95" data-filter="all">
          Tüm Sınavlar ({quizList.length})
        </button>
        <button type="button" class="quiz-filter-btn px-4 py-2 rounded-xl bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300 hover:bg-slate-200 dark:hover:bg-slate-700 font-bold text-xs transition-all cursor-pointer inline-flex items-center gap-1.5 shrink-0 active:scale-95" data-filter="spl">
          <svg class="w-3.5 h-3.5 text-sky-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6"></path></svg>
          <span>SPL Lisanslama ({splQuizzes.length})</span>
        </button>
        <button type="button" class="quiz-filter-btn px-4 py-2 rounded-xl bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300 hover:bg-slate-200 dark:hover:bg-slate-700 font-bold text-xs transition-all cursor-pointer inline-flex items-center gap-1.5 shrink-0 active:scale-95" data-filter="masak">
          <svg class="w-3.5 h-3.5 text-emerald-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"></path></svg>
          <span>MASAK Uyum ({masakQuizzes.length})</span>
        </button>
        <button type="button" class="quiz-filter-btn px-4 py-2 rounded-xl bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300 hover:bg-slate-200 dark:hover:bg-slate-700 font-bold text-xs transition-all cursor-pointer inline-flex items-center gap-1.5 shrink-0 active:scale-95" data-filter="cia">
          <svg class="w-3.5 h-3.5 text-purple-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 14l9-5-9-5-9 5 9 5z"></path><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 14l6.16-3.422a12.083 12.083 0 01.665 6.479A11.952 11.952 0 0012 20.055a11.952 11.952 0 00-6.824-2.998 12.078 12.078 0 01.665-6.479L12 14z"></path></svg>
          <span>CIA Part 1 ({ciaQuizzes.length})</span>
        </button>
      </div>

      <span class="text-xs text-slate-500 dark:text-slate-400 font-medium">
        Kural: <strong class="text-emerald-600 dark:text-emerald-400 font-bold">%70 ve Üzeri Başarılı Sayılır</strong>
      </span>
    </div>

    <!-- Cards Grid -->
    <div id="quiz-grid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
      {quizList.map(quiz => {
        const catSlug = quiz.categories && quiz.categories[0] ? quiz.categories[0].slug : '';
        let filterTag = 'other';
        if (catSlug.includes('spl')) filterTag = 'spl';
        else if (catSlug.includes('masak')) filterTag = 'masak';
        else if (catSlug.includes('cia')) filterTag = 'cia';

        return (
          <article 
            class="quiz-card group bg-white dark:bg-[#0c1827] rounded-3xl border-2 border-slate-200 dark:border-slate-800 overflow-hidden shadow-sm hover:shadow-2xl transition-all duration-300 flex flex-col justify-between hover:border-amber-400"
            data-tag={filterTag}
          >
            <!-- Card Image -->
            <a href={quiz.url} class="block relative aspect-[16/10] overflow-hidden bg-slate-950">
              {quiz.featured_image ? (
                <img 
                  src={quiz.featured_image} 
                  alt={quiz.title} 
                  class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500 opacity-90"
                  loading="lazy"
                />
              ) : (
                <div class="w-full h-full flex items-center justify-center bg-slate-900 text-slate-600 font-bold">
                  mufettis.org Deneme
                </div>
              )}
              <div class="absolute inset-0 bg-gradient-to-t from-slate-950/70 via-transparent to-transparent"></div>
              
              <div class="absolute top-3 left-3">
                <span class="px-3 py-1 rounded-xl bg-amber-500 text-slate-950 font-black text-[10.5px] uppercase shadow-md flex items-center gap-1.5">
                  <svg class="w-3 h-3 text-slate-950" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M13 10V3L4 14h7v7l9-11h-7z"></path></svg>
                  <span>20 Soru Çözümlü</span>
                </span>
              </div>

              <div class="absolute bottom-3 right-3">
                <span class="px-2.5 py-1 rounded-lg bg-black/70 backdrop-blur-sm text-white text-[11px] font-bold flex items-center gap-1">
                  <svg class="w-3 h-3 text-slate-300" fill="none" stroke="currentColor" viewBox="0 0 24 24"><circle cx="12" cy="12" r="10" stroke-width="2"></circle><polyline points="12 6 12 12 16 14" stroke-width="2"></polyline></svg>
                  <span>{quiz.reading_time} dk süre</span>
                </span>
              </div>
            </a>

            <!-- Card Content -->
            <div class="p-6 sm:p-7 flex-grow flex flex-col justify-between">
              <div>
                <span class="text-[10px] font-black uppercase tracking-wider text-amber-500 block mb-1.5">
                  {quiz.categories && quiz.categories[0] ? quiz.categories[0].name : 'Deneme Sınavı'}
                </span>

                <a href={quiz.url}>
                  <h2 class="font-black text-slate-900 dark:text-white text-base sm:text-lg leading-snug group-hover:text-amber-500 transition-colors line-clamp-2 mb-3">
                    {quiz.title}
                  </h2>
                </a>

                <p class="text-slate-600 dark:text-slate-400 text-xs sm:text-[13px] line-clamp-3 leading-relaxed mb-5">
                  {quiz.excerpt}
                </p>
              </div>

              <div class="pt-5 border-t border-slate-100 dark:border-slate-800 flex items-center justify-between text-xs font-black">
                <span class="text-amber-500 flex items-center gap-1.5">
                  <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
                  Sınavı Başlat & Çöz
                </span>
                <span class="transform group-hover:translate-x-1.5 transition-transform">→</span>
              </div>
            </div>
          </article>
        );
      })}
    </div>

  </section>

  <!-- Client-Side Filter Script -->
  <script>
    const filterBtns = document.querySelectorAll('.quiz-filter-btn');
    const quizCards = document.querySelectorAll('.quiz-card');

    filterBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        filterBtns.forEach(b => {
          b.classList.remove('bg-amber-500', 'text-slate-950', 'font-black');
          b.classList.add('bg-slate-100', 'dark:bg-slate-800', 'text-slate-700', 'dark:text-slate-300', 'font-bold');
        });

        btn.classList.remove('bg-slate-100', 'dark:bg-slate-800', 'text-slate-700', 'dark:text-slate-300', 'font-bold');
        btn.classList.add('bg-amber-500', 'text-slate-950', 'font-black');

        const filter = btn.getAttribute('data-filter');

        quizCards.forEach(card => {
          const tag = card.getAttribute('data-tag');
          if (filter === 'all' || tag === filter) {
            card.classList.remove('hidden');
          } else {
            card.classList.add('hidden');
          }
        });
      });
    });
  </script>
</Layout>
