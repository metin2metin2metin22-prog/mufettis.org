---
import Layout from '../layouts/Layout.astro';
---

<Layout 
  title="İletişim & Bize Ulaşın | mufettis.org"
  description="Banka Müfettişliği, SPL, MASAK ve CIA sınavları, soru bildirimleri ve iş birliği için Müfettiş.org editoryal ve akademik kurulu ile doğrudan iletişime geçin."
>
  <!-- ======================================================== -->
  <!-- HERO / PAGE HEADER                                       -->
  <!-- ======================================================== -->
  <section class="relative pt-10 sm:pt-14 pb-10 overflow-hidden bg-gradient-to-b from-[#081524] via-[#050f1b] to-transparent border-b border-slate-200 dark:border-slate-800/80">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-sky-500/10 text-sky-700 dark:text-sky-300 border border-sky-500/20 text-xs font-black uppercase tracking-wider mb-3">
          <svg class="w-3.5 h-3.5 text-sky-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path></svg>
          <span>Müfettiş.org Kurumsal İletişim</span>
        </div>

        <h1 class="text-3xl sm:text-4xl lg:text-5xl font-black text-slate-900 dark:text-white tracking-tight leading-tight">
          Bize Ulaşın & Geri Bildirim
        </h1>
        <p class="mt-3 text-sm sm:text-base text-slate-600 dark:text-slate-300 leading-relaxed">
          Banka Teftiş Kurulları, Sermaye Piyasası Lisanslama (SPL), MASAK mevzuatı ve İç Denetim (CIA) süreçlerine ilişkin her türlü soru, mevzuat düzeltmesi, sınav sorusu bildirimi veya iş birliği talebinizi doğrudan editoryal kurulumuza iletebilirsiniz.
        </p>
      </div>
    </div>
  </section>

  <!-- ======================================================== -->
  <!-- MAIN CONTACT CONTENT GRID                                -->
  <!-- ======================================================== -->
  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10 sm:py-16">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-start">
      
      <!-- ==================================================== -->
      <!-- LEFT COLUMN: KURUMSAL BİLGİ & YÖNERGELER (5 Kolon)  -->
      <!-- ==================================================== -->
      <div class="lg:col-span-5 space-y-6">
        
        <!-- Info Card 1: Hızlı İletişim Kanalları -->
        <div class="p-6 rounded-3xl bg-white dark:bg-[#0c1827] border-2 border-slate-200 dark:border-slate-800 shadow-sm space-y-4">
          <h2 class="text-lg font-bold text-slate-900 dark:text-white flex items-center gap-2">
            <span class="w-2.5 h-2.5 rounded-full bg-emerald-500 animate-pulse"></span>
            <span>Editoryal İletişim Masası</span>
          </h2>
          <p class="text-xs text-slate-600 dark:text-slate-400 leading-relaxed">
            Gönderdiğiniz tüm mesajlar doğrudan denetçi ve editoryal yönetim panelimize düşmekte ve ilgili mevzuat uzmanı tarafından incelenmektedir.
          </p>

          <div class="space-y-3 pt-2 text-xs">
            <div class="flex items-center gap-3 p-3 rounded-2xl bg-slate-50 dark:bg-slate-900 border border-slate-200 dark:border-slate-800">
              <div class="w-9 h-9 rounded-xl bg-sky-500/10 text-sky-600 dark:text-sky-400 flex items-center justify-center shrink-0 border border-sky-500/20">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 12a4 4 0 10-8 0 4 4 0 008 0zm0 0v1.5a2.5 2.5 0 005 0V12a9 9 0 10-9 9m4.5-1.206a8.959 8.959 0 01-4.5 1.207"></path></svg>
              </div>
              <div>
                <span class="text-slate-400 font-medium block text-[10.5px]">Resmî İletişim E-Postası:</span>
                <a href="mailto:iletisim@mufettis.org" class="font-bold text-slate-900 dark:text-white hover:text-sky-500 transition-colors">iletisim@mufettis.org</a>
              </div>
            </div>

            <div class="flex items-center gap-3 p-3 rounded-2xl bg-slate-50 dark:bg-slate-900 border border-slate-200 dark:border-slate-800">
              <div class="w-9 h-9 rounded-xl bg-amber-500/10 text-amber-600 dark:text-amber-400 flex items-center justify-center shrink-0 border border-amber-500/20">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
              </div>
              <div>
                <span class="text-slate-400 font-medium block text-[10.5px]">Ortalama Yanıt Süresi:</span>
                <span class="font-bold text-slate-900 dark:text-white">Aynı gün içinde (maksimum 24 saat)</span>
              </div>
            </div>
          </div>
        </div>

        <!-- Info Card 2: Bildirim Türleri -->
        <div class="p-6 rounded-3xl bg-white dark:bg-[#0c1827] border-2 border-slate-200 dark:border-slate-800 shadow-sm space-y-3">
          <h3 class="text-sm font-bold text-slate-900 dark:text-white uppercase tracking-wider text-[11.5px] text-slate-400">
            Hangi Konularda Mesaj İletebilirsiniz?
          </h3>
          <ul class="space-y-2.5 text-xs text-slate-600 dark:text-slate-300">
            <li class="flex items-start gap-2">
              <svg class="w-4 h-4 text-emerald-500 shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"></path></svg>
              <span><strong>Soru & Cevap Gerekçesi Bildirimi:</strong> Deneme sınavlarındaki soru analizleri veya kanun gerekçelerine dair öneriler.</span>
            </li>
            <li class="flex items-start gap-2">
              <svg class="w-4 h-4 text-emerald-500 shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"></path></svg>
              <span><strong>Mevzuat Düzeltmesi:</strong> Resmî Gazete'de yayımlanan güncel BDDK, SPK veya MASAK tebliğ değişiklikleri.</span>
            </li>
            <li class="flex items-start gap-2">
              <svg class="w-4 h-4 text-emerald-500 shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"></path></svg>
              <span><strong>Banka Teftiş İlanları:</strong> Kamu ve özel bankaların teftiş kurulu sınav ve müfettiş yardımcılığı duyuruları.</span>
            </li>
            <li class="flex items-start gap-2">
              <svg class="w-4 h-4 text-emerald-500 shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"></path></svg>
              <span><strong>İş Birliği & Teftiş Portalı Katkısı:</strong> Denetim makaleleri ve editoryal katkı başvuruları.</span>
            </li>
          </ul>
        </div>

        <!-- Info Card 3: Topluluk & Sosyal Ağlar -->
        <div class="p-6 rounded-3xl bg-gradient-to-br from-[#0c2238] to-[#061424] border-2 border-brand-800 text-white shadow-md">
          <h3 class="text-sm font-bold mb-2">Canlı Sınav ve Denetçi Ağı</h3>
          <p class="text-xs text-slate-300 leading-relaxed mb-4">
            Telegram grubumuzda aktif olarak sınav soruları ve banka teftiş mülakatları tartışılmaktadır.
          </p>
          <div class="flex flex-wrap gap-2 text-xs">
            <a href="https://t.me" target="_blank" rel="noopener noreferrer" class="px-3 py-1.5 rounded-xl bg-white/10 hover:bg-white/20 text-sky-300 border border-white/10 transition-colors font-bold inline-flex items-center gap-1.5">
              <span>Telegram Kanalı</span>
              <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"></path></svg>
            </a>
            <a href="/rss.xml" target="_blank" class="px-3 py-1.5 rounded-xl bg-white/10 hover:bg-white/20 text-amber-300 border border-white/10 transition-colors font-bold inline-flex items-center gap-1.5">
              <span>Mevzuat RSS Akışı</span>
              <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
            </a>
          </div>
        </div>

      </div>

      <!-- ==================================================== -->
      <!-- RIGHT COLUMN: İNTERAKTİF İLETİŞİM FORMU (7 Kolon)    -->
      <!-- ==================================================== -->
      <div class="lg:col-span-7">
        <div class="p-6 sm:p-9 rounded-3xl bg-white dark:bg-[#0c1827] border-2 border-slate-200 dark:border-slate-800 shadow-xl relative overflow-hidden">
          
          <div class="mb-6">
            <h2 class="text-xl sm:text-2xl font-black text-slate-900 dark:text-white tracking-tight">
              Mesaj Gönderin
            </h2>
            <p class="text-xs sm:text-sm text-slate-500 dark:text-slate-400 mt-1">
              Formu eksiksiz doldurarak doğrudan yönetici masamıza mesajınızı iletebilirsiniz.
            </p>
          </div>

          <!-- Alert Feedback Container (Dynamic JS) -->
          <div id="form-alert" class="hidden mb-6 p-4 rounded-2xl text-xs font-bold transition-all duration-300"></div>

          <!-- The Form -->
          <form id="contact-form" class="space-y-4">
            
            <!-- Honeypot anti-spam -->
            <input type="text" name="_gotcha" class="hidden" tabindex="-1" autocomplete="off" />

            <!-- Row 1: Name & Email -->
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <div>
                <label for="contact-name" class="block text-xs font-bold text-slate-700 dark:text-slate-300 mb-1.5">
                  Adınız ve Soyadınız <span class="text-rose-500">*</span>
                </label>
                <input 
                  id="contact-name" 
                  name="name" 
                  type="text" 
                  required 
                  placeholder="Örn: Ahmet Yılmaz" 
                  class="w-full px-4 py-3 rounded-2xl bg-slate-50 dark:bg-slate-900 border-2 border-slate-200 dark:border-slate-800 focus:border-sky-500 focus:bg-white dark:focus:bg-[#081220] text-slate-900 dark:text-white text-xs sm:text-sm font-semibold outline-none transition-all"
                />
              </div>

              <div>
                <label for="contact-email" class="block text-xs font-bold text-slate-700 dark:text-slate-300 mb-1.5">
                  E-Posta Adresiniz <span class="text-rose-500">*</span>
                </label>
                <input 
                  id="contact-email" 
                  name="email" 
                  type="email" 
                  required 
                  placeholder="adiniz@banka.com.tr" 
                  class="w-full px-4 py-3 rounded-2xl bg-slate-50 dark:bg-slate-900 border-2 border-slate-200 dark:border-slate-800 focus:border-sky-500 focus:bg-white dark:focus:bg-[#081220] text-slate-900 dark:text-white text-xs sm:text-sm font-semibold outline-none transition-all"
                />
              </div>
            </div>

            <!-- Row 2: Subject Selection -->
            <div>
              <label for="contact-subject" class="block text-xs font-bold text-slate-700 dark:text-slate-300 mb-1.5">
                Konu / Bildirim Başlığı <span class="text-rose-500">*</span>
              </label>
              <select 
                id="contact-subject" 
                name="subject" 
                required 
                class="w-full px-4 py-3 rounded-2xl bg-slate-50 dark:bg-slate-900 border-2 border-slate-200 dark:border-slate-800 focus:border-sky-500 focus:bg-white dark:focus:bg-[#081220] text-slate-900 dark:text-white text-xs sm:text-sm font-semibold outline-none transition-all"
              >
                <option value="Soru & Çözüm Gerekçesi Bildirimi">Soru & Çözüm Gerekçesi Bildirimi</option>
                <option value="Mevzuat & Hata Düzeltmesi">Mevzuat & Hata Düzeltmesi</option>
                <option value="Banka Teftiş Sınavı Duyurusu">Banka Teftiş Sınavı Duyurusu</option>
                <option value="İş Birliği & Sponsorluk">İş Birliği & Sponsorluk</option>
                <option value="Genel Görüş & Teşekkür">Genel Görüş & Teşekkür</option>
                <option value="Diğer">Diğer</option>
              </select>
            </div>

            <!-- Row 3: Message Textarea -->
            <div>
              <label for="contact-message" class="block text-xs font-bold text-slate-700 dark:text-slate-300 mb-1.5">
                Mesajınız <span class="text-rose-500">*</span>
              </label>
              <textarea 
                id="contact-message" 
                name="message" 
                rows="6" 
                required 
                minlength="10"
                placeholder="Lütfen iletmek istediğiniz detayları, ilgili sınav veya soru numarasını ya da mevzuat maddesini ayrıntılı olarak yazınız..."
                class="w-full px-4 py-3 rounded-2xl bg-slate-50 dark:bg-slate-900 border-2 border-slate-200 dark:border-slate-800 focus:border-sky-500 focus:bg-white dark:focus:bg-[#081220] text-slate-900 dark:text-white text-xs sm:text-sm font-semibold outline-none transition-all resize-y"
              ></textarea>
              <span class="text-[11px] text-slate-400 mt-1 block">En az 10 karakter yazınız.</span>
            </div>

            <!-- Submit Button -->
            <button 
              id="contact-submit-btn" 
              type="submit" 
              class="w-full py-3.5 px-6 rounded-2xl bg-gradient-to-r from-brand-600 via-sky-600 to-brand-700 hover:from-brand-500 hover:to-sky-500 text-white font-extrabold text-sm shadow-lg shadow-sky-500/20 active:scale-[0.99] transition-all flex items-center justify-center gap-2 cursor-pointer"
            >
              <span id="submit-btn-text">Mesajı Güvenle Gönder</span>
              <svg id="submit-btn-icon" class="w-4 h-4 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M14 5l7 7m0 0l-7 7m7-7H3"></path></svg>
            </button>

            <p class="text-center text-[11px] text-slate-400 mt-3">
              🔒 Gönderilen tüm mesajlar KVKK ve gizlilik standartlarına uygun olarak korunur, üçüncü taraflarla paylaşılmaz.
            </p>

          </form>

        </div>
      </div>

    </div>
  </section>

  <!-- Client-side Form Dispatcher & Cloud Sync -->
  <script is:inline>
    const form = document.getElementById('contact-form');
    const alertBox = document.getElementById('form-alert');
    const submitBtn = document.getElementById('contact-submit-btn');
    const btnText = document.getElementById('submit-btn-text');
    const btnIcon = document.getElementById('submit-btn-icon');

    const INBOX_BIN_URL = 'https://extendsclass.com/api/json-storage/bin/baecfdc';

    form?.addEventListener('submit', async (e) => {
      e.preventDefault();

      // Check honeypot
      const honeypot = form.querySelector('input[name="_gotcha"]')?.value;
      if (honeypot) return;

      const name = document.getElementById('contact-name')?.value?.trim() || '';
      const email = document.getElementById('contact-email')?.value?.trim() || '';
      const subject = document.getElementById('contact-subject')?.value?.trim() || 'Genel';
      const message = document.getElementById('contact-message')?.value?.trim() || '';

      if (!name || !email || !message) {
        showAlert('Lütfen tüm zorunlu alanları doldurunuz.', 'error');
        return;
      }

      // Loading state
      submitBtn.disabled = true;
      btnText.textContent = 'Mesajınız İletiliyor...';
      btnIcon.innerHTML = '<circle cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4" class="opacity-25"></circle><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>';

      const newMsg = {
        id: 'msg_' + Date.now(),
        name: name,
        email: email,
        subject: subject,
        message: message,
        date: new Date().toLocaleString('tr-TR', { day: '2-digit', month: '2-digit', year: 'numeric', hour: '2-digit', minute: '2-digit' }),
        status: 'unread'
      };

      try {
        // 1. Fetch current inbox bin
        let currentMessages = [];
        try {
          const getResp = await fetch(INBOX_BIN_URL);
          if (getResp.ok) {
            const binData = await getResp.json();
            currentMessages = Array.isArray(binData.messages) ? binData.messages : [];
          }
        } catch (err) {}

        // 2. Prepend new message to array
        currentMessages.unshift(newMsg);

        // Keep maximum 200 recent messages
        if (currentMessages.length > 200) {
          currentMessages = currentMessages.slice(0, 200);
        }

        // 3. Put back to bin
        await fetch(INBOX_BIN_URL, {
          method: 'PUT',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            system: 'mufettis.org contact inbox system',
            last_updated: new Date().toISOString(),
            messages: currentMessages
          })
        });

        // 4. Also backup send via Formsubmit to owner's Gmail in background (fire-and-forget)
        try {
          fetch('https://formsubmit.co/ajax/metin2metin2metin22@gmail.com', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
            body: JSON.stringify({
              name: name,
              email: email,
              _subject: `[Müfettiş.org İletişim] ${subject} - ${name}`,
              message: message
            })
          }).catch(() => {});
        } catch (e) {}

        // Success UI
        showAlert('🎉 Mesajınız başarıyla iletildi! Editoryal kurulumuz mesajınızı inceleyerek en kısa sürede e-posta adresiniz üzerinden sizinle iletişime geçecektir.', 'success');
        form.reset();

      } catch (err) {
        showAlert('Mesaj gönderilirken geçici bir ağ sorunu oluştu. Lütfen tekrar deneyiniz veya iletisim@mufettis.org adresine doğrudan yazınız.', 'error');
      } finally {
        submitBtn.disabled = false;
        btnText.textContent = 'Mesajı Güvenle Gönder';
        btnIcon.innerHTML = '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M14 5l7 7m0 0l-7 7m7-7H3"></path>';
      }
    });

    function showAlert(msg, type) {
      if (!alertBox) return;
      alertBox.classList.remove('hidden', 'bg-emerald-100', 'text-emerald-900', 'border-emerald-400', 'dark:bg-emerald-950/80', 'dark:text-emerald-200', 'bg-rose-100', 'text-rose-900', 'border-rose-400', 'dark:bg-rose-950/80', 'dark:text-rose-200');
      
      if (type === 'success') {
        alertBox.className = 'mb-6 p-4 rounded-2xl text-xs font-bold bg-emerald-100 dark:bg-emerald-950/80 text-emerald-900 dark:text-emerald-200 border-2 border-emerald-400 dark:border-emerald-700 shadow-sm flex items-start gap-2.5';
        alertBox.innerHTML = `
          <svg class="w-5 h-5 text-emerald-600 dark:text-emerald-400 shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
          <div class="flex-grow">${msg}</div>
        `;
      } else {
        alertBox.className = 'mb-6 p-4 rounded-2xl text-xs font-bold bg-rose-100 dark:bg-rose-950/80 text-rose-900 dark:text-rose-200 border-2 border-rose-400 dark:border-rose-700 shadow-sm flex items-start gap-2.5';
        alertBox.innerHTML = `
          <svg class="w-5 h-5 text-rose-600 dark:text-rose-400 shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
          <div class="flex-grow">${msg}</div>
        `;
      }
      alertBox.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
    }
  </script>
</Layout>
