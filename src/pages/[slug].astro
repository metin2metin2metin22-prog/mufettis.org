  <!-- CLIENT SCRIPTS -->
  <script>
    // ==========================================
    // 1. INTERACTIVE EXAM & QUESTION ENGINE 3.0
    // ==========================================
    const quizCards = document.querySelectorAll('.interactive-quiz-card');
    const floatingHud = document.getElementById('floating-exam-hud');
    const hudAnswered = document.getElementById('hud-answered');
    const hudCorrect = document.getElementById('hud-correct');
    const hudWrong = document.getElementById('hud-wrong');
    const hudFinishBtn = document.getElementById('hud-finish-btn');
    const hudSoundBtn = document.getElementById('hud-sound-btn');
    const soundIcon = document.getElementById('sound-icon');
    const hudTimerBtn = document.getElementById('hud-timer-btn');
    const hudTimerText = document.getElementById('hud-timer-text');
    const quizToast = document.getElementById('quiz-toast');
    const toastMessage = document.getElementById('toast-message');
    
    const scoreCard = document.getElementById('exam-score-card');
    const scorePercent = document.getElementById('score-percent');
    const statTotal = document.getElementById('stat-total');
    const statCorrect = document.getElementById('stat-correct');
    const statWrong = document.getElementById('stat-wrong');
    const statEmpty = document.getElementById('stat-empty');
    const scoreEvaluation = document.getElementById('score-evaluation');
    const resetAllBtn = document.getElementById('reset-all-quiz-btn');

    let totalQuestions = quizCards.length;
    let answeredCount = 0;
    let correctCount = 0;
    let wrongCount = 0;

    // Web Audio Synthesizer
    let soundEnabled = true;
    function playAudio(type: 'correct' | 'wrong') {
      if (!soundEnabled) return;
      try {
        const AudioCtx = window.AudioContext || (window as any).webkitAudioContext;
        if (!AudioCtx) return;
        const ctx = new AudioCtx();
        const osc = ctx.createOscillator();
        const gain = ctx.createGain();
        osc.connect(gain);
        gain.connect(ctx.destination);
        const now = ctx.currentTime;

        if (type === 'correct') {
          osc.type = 'sine';
          osc.frequency.setValueAtTime(587.33, now); // D5
          osc.frequency.exponentialRampToValueAtTime(880, now + 0.12); // A5
          gain.gain.setValueAtTime(0.12, now);
          gain.gain.exponentialRampToValueAtTime(0.001, now + 0.28);
          osc.start(now);
          osc.stop(now + 0.28);
        } else {
          osc.type = 'triangle';
          osc.frequency.setValueAtTime(220, now);
          osc.frequency.setValueAtTime(175, now + 0.1);
          gain.gain.setValueAtTime(0.12, now);
          gain.gain.exponentialRampToValueAtTime(0.001, now + 0.28);
          osc.start(now);
          osc.stop(now + 0.28);
        }
      } catch (e) {}
    }

    hudSoundBtn?.addEventListener('click', () => {
      soundEnabled = !soundEnabled;
      if (soundIcon) {
        soundIcon.innerHTML = soundEnabled 
          ? '<svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.536 8.464a5 5 0 010 7.072m2.828-9.9a9 9 0 010 12.728M5.586 15H4a1 1 0 01-1-1v-4a1 1 0 011-1h1.586l4.707-4.707C10.923 3.663 12 4.109 12 5v14c0 .891-1.077 1.337-1.707.707L5.586 15z"></path></svg>'
          : '<svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5.586 15H4a1 1 0 01-1-1v-4a1 1 0 011-1h1.586l4.707-4.707C10.923 3.663 12 4.109 12 5v14c0 .891-1.077 1.337-1.707.707L5.586 15z"></path><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 14l2-2m0 0l2-2m-2 2l-2-2m2 2l2 2"></path></svg>';
      }
    });

    // Countdown Timer (30:00)
    let timeLeft = 30 * 60; // 30 mins
    let timerRunning = false;
    let timerInterval: any = null;

    function formatTime(s: number) {
      const mins = Math.floor(s / 60);
      const secs = s % 60;
      return `${mins.toString().padStart(2, '0')}:${secs.toString().padStart(2, '0')}`;
    }

    hudTimerBtn?.addEventListener('click', () => {
      if (timerRunning) {
        clearInterval(timerInterval);
        timerRunning = false;
        if (hudTimerText) hudTimerText.textContent = 'Durduruldu';
      } else {
        timerRunning = true;
        timerInterval = setInterval(() => {
          if (timeLeft > 0) {
            timeLeft--;
            if (hudTimerText) hudTimerText.textContent = formatTime(timeLeft);
          } else {
            clearInterval(timerInterval);
            timerRunning = false;
            alert('Sınav Süresi Doldu! Sınav karneniz hesaplanıyor...');
            hudFinishBtn?.click();
          }
        }, 1000);
      }
    });

    // Toast Helper
    function showToast(msg: string) {
      if (!quizToast || !toastMessage) return;
      toastMessage.textContent = msg;
      quizToast.classList.remove('hidden');
      setTimeout(() => quizToast.classList.add('hidden'), 2500);
    }

    if (totalQuestions > 0 && floatingHud) {
      floatingHud.classList.remove('hidden');
      updateHUD();
    }

    function updateHUD() {
      if (hudAnswered) {
        hudAnswered.innerHTML = `<span class="hidden sm:inline">${answeredCount} / ${totalQuestions} Soru</span><span class="sm:hidden">${answeredCount}/${totalQuestions}</span>`;
      }
      if (hudCorrect) hudCorrect.textContent = `${correctCount}`;
      if (hudWrong) hudWrong.textContent = `${wrongCount}`;

      // Update final scorecard stats
      if (statTotal) statTotal.textContent = `${totalQuestions}`;
      if (statCorrect) statCorrect.textContent = `${correctCount}`;
      if (statWrong) statWrong.textContent = `${wrongCount}`;
      if (statEmpty) statEmpty.textContent = `${totalQuestions - answeredCount}`;
      
      const pct = answeredCount > 0 ? Math.round((correctCount / answeredCount) * 100) : 0;
      if (scorePercent) scorePercent.textContent = `%${pct}`;

      if (scoreEvaluation) {
        if (pct >= 85) {
          scoreEvaluation.innerHTML = `<strong>Tebrikler! Mükemmel Performans:</strong> Bu konudaki mevzuat ve pratik soru çözüm kabiliyetiniz çok yüksek düzeyde. Gerçek sınavda da bu başarıyı rahatlıkla tekrarlayabilirsiniz.`;
        } else if (pct >= 70) {
          scoreEvaluation.innerHTML = `<strong>Başarılı! Sınav Barajı Aşıldı:</strong> Sınav geçme barajı olan %70 düzeyinin üzerindesiniz. Yanlış yaptığınız sorulardaki mevzuat maddelerini tekrar inceleyerek tam puanı hedefleyebilirsiniz.`;
        } else {
          scoreEvaluation.innerHTML = `<strong>Geliştirilmeli:</strong> Yanlış çözdüğünüz soruların altındaki "Mevzuat ve Çözüm Açıklaması" kutularını detaylıca okuyup, yukarıdaki butondan testi tekrar çözmenizi öneririz.`;
        }
      }
    }

    hudFinishBtn?.addEventListener('click', () => {
      scoreCard?.classList.remove('hidden');
      scoreCard?.scrollIntoView({ behavior: 'smooth' });
    });

    quizCards.forEach((card, cardIndex) => {
      const qNum = card.getAttribute('data-question-num') || (cardIndex + 1).toString();
      const cardId = `soru-${qNum}`;
      card.id = cardId;
      card.setAttribute('data-card-id', cardId);
      card.setAttribute('data-question-num', qNum);

      const correctAnswer = (card.getAttribute('data-correct-answer') || 'A').trim().toUpperCase();
      const optionButtons = card.querySelectorAll('.quiz-option-btn');
      const feedbackBox = card.querySelector('.quiz-feedback-box');
      const feedbackMessage = card.querySelector('.feedback-message');
      const feedbackBanner = card.querySelector('.feedback-banner');
      const statusBadge = card.querySelector('.quiz-status-badge');
      const statusText = card.querySelector('.status-text');
      const statusDot = card.querySelector('.status-dot');
      const resetBtn = card.querySelector('.quiz-reset-btn');
      const starBtn = card.querySelector('.quiz-star-btn');

      const pageTitle = document.querySelector('h1')?.textContent?.trim() || 'Deneme Sınavı';
      const stemEl = card.querySelector('.question-stem');
      const rawStem = stemEl ? (stemEl.textContent || '') : (card.querySelector('.question-stem h3')?.textContent || 'Sınav Sorusu');
      const cleanStem = rawStem.replace(/\s+/g, ' ').trim();
      const shortStem = cleanStem.length > 110 ? cleanStem.slice(0, 110) + '...' : (cleanStem || `Soru #${qNum}`);
      const questionUrl = `${window.location.pathname}#${cardId}`;

      function saveToHataDefteri(reason: 'wrong' | 'starred') {
        try {
          const saved = JSON.parse(localStorage.getItem('mufettis_saved_questions') || '[]');
          const existingIdx = saved.findIndex((s: any) => (s.id === cardId && s.path === window.location.pathname) || s.url === questionUrl);
          const itemData = {
            id: cardId,
            qNum: qNum,
            examTitle: pageTitle,
            title: shortStem,
            path: window.location.pathname,
            url: questionUrl,
            date: new Date().toLocaleDateString('tr-TR'),
            reason: reason
          };
          if (existingIdx >= 0) {
            saved[existingIdx] = itemData;
          } else {
            saved.push(itemData);
          }
          localStorage.setItem('mufettis_saved_questions', JSON.stringify(saved));
          if (typeof (window as any).updateSavedBadge === 'function') {
            (window as any).updateSavedBadge();
          }
        } catch (e) {}
      }

      function removeFromHataDefteri() {
        try {
          const saved = JSON.parse(localStorage.getItem('mufettis_saved_questions') || '[]');
          const existingIdx = saved.findIndex((s: any) => (s.id === cardId && s.path === window.location.pathname) || s.url === questionUrl || s.title === shortStem);
          if (existingIdx >= 0) {
            saved.splice(existingIdx, 1);
            localStorage.setItem('mufettis_saved_questions', JSON.stringify(saved));
            if (typeof (window as any).updateSavedBadge === 'function') {
              (window as any).updateSavedBadge();
            }
            return true;
          }
        } catch (e) {}
        return false;
      }

      // Initial check if this card is already starred in Hata Defteri
      try {
        const saved = JSON.parse(localStorage.getItem('mufettis_saved_questions') || '[]');
        if (saved.some((s: any) => (s.id === cardId && s.path === window.location.pathname) || s.url === questionUrl)) {
          starBtn?.classList.remove('text-slate-400');
          starBtn?.classList.add('text-amber-500');
        }
      } catch (e) {}

      // Star / Bookmark handling (LocalStorage)
      starBtn?.addEventListener('click', (e) => {
        e.stopPropagation();
        try {
          const saved = JSON.parse(localStorage.getItem('mufettis_saved_questions') || '[]');
          const existingIdx = saved.findIndex((s: any) => (s.id === cardId && s.path === window.location.pathname) || s.url === questionUrl);
          if (existingIdx >= 0) {
            saved.splice(existingIdx, 1);
            localStorage.setItem('mufettis_saved_questions', JSON.stringify(saved));
            showToast(`Soru ${qNum} Hata Defterinizden çıkarıldı.`);
            starBtn.classList.remove('text-amber-500');
            starBtn.classList.add('text-slate-400');
          } else {
            saveToHataDefteri('starred');
            showToast(`Soru ${qNum} Hata Defterinize kaydedildi!`);
            starBtn.classList.add('text-amber-500');
            starBtn.classList.remove('text-slate-400');
          }
          if (typeof (window as any).updateSavedBadge === 'function') {
            (window as any).updateSavedBadge();
          }
        } catch (e) {}
      });

      let isAnswered = false;

      optionButtons.forEach((btn) => {
        btn.addEventListener('click', () => {
          if (isAnswered) return;
          isAnswered = true;
          answeredCount++;

          const selectedOption = (btn.getAttribute('data-option') || '').trim().toUpperCase();

          // Disable choices
          optionButtons.forEach(b => {
            (b as HTMLButtonElement).disabled = true;
            b.classList.remove('hover:border-brand-500', 'hover:bg-brand-50/50', 'dark:hover:bg-brand-950/30', 'cursor-pointer');
            b.classList.add('cursor-default');
          });

          const isCorrect = (selectedOption === correctAnswer);

          if (isCorrect) {
            correctCount++;
            playAudio('correct');

            // If this question was previously in Hata Defteri, celebrate and remove it
            const wasRemoved = removeFromHataDefteri();
            if (wasRemoved) {
              starBtn?.classList.remove('text-amber-500');
              starBtn?.classList.add('text-slate-400');
              showToast(`🎉 Harika! Soru ${qNum} başarıyla kavrandı ve Hata Defterinden temizlendi!`);

              const focusBadge = card.querySelector('.hata-defteri-focus-badge');
              if (focusBadge) {
                focusBadge.className = 'hata-defteri-focus-badge mb-3.5 inline-flex items-center gap-2 px-3.5 py-1.5 rounded-xl bg-gradient-to-r from-emerald-600 to-teal-600 text-white font-extrabold text-xs shadow-md transition-all duration-300';
                focusBadge.innerHTML = `
                  <svg class="w-4 h-4 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"></path></svg>
                  <span>Hata Defteri: Soru Başarıyla Çözüldü ve Temizlendi ✓</span>
                `;
              }
            }

            // Selected Option Styling
            btn.classList.add('bg-emerald-50', 'dark:bg-emerald-950/40', 'border-emerald-500', 'text-emerald-950', 'dark:text-emerald-100');
            const badge = btn.querySelector('.option-badge');
            if (badge) {
              badge.className = 'option-badge inline-flex items-center justify-center w-8 h-8 rounded-xl bg-emerald-600 text-white border-2 border-emerald-600 font-extrabold text-sm shadow-md';
              badge.innerHTML = `${selectedOption} <svg class="w-3 h-3 inline ml-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7"></path></svg>`;
            }

            // Top Status Badge
            if (statusBadge && statusText && statusDot) {
              statusBadge.className = 'quiz-status-badge text-[11px] font-bold px-3 py-1 rounded-full bg-emerald-600 text-white flex items-center gap-1.5 shadow-sm';
              statusText.textContent = 'Doğru Çözüldü';
              statusDot.className = 'status-dot w-2 h-2 rounded-full bg-white';
            }

            // Feedback Banner
            if (feedbackBanner && feedbackMessage) {
              feedbackBanner.className = 'feedback-banner p-4 rounded-2xl mb-4 font-bold text-sm flex items-center justify-between shadow-sm bg-emerald-100 dark:bg-emerald-950/80 text-emerald-900 dark:text-emerald-200 border-2 border-emerald-400 dark:border-emerald-700';
              feedbackMessage.innerHTML = `<span class="flex items-center gap-2"><svg class="w-4 h-4 text-emerald-600 dark:text-emerald-400 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg> Tebrikler, Doğru Seçenek: <strong>(${correctAnswer})</strong></span>`;
            }
          } else {
            wrongCount++;
            playAudio('wrong');

            // Automatically save to Hata Defteri on wrong answer with full deep-link metadata
            saveToHataDefteri('wrong');
            starBtn?.classList.add('text-amber-500');
            starBtn?.classList.remove('text-slate-400');

            // Selected Option Styling
            btn.classList.add('bg-rose-50', 'dark:bg-rose-950/40', 'border-rose-500', 'text-rose-950', 'dark:text-rose-100');
            const badge = btn.querySelector('.option-badge');
            if (badge) {
              badge.className = 'option-badge inline-flex items-center justify-center w-8 h-8 rounded-xl bg-rose-600 text-white border-2 border-rose-600 font-extrabold text-sm shadow-md';
              badge.innerHTML = `${selectedOption} <svg class="w-3 h-3 inline ml-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M6 18L18 6M6 6l12 12"></path></svg>`;
            }

            // Highlight True Correct Answer
            optionButtons.forEach(b => {
              if (b.getAttribute('data-option')?.trim().toUpperCase() === correctAnswer) {
                b.classList.add('bg-emerald-50', 'dark:bg-emerald-950/40', 'border-emerald-500', 'text-emerald-950', 'dark:text-emerald-100');
                const cBadge = b.querySelector('.option-badge');
                if (cBadge) {
                  cBadge.className = 'option-badge inline-flex items-center justify-center w-8 h-8 rounded-xl bg-emerald-600 text-white border-2 border-emerald-600 font-extrabold text-sm shadow-md';
                  cBadge.innerHTML = `${correctAnswer} <svg class="w-3 h-3 inline ml-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7"></path></svg>`;
                }
              }
            });

            // Top Status Badge
            if (statusBadge && statusText && statusDot) {
              statusBadge.className = 'quiz-status-badge text-[11px] font-bold px-3 py-1 rounded-full bg-rose-600 text-white flex items-center gap-1.5 shadow-sm';
              statusText.textContent = 'Yanlış Çözüldü';
              statusDot.className = 'status-dot w-2 h-2 rounded-full bg-white';
            }

            // Feedback Banner
            if (feedbackBanner && feedbackMessage) {
              feedbackBanner.className = 'feedback-banner p-4 rounded-2xl mb-4 font-bold text-sm flex items-center justify-between shadow-sm bg-rose-100 dark:bg-rose-950/80 text-rose-900 dark:text-rose-200 border-2 border-rose-400 dark:border-rose-700';
              feedbackMessage.innerHTML = `<span class="flex items-center gap-2"><svg class="w-4 h-4 text-rose-600 dark:text-rose-400 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M10 14l2-2m0 0l2-2m-2 2l-2-2m2 2l2 2m7-2a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg> Yanlış Seçenek. Doğru Seçenek: <strong>(${correctAnswer})</strong> (Hata Defterinize Eklendi)</span>`;
            }
          }

          // Slide open explanation box
          if (feedbackBox) {
            feedbackBox.classList.remove('hidden');
          }

          updateHUD();

          // Auto-show final score card when all answered
          if (answeredCount === totalQuestions && scoreCard) {
            scoreCard.classList.remove('hidden');
          }
        });
      });

      // Reset single question handler
      resetBtn?.addEventListener('click', () => {
        if (!isAnswered) return;
        
        // Find if this card was previously correct or wrong
        const wasCorrect = statusText?.textContent?.includes('Doğru');
        if (wasCorrect) correctCount--;
        else wrongCount--;
        answeredCount--;
        isAnswered = false;

        optionButtons.forEach(b => {
          (b as HTMLButtonElement).disabled = false;
          b.className = 'quiz-option-btn group w-full text-left py-3 px-4 sm:py-3.5 sm:px-5 rounded-xl border-2 border-slate-200 dark:border-slate-800 bg-slate-50/70 hover:bg-brand-50/50 dark:bg-slate-900/40 dark:hover:bg-brand-950/30 hover:border-brand-500 dark:hover:border-sky-500 transition-all duration-200 flex items-start gap-3.5 sm:gap-4 cursor-pointer focus:outline-none focus:ring-2 focus:ring-brand-500/40 relative overflow-hidden';
          const opt = b.getAttribute('data-option');
          const badge = b.querySelector('.option-badge');
          if (badge) {
            badge.className = 'option-badge inline-flex items-center justify-center w-8 h-8 rounded-xl bg-white dark:bg-slate-800 border-2 border-slate-300 dark:border-slate-700 font-extrabold text-sm text-slate-700 dark:text-slate-300 group-hover:border-brand-500 group-hover:bg-brand-600 group-hover:text-white transition-all shrink-0 shadow-sm';
            badge.textContent = opt || '';
          }
        });

        if (feedbackBox) feedbackBox.classList.add('hidden');
        if (statusBadge && statusText && statusDot) {
          statusBadge.className = 'quiz-status-badge text-[11px] font-bold px-3 py-1 rounded-full bg-black/40 text-slate-300 border border-slate-700/60 flex items-center gap-1.5 backdrop-blur-sm shadow-xs transition-colors';
          statusText.textContent = 'Yanıt Bekliyor';
          statusDot.className = 'status-dot w-2 h-2 rounded-full bg-slate-400';
        }

        updateHUD();
      });
    });
    // Reset All Questions Handler
    resetAllBtn?.addEventListener('click', () => {
      quizCards.forEach(card => {
        const btn = card.querySelector('.quiz-reset-btn') as HTMLButtonElement;
        btn?.click();
      });
      scoreCard?.classList.add('hidden');
      window.scrollTo({ top: 0, behavior: 'smooth' });
    });

    // ==========================================
    // DEEP-LINKING HATA DEFTERİ FOCUS & SPOTLIGHT
    // ==========================================
    function handleQuestionDeepLink() {
      const hash = window.location.hash;
      if (!hash || !hash.startsWith('#soru-')) return;

      const targetId = hash.substring(1);
      const targetCard = document.getElementById(targetId);
      if (!targetCard) return;

      setTimeout(() => {
        const headerOffset = 130;
        const elPos = targetCard.getBoundingClientRect().top + window.pageYOffset;
        window.scrollTo({
          top: Math.max(0, elPos - headerOffset),
          behavior: 'smooth'
        });

        // Add vibrant spotlight aura
        targetCard.classList.add('ring-4', 'ring-amber-400', 'dark:ring-amber-500', 'shadow-2xl', 'border-amber-400', 'dark:border-amber-500');

        // Add spotlight banner badge if not exists
        if (!targetCard.querySelector('.hata-defteri-focus-badge')) {
          const focusBadge = document.createElement('div');
          focusBadge.className = 'hata-defteri-focus-badge mb-3.5 inline-flex items-center gap-2 px-3.5 py-1.5 rounded-xl bg-gradient-to-r from-amber-500 to-amber-600 text-white font-extrabold text-xs shadow-md animate-pulse';
          focusBadge.innerHTML = `
            <svg class="w-4 h-4 text-white shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M13 10V3L4 14h7v7l9-11h-7z"></path></svg>
            <span>Hata Defteri Odak Noktası — Bu Soruyu Tekrar Çözün</span>
          `;
          const stem = targetCard.querySelector('.question-stem');
          if (stem) {
            stem.parentNode?.insertBefore(focusBadge, stem);
          } else {
            targetCard.prepend(focusBadge);
          }
        }

        // Auto unlock/reset question if already answered so user can immediately re-solve
        const resetBtn = targetCard.querySelector('.quiz-reset-btn') as HTMLButtonElement;
        const statusText = targetCard.querySelector('.status-text')?.textContent || '';
        if (statusText.includes('Yanlış') || statusText.includes('Doğru')) {
          resetBtn?.click();
        }

        setTimeout(() => {
          targetCard.classList.remove('ring-4', 'ring-amber-400', 'dark:ring-amber-500', 'shadow-2xl');
        }, 7000);
      }, 200);
    }

    window.addEventListener('load', handleQuestionDeepLink);
    window.addEventListener('hashchange', handleQuestionDeepLink);

    // ==========================================
    // 2. AUTO-GENERATED TABLE OF CONTENTS WITH SCROLL SPY
    // ==========================================
    const articleBody = document.getElementById('article-body');
    const tocCard = document.getElementById('toc-card');
    const tocList = document.getElementById('toc-list');

    if (articleBody && tocCard && tocList) {
      const allHeadings = Array.from(articleBody.querySelectorAll('h2, h3'));
      const headings = allHeadings.filter(h => !h.closest('.interactive-quiz-card'));
      if (headings.length >= 2) {
        tocCard.classList.remove('hidden');
        
        headings.forEach((h, index) => {
          const id = h.id || `section-${index + 1}`;
          h.id = id;
          const isH3 = h.tagName.toLowerCase() === 'h3';

          const a = document.createElement('a');
          a.href = `#${id}`;
          a.textContent = h.textContent || '';
          a.setAttribute('data-target-id', id);
          a.className = `toc-link block py-1.5 px-2.5 rounded-lg hover:bg-slate-100 dark:hover:bg-slate-800/80 transition-colors truncate ${
            isH3 
              ? 'pl-5 text-slate-500 dark:text-slate-400 font-medium text-[11.5px]' 
              : 'font-bold text-slate-800 dark:text-slate-200 text-xs'
          }`;
          tocList.appendChild(a);
        });

        // Active Scroll Spy
        window.addEventListener('scroll', () => {
          let currentId = '';
          headings.forEach(h => {
            const rect = h.getBoundingClientRect();
            if (rect.top <= 140) {
              currentId = h.id;
            }
          });

          const tocLinks = tocList.querySelectorAll('.toc-link');
          tocLinks.forEach(link => {
            if (link.getAttribute('data-target-id') === currentId) {
              link.classList.add('bg-brand-50', 'dark:bg-sky-950/60', 'text-brand-700', 'dark:text-sky-300', 'font-black');
            } else {
              link.classList.remove('bg-brand-50', 'dark:bg-sky-950/60', 'text-brand-700', 'dark:text-sky-300', 'font-black');
            }
          });
        });
      }
    }

    // ==========================================
    // 3. READING PROGRESS BAR
    // ==========================================
    window.addEventListener('scroll', () => {
      const winScroll = document.documentElement.scrollTop;
      const height = document.documentElement.scrollHeight - document.documentElement.clientHeight;
      const scrolled = (winScroll / height) * 100;
      const bar = document.getElementById('read-progress');
      if (bar) bar.style.width = scrolled + '%';
    });

    // ==========================================
    // 4. FONT SIZE TOGGLE (A+ / A-)
    // ==========================================
    const fontBtn = document.getElementById('font-toggle-btn');
    let isLargeFont = false;
    fontBtn?.addEventListener('click', () => {
      isLargeFont = !isLargeFont;
      if (isLargeFont) {
        articleBody?.classList.add('text-lg', 'sm:text-xl');
        fontBtn.textContent = 'A-';
      } else {
        articleBody?.classList.remove('text-lg', 'sm:text-xl');
        fontBtn.textContent = 'A+';
      }
    });

    // ==========================================
    // 5. TEXT-TO-SPEECH (TTS 2.0 WITH SPEED)
    // ==========================================
    const ttsBtn = document.getElementById('tts-btn');
    const ttsSpeedBtn = document.getElementById('tts-speed-btn');
    const ttsIcon = document.getElementById('tts-icon');
    const ttsText = document.getElementById('tts-text');
    let isSpeaking = false;
    let ttsRate = 1.0;

    const speeds = [1.0, 1.25, 1.5];
    let speedIndex = 0;

    ttsSpeedBtn?.addEventListener('click', () => {
      speedIndex = (speedIndex + 1) % speeds.length;
      ttsRate = speeds[speedIndex];
      ttsSpeedBtn.textContent = `${ttsRate.toFixed(1)}x`;
      if (isSpeaking) {
        window.speechSynthesis.cancel();
        startSpeaking();
      }
    });

    function startSpeaking() {
      const textToRead = articleBody?.innerText || '';
      const utterance = new SpeechSynthesisUtterance(textToRead.slice(0, 6000));
      utterance.lang = 'tr-TR';
      utterance.rate = ttsRate;

      utterance.onend = () => {
        isSpeaking = false;
        if (ttsIcon) ttsIcon.innerHTML = '<svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.536 8.464a5 5 0 010 7.072m2.828-9.9a9 9 0 010 12.728M5.586 15H4a1 1 0 01-1-1v-4a1 1 0 011-1h1.586l4.707-4.707C10.923 3.663 12 4.109 12 5v14c0 .891-1.077 1.337-1.707.707L5.586 15z"></path></svg>';
        if (ttsText) ttsText.textContent = 'Sesli Dinle';
      };

      window.speechSynthesis.speak(utterance);
      isSpeaking = true;
      if (ttsIcon) ttsIcon.innerHTML = '<svg class="w-3.5 h-3.5 text-rose-500" fill="currentColor" viewBox="0 0 24 24"><rect x="6" y="6" width="12" height="12" rx="2"></rect></svg>';
      if (ttsText) ttsText.textContent = 'Durdur';
    }

    ttsBtn?.addEventListener('click', () => {
      if (!('speechSynthesis' in window)) {
        alert('Tarayıcınız sesli okumayı desteklemiyor.');
        return;
      }

      if (isSpeaking) {
        window.speechSynthesis.cancel();
        isSpeaking = false;
        if (ttsIcon) ttsIcon.innerHTML = '<svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.536 8.464a5 5 0 010 7.072m2.828-9.9a9 9 0 010 12.728M5.586 15H4a1 1 0 01-1-1v-4a1 1 0 011-1h1.586l4.707-4.707C10.923 3.663 12 4.109 12 5v14c0 .891-1.077 1.337-1.707.707L5.586 15z"></path></svg>';
        if (ttsText) ttsText.textContent = 'Sesli Dinle';
      } else {
        startSpeaking();
      }
    });

    // 6. Print, Native Share & Copy Link
    document.getElementById('print-btn')?.addEventListener('click', () => window.print());
    
    const copyBtn = document.getElementById('copy-link-btn');
    copyBtn?.addEventListener('click', () => {
      navigator.clipboard.writeText(window.location.href).then(() => {
        copyBtn.textContent = 'Kopyalandı!';
        setTimeout(() => { copyBtn.textContent = 'Bağlantıyı Kopyala'; }, 2000);
      });
    });

    const nativeShareBtn = document.getElementById('native-share-btn');
    nativeShareBtn?.addEventListener('click', async () => {
      if (navigator.share) {
        try {
          await navigator.share({
            title: document.title,
            text: document.querySelector('meta[name="description"]')?.getAttribute('content') || document.title,
            url: window.location.href,
          });
        } catch (err) {}
      } else {
        copyBtn?.click();
      }
    });

    // 7. Auto-wrap Tables for Smooth Mobile Horizontal Scrolling
    
    document.querySelectorAll('#article-body table').forEach((table) => {
      if (!table.parentElement?.classList.contains('table-responsive-container')) {
        const wrapper = document.createElement('div');
        wrapper.className = 'table-responsive-container overflow-x-auto my-6 rounded-2xl border border-slate-200 dark:border-slate-800 shadow-xs';
        table.parentNode?.insertBefore(wrapper, table);
        wrapper.appendChild(table);
      }
    });
  </script>
</Layout>
