---
import Layout from '../layouts/Layout.astro';
import posts from '../data/posts.json';

export async function getStaticPaths() {
  return posts.map(post => ({
    params: { slug: post.slug },
    props: { post }
  }));
}

const { post } = Astro.props;

// Related posts
const primaryCat = post.categories && post.categories[0] ? post.categories[0].slug : null;
const relatedPosts = posts
  .filter(p => p.slug !== post.slug && primaryCat && p.categories.some(c => c.slug === primaryCat) && p.featured_image)
  .slice(0, 4);

// Quiz recommendations for sidebar
const quizRecommendations = posts.filter(p => p.is_quiz && p.slug !== post.slug).slice(0, 3);

// Format date in Turkish
const formattedDate = new Date(post.date).toLocaleDateString('tr-TR', {
  year: 'numeric',
  month: 'long',
  day: 'numeric'
});

// JSON-LD Schema
const schemaArticle = {
  "@context": "https://schema.org",
  "@type": post.is_quiz ? "Quiz" : "Article",
  "headline": post.title,
  "description": post.seo.description || post.excerpt,
  "image": post.featured_image ? `https://mufettis.org${post.featured_image}` : undefined,
  "datePublished": post.date,
  "dateModified": post.date,
  "mainEntityOfPage": {
    "@type": "WebPage",
    "@id": `https://mufettis.org/${post.slug}/`
  },
  "author": {
    "@type": "Organization",
    "name": "mufettis.org",
    "url": "https://mufettis.org"
  },
  "publisher": {
    "@type": "Organization",
    "name": "mufettis.org",
    "logo": {
      "@type": "ImageObject",
      "url": "https://mufettis.org/wp-content/uploads/2026/04/cropped-mufettis.org-favicon-1-180x180.png"
    }
  }
};
---

<Layout 
  title={post.seo.title || post.title}
  description={post.seo.description || post.excerpt}
  image={post.featured_image || "/wp-content/uploads/2026/04/mufettis.org_-scaled.png"}
  type="article"
  publishDate={post.date}
  canonical={`https://mufettis.org/${post.slug}/`}
>
  <script type="application/ld+json" set:html={JSON.stringify(schemaArticle)} />

  <!-- Reading Progress Bar (Sticky Top) -->
  <div id="read-progress" class="fixed top-0 left-0 h-1 bg-gradient-to-r from-amber-400 to-sky-500 z-50 transition-all duration-75 w-0"></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-8 pb-24">
    
    <!-- Breadcrumb -->
    <nav class="flex items-center gap-2 text-xs text-slate-500 dark:text-slate-400 mb-6 overflow-x-auto whitespace-nowrap pb-1">
      <a href="/" class="hover:text-brand-600 dark:hover:text-sky-400 transition-colors font-medium">Anasayfa</a>
      <span>/</span>
      {post.categories && post.categories[0] ? (
        <>
          <a href={`/category/${post.categories[0].slug}/`} class="hover:text-brand-600 dark:hover:text-sky-400 transition-colors font-medium">
            {post.categories[0].name}
          </a>
          <span>/</span>
        </>
      ) : (
        <>
          <span>Sayfa</span>
          <span>/</span>
        </>
      )}
      <span class="text-slate-800 dark:text-slate-200 font-semibold truncate max-w-sm">{post.title}</span>
    </nav>

    <!-- Main 2-Column Grid -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-10">
      
      <!-- Left Column: Main Article Body (8 Cols) -->
      <article class="lg:col-span-8">
        
        <!-- Post Header -->
        <header class="mb-6">
          {post.categories && post.categories.length > 0 && (
            <div class="flex flex-wrap items-center gap-2 mb-3">
              {post.categories.map(c => (
                <a href={`/category/${c.slug}/`} class="text-[11px] font-black uppercase tracking-wider px-3 py-1 rounded-md bg-brand-50 dark:bg-brand-950/70 text-brand-700 dark:text-sky-400 border border-brand-200/60 dark:border-brand-800 hover:bg-brand-100 transition-colors">
                  {c.name}
                </a>
              ))}
              {post.is_quiz && (
                <span class="text-[11px] font-black uppercase tracking-wider px-3 py-1 rounded-md bg-amber-100 dark:bg-amber-950/70 text-amber-800 dark:text-amber-300 border border-amber-300 dark:border-amber-800 flex items-center gap-1 shadow-xs">
                  ⚡ Çözümlü Deneme Testi
                </span>
              )}
            </div>
          )}

          <h1 class="text-2xl sm:text-4xl md:text-[40px] font-black text-slate-900 dark:text-white tracking-tight leading-tight mb-5">
            {post.title}
          </h1>

          <!-- Meta & Action Toolbar -->
          <div class="py-3 px-4 rounded-xl bg-white dark:bg-[#0b1726] border border-slate-200 dark:border-slate-800 flex flex-wrap items-center justify-between gap-3 text-xs text-slate-500 dark:text-slate-400 shadow-xs">
            <div class="flex items-center gap-3">
              <div class="w-8 h-8 rounded-full bg-brand-900 text-white font-bold text-xs flex items-center justify-center shadow">
                M
              </div>
              <div>
                <span class="font-bold text-slate-900 dark:text-white block">mufettis.org</span>
                <div class="flex items-center gap-2 text-[11px]">
                  <time datetime={post.date}>{formattedDate}</time>
                  <span>•</span>
                  <span>⏱️ {post.reading_time} dk okuma</span>
                </div>
              </div>
            </div>

            <!-- Interactive Toolbar (Font Zoom, TTS, Print) -->
            <div class="flex items-center gap-1.5">
              <button id="tts-btn" type="button" title="Yazıyı Sesli Oku" class="px-2.5 py-1.5 rounded-lg border border-slate-200 dark:border-slate-700 hover:bg-slate-100 dark:hover:bg-slate-800 text-slate-700 dark:text-slate-200 transition-colors flex items-center gap-1 font-semibold text-[11px]">
                <span id="tts-icon">🔊</span>
                <span id="tts-text">Sesli Dinle</span>
              </button>
              <button id="font-toggle-btn" type="button" title="Yazı Boyutunu Değiştir" class="px-2 py-1.5 rounded-lg border border-slate-200 dark:border-slate-700 hover:bg-slate-100 dark:hover:bg-slate-800 text-slate-700 dark:text-slate-200 transition-colors font-bold text-[11px]">
                A+
              </button>
              <button id="print-btn" type="button" title="Yazdır veya PDF Kaydet" class="p-1.5 rounded-lg border border-slate-200 dark:border-slate-700 hover:bg-slate-100 dark:hover:bg-slate-800 text-slate-700 dark:text-slate-200 transition-colors text-[11px]">
                🖨️
              </button>
            </div>
          </div>
        </header>

        <!-- FULL-BLEED FEATURED IMAGE BANNER (WordPress Pars Theme Resim Alanı) -->
        {post.featured_image && (
          <div class="mb-8 rounded-2xl overflow-hidden shadow-lg border border-slate-200 dark:border-slate-800 bg-slate-900">
            <img 
              src={post.featured_image} 
              alt={post.title} 
              class="w-full h-auto max-h-[460px] object-cover"
              loading="eager"
            />
          </div>
        )}

        <!-- Excerpt Lead Box -->
        {post.excerpt && (
          <div class="mb-8 p-5 rounded-2xl bg-brand-50/70 dark:bg-brand-950/40 border-l-4 border-brand-600 dark:border-sky-400 text-slate-700 dark:text-slate-200 text-base sm:text-lg leading-relaxed font-medium">
            {post.excerpt}
          </div>
        )}

        <!-- ARTICLE BODY (Rich Content & Questions) -->
        <div id="article-body" class="prose prose-slate dark:prose-invert max-w-none text-base sm:text-[17px] leading-[1.8] text-slate-800 dark:text-slate-200 prose-headings:font-black prose-headings:tracking-tight prose-headings:text-slate-900 dark:prose-headings:text-white prose-h2:text-2xl prose-h2:mt-10 prose-h2:mb-4 prose-h3:text-xl prose-a:text-brand-600 dark:prose-a:text-sky-400 prose-a:font-semibold hover:prose-a:underline prose-img:rounded-2xl prose-img:shadow-md prose-table:border-collapse prose-table:border prose-table:border-slate-300 dark:prose-table:border-slate-700">
          <div set:html={post.content} />
        </div>

        <!-- Social Share Bar -->
        <div class="mt-12 p-6 rounded-2xl bg-white dark:bg-[#0b1726] border border-slate-200 dark:border-slate-800 shadow-sm flex flex-col sm:flex-row items-center justify-between gap-4">
          <div>
            <h4 class="font-bold text-slate-900 dark:text-white text-sm">Bu sınav notunu arkadaşlarınızla paylaşın:</h4>
            <p class="text-xs text-slate-500 dark:text-slate-400 mt-0.5">Sınav gruplarında ve meslektaşlarınızla tek tıkla paylaşabilirsiniz.</p>
          </div>
          <div class="flex items-center gap-2">
            <a 
              href={`https://api.whatsapp.com/send?text=${encodeURIComponent(post.title + ' ' + Astro.url.href)}`} 
              target="_blank" 
              rel="noopener noreferrer"
              class="px-4 py-2 rounded-xl bg-emerald-600 hover:bg-emerald-500 text-white text-xs font-bold flex items-center gap-1.5 transition-colors shadow-sm"
            >
              WhatsApp
            </a>
            <a 
              href={`https://t.me/share/url?url=${encodeURIComponent(Astro.url.href)}&text=${encodeURIComponent(post.title)}`} 
              target="_blank" 
              rel="noopener noreferrer"
              class="px-4 py-2 rounded-xl bg-sky-600 hover:bg-sky-500 text-white text-xs font-bold flex items-center gap-1.5 transition-colors shadow-sm"
            >
              Telegram
            </a>
            <button 
              id="copy-link-btn"
              type="button"
              class="px-4 py-2 rounded-xl bg-slate-100 dark:bg-slate-800 hover:bg-slate-200 text-slate-800 dark:text-slate-200 text-xs font-bold transition-colors border border-slate-200 dark:border-slate-700"
            >
              Bağlantıyı Kopyala
            </button>
          </div>
        </div>

        <!-- Author / Editorial Box -->
        <div class="mt-8 p-6 rounded-2xl bg-slate-100 dark:bg-slate-900/60 border border-slate-200 dark:border-slate-800 flex items-center gap-4">
          <div class="w-14 h-14 rounded-2xl bg-brand-900 text-white font-black text-xl flex items-center justify-center shrink-0 shadow-md">
            M
          </div>
          <div>
            <h4 class="font-bold text-slate-900 dark:text-white text-base">mufettis.org Denetim ve Mevzuat Kurulu</h4>
            <p class="text-xs text-slate-600 dark:text-slate-400 mt-1 leading-relaxed">
              Bu içerik SPK, BDDK ve MASAK mevzuatı ile uluslararası IIA standartları referans alınarak adayların sınav başarısı için hazırlanmıştır.
            </p>
          </div>
        </div>

      </article>

      <!-- Right Column: Sticky Sidebar (4 Cols) -->
      <aside class="lg:col-span-4 space-y-8">
        
        <!-- Çözümlü Deneme Sınavları CTA Kartı -->
        <div class="bg-gradient-to-br from-brand-950 to-brand-900 rounded-2xl p-6 text-white border border-brand-800 shadow-lg">
          <span class="px-2.5 py-1 rounded bg-amber-500 text-slate-950 font-black text-[10px] uppercase tracking-wider inline-block mb-3">
            Sınav Pratiği
          </span>
          <h3 class="text-lg font-black text-white leading-snug">
            Çözümlü Deneme Sınavları ile Kendinizi Test Edin
          </h3>
          <p class="text-slate-300 text-xs mt-2 leading-relaxed">
            Soruları gerçek sınav formatında çözün, anında açıklamalı çözümleri görün.
          </p>
          
          <div class="mt-4 space-y-2.5 pt-4 border-t border-brand-800/80">
            {quizRecommendations.map(q => (
              <a href={q.url} class="block p-2.5 rounded-xl bg-white/10 hover:bg-white/15 transition-colors group">
                <h4 class="font-bold text-xs text-white group-hover:text-amber-300 transition-colors line-clamp-1">
                  {q.title}
                </h4>
                <span class="text-[10px] text-slate-300 mt-1 block">Çözmek için tıkla →</span>
              </a>
            ))}
          </div>

          <a href="/deneme-sinavlari/" class="mt-5 block w-full py-2.5 rounded-xl bg-amber-500 hover:bg-amber-400 text-slate-950 font-black text-xs text-center transition-colors">
            Tüm Deneme Sınavlarını Listele
          </a>
        </div>

        <!-- İlgili Sınav Notları (Görsel Thumbnails) -->
        {relatedPosts.length > 0 && (
          <div class="bg-white dark:bg-[#0b1726] rounded-2xl p-6 border border-slate-200 dark:border-slate-800 shadow-sm">
            <h3 class="text-sm font-black text-slate-900 dark:text-white uppercase tracking-wider mb-4 border-l-2 border-brand-600 pl-2">
              Benzer Sınav Notları
            </h3>
            
            <div class="space-y-4">
              {relatedPosts.map(rel => (
                <a href={rel.url} class="flex items-center gap-3 group">
                  <div class="w-16 h-14 rounded-xl overflow-hidden bg-slate-100 dark:bg-slate-800 shrink-0 border border-slate-200 dark:border-slate-700">
                    <img 
                      src={rel.featured_image} 
                      alt={rel.title} 
                      class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
                      loading="lazy"
                    />
                  </div>
                  <div>
                    <span class="text-[10px] font-semibold text-slate-400 block mb-0.5">⏱️ {rel.reading_time} dk</span>
                    <h4 class="font-bold text-slate-900 dark:text-white text-xs leading-snug group-hover:text-brand-600 dark:group-hover:text-sky-400 transition-colors line-clamp-2">
                      {rel.title}
                    </h4>
                  </div>
                </a>
              ))}
            </div>
          </div>
        )}

        <!-- Hızlı Kategori Listesi -->
        <div class="bg-white dark:bg-[#0b1726] rounded-2xl p-6 border border-slate-200 dark:border-slate-800 shadow-sm">
          <h3 class="text-sm font-black text-slate-900 dark:text-white uppercase tracking-wider mb-4 border-l-2 border-amber-500 pl-2">
            Sınav Branşları
          </h3>
          <ul class="space-y-2 text-xs font-bold text-slate-700 dark:text-slate-300">
            <li><a href="/category/spl-ders-notlari/" class="hover:text-brand-600 dark:hover:text-sky-400 flex items-center justify-between py-1"><span>📈 SPL Lisanslama Notları</span><span>→</span></a></li>
            <li><a href="/category/masak-uyum-gorevlisi-yetkilendirme-ders-notlari/" class="hover:text-brand-600 dark:hover:text-sky-400 flex items-center justify-between py-1"><span>🛡️ MASAK Uyum Görevlisi</span><span>→</span></a></li>
            <li><a href="/category/cia-ders-notlari/" class="hover:text-brand-600 dark:hover:text-sky-400 flex items-center justify-between py-1"><span>🎓 CIA Part 1 Notları</span><span>→</span></a></li>
            <li><a href="/category/banka-denetimi/" class="hover:text-brand-600 dark:hover:text-sky-400 flex items-center justify-between py-1"><span>🏛️ Banka Denetimi & Mevzuat</span><span>→</span></a></li>
            <li><a href="/category/mali-analiz-kutuphanesi/" class="hover:text-brand-600 dark:hover:text-sky-400 flex items-center justify-between py-1"><span>📊 Mali Analiz Kütüphanesi</span><span>→</span></a></li>
          </ul>
        </div>

      </aside>

    </div>

  </div>

  <!-- Interactive JavaScript: Reading Progress, Font Zoom, TTS, Copy -->
  <script>
    // 1. Reading Progress Bar
    window.addEventListener('scroll', () => {
      const winScroll = document.documentElement.scrollTop;
      const height = document.documentElement.scrollHeight - document.documentElement.clientHeight;
      const scrolled = (winScroll / height) * 100;
      const bar = document.getElementById('read-progress');
      if (bar) bar.style.width = scrolled + '%';
    });

    // 2. Font Size Toggle (A+ / A-)
    const fontBtn = document.getElementById('font-toggle-btn');
    const articleBody = document.getElementById('article-body');
    let isLargeFont = false;
    fontBtn?.addEventListener('click', () => {
      isLargeFont = !isLargeFont;
      if (isLargeFont) {
        articleBody?.classList.add('text-xl');
        fontBtn.textContent = 'A-';
      } else {
        articleBody?.classList.remove('text-xl');
        fontBtn.textContent = 'A+';
      }
    });

    // 3. Text-to-Speech (Sesli Dinle)
    const ttsBtn = document.getElementById('tts-btn');
    const ttsIcon = document.getElementById('tts-icon');
    const ttsText = document.getElementById('tts-text');
    let isSpeaking = false;

    ttsBtn?.addEventListener('click', () => {
      if (!('speechSynthesis' in window)) {
        alert('Tarayıcınız sesli okumayı desteklemiyor.');
        return;
      }

      if (isSpeaking) {
        window.speechSynthesis.cancel();
        isSpeaking = false;
        if (ttsIcon) ttsIcon.textContent = '🔊';
        if (ttsText) ttsText.textContent = 'Sesli Dinle';
      } else {
        const textToRead = articleBody?.innerText || '';
        const utterance = new SpeechSynthesisUtterance(textToRead.slice(0, 4000));
        utterance.lang = 'tr-TR';
        utterance.rate = 1.0;

        utterance.onend = () => {
          isSpeaking = false;
          if (ttsIcon) ttsIcon.textContent = '🔊';
          if (ttsText) ttsText.textContent = 'Sesli Dinle';
        };

        window.speechSynthesis.speak(utterance);
        isSpeaking = true;
        if (ttsIcon) ttsIcon.textContent = '⏹️';
        if (ttsText) ttsText.textContent = 'Durdur';
      }
    });

    // 4. Print handler
    document.getElementById('print-btn')?.addEventListener('click', () => {
      window.print();
    });

    // 5. Copy link handler
    const copyBtn = document.getElementById('copy-link-btn');
    copyBtn?.addEventListener('click', () => {
      navigator.clipboard.writeText(window.location.href).then(() => {
        copyBtn.textContent = 'Kopyalandı! ✓';
        setTimeout(() => {
          copyBtn.textContent = 'Bağlantıyı Kopyala';
        }, 2000);
      });
    });
  </script>
</Layout>
