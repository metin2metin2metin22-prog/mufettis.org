---
import Layout from '../layouts/Layout.astro';
import { getAllPosts } from '../utils/posts';
import '../styles/components.css';
import { balanceHtml } from '../utils/balanceHtml';

export async function getStaticPaths() {
  const posts = getAllPosts();
  const paths: any[] = [];
  const seenSlugs = new Set();

  posts
    .filter(post => post.slug !== 'iletisim')
    .forEach(post => {
      // 1. Original slug
      if (!seenSlugs.has(post.slug)) {
        seenSlugs.add(post.slug);
        paths.push({
          params: { slug: post.slug },
          props: { post }
        });
      }

      // 2. Decoded slug (ensures server-decoded URLs like %e2%85%b0 match flawlessly)
      const decodedSlug = decodeURIComponent(post.slug);
      if (decodedSlug !== post.slug && !seenSlugs.has(decodedSlug)) {
        seenSlugs.add(decodedSlug);
        paths.push({
          params: { slug: decodedSlug },
          props: { post }
        });
      }

      // 3. Normalized Roman numeral aliases for CIA Part 1 tests to ensure 100% link reliability
      if (post.slug.includes('%e2%85%b0%e2%85%b0%e2%85%b0')) {
        const aliases = [
          'cia-part-1-deneme-sorulari-20-soru-cozumlu-ve-aciklamali-test-3',
          'cia-part-1-deneme-sorulari-20-soru-cozumlu-ve-aciklamali-test-iii'
        ];
        aliases.forEach(alias => {
          if (!seenSlugs.has(alias)) {
            seenSlugs.add(alias);
            paths.push({
              params: { slug: alias },
              props: { post }
            });
          }
        });
      }
      if (post.slug.includes('%e2%85%b0-blogunu-sec')) {
        const aliases = [
          'cia-part-1-deneme-sorulari-20-soru-cozumlu-ve-aciklamali-test-2',
          'cia-part-1-deneme-sorulari-20-soru-cozumlu-ve-aciklamali-test-ii'
        ];
        aliases.forEach(alias => {
          if (!seenSlugs.has(alias)) {
            seenSlugs.add(alias);
            paths.push({
              params: { slug: alias },
              props: { post }
            });
          }
        });
      }
    });

  return paths;
}

const { post } = Astro.props;
const articleContent = balanceHtml(post.content);
const posts = getAllPosts();

// Related posts & Next/Prev navigation
const primaryCat = post.categories && post.categories[0] ? post.categories[0].slug : null;
const categoryAllPosts = posts.filter(p => primaryCat && p.categories.some(c => c.slug === primaryCat) && p.post_type === 'post');

const currentIndex = categoryAllPosts.findIndex(p => p.slug === post.slug);
const prevPost = currentIndex > 0 ? categoryAllPosts[currentIndex - 1] : null;
const nextPost = currentIndex >= 0 && currentIndex < categoryAllPosts.length - 1 ? categoryAllPosts[currentIndex + 1] : null;

const relatedPosts = posts
  .filter(p => p.slug !== post.slug && primaryCat && p.categories.some(c => c.slug === primaryCat) && p.featured_image)
  .slice(0, 4);

// Quiz recommendations for sidebar
const quizRecommendations = posts.filter(p => p.is_quiz && p.slug !== post.slug).slice(0, 4);

// Format date in Turkish
const formattedDate = new Date(post.date).toLocaleDateString('tr-TR', {
  year: 'numeric',
  month: 'long',
  day: 'numeric'
});

// Category Color Coding & Theming
const getCategoryTheme = (catSlug = '') => {
  if (catSlug.includes('spl')) {
    return { 
      badge: 'bg-sky-50 dark:bg-sky-950/80 text-sky-700 dark:text-sky-300 border-sky-300 dark:border-sky-800', 
      bar: 'bg-sky-500',
      text: 'text-sky-600 dark:text-sky-400',
      tag: 'SPL Lisanslama Müfredatı'
    };
  }
  if (catSlug.includes('masak')) {
    return { 
      badge: 'bg-emerald-50 dark:bg-emerald-950/80 text-emerald-700 dark:text-emerald-300 border-emerald-300 dark:border-emerald-800', 
      bar: 'bg-emerald-500',
      text: 'text-emerald-600 dark:text-emerald-400',
      tag: 'MASAK Uyum Görevlisi'
    };
  }
  if (catSlug.includes('cia')) {
    return { 
      badge: 'bg-purple-50 dark:bg-purple-950/80 text-purple-700 dark:text-purple-300 border-purple-300 dark:border-purple-800', 
      bar: 'bg-purple-500',
      text: 'text-purple-600 dark:text-purple-400',
      tag: 'CIA Part 1 Sertifikasyon'
    };
  }
  if (catSlug.includes('banka') || catSlug.includes('kariyer')) {
    return { 
      badge: 'bg-amber-50 dark:bg-amber-950/80 text-amber-800 dark:text-amber-300 border-amber-300 dark:border-amber-800', 
      bar: 'bg-amber-500',
      text: 'text-amber-600 dark:text-amber-400',
      tag: 'Banka Denetimi & Teftiş'
    };
  }
  return { 
    badge: 'bg-teal-50 dark:bg-teal-950/80 text-teal-800 dark:text-teal-300 border-teal-300 dark:border-teal-800', 
    bar: 'bg-brand-600',
    text: 'text-teal-600 dark:text-teal-400',
    tag: 'Mali Analiz & Mevzuat'
  };
};

const catStyle = getCategoryTheme(primaryCat || '');

// JSON-LD Schema
const schemaArticle = {
  "@context": "https://schema.org",
  "@type": post.is_quiz ? "Quiz" : "Article",
  "headline": post.title,
  "description": post.seo.description || post.excerpt,
  "image": post.featured_image ? `https://mufettis.org${post.featured_image}` : undefined,
  "datePublished": post.date,
  "dateModified": post.date,
  "mainEntityOfPage": {
    "@type": "WebPage",
    "@id": `https://mufettis.org/${post.slug}/`
  },
  "author": {
    "@type": "Organization",
    "name": "mufettis.org",
    "url": "https://mufettis.org"
  },
  "publisher": {
    "@type": "Organization",
    "name": "mufettis.org",
    "logo": {
      "@type": "ImageObject",
      "url": "https://mufettis.org/wp-content/uploads/2026/04/cropped-mufettis.org-favicon-1-180x180.png"
    }
  }
};
---

<Layout 
  title={post.seo.title || post.title}
  description={post.seo.description || post.excerpt}
  image={post.featured_image || "/wp-content/uploads/2026/04/mufettis.org_-scaled.png"}
  type="article"
  publishDate={post.date}
  canonical={`https://mufettis.org/${post.slug}/`}
>
  <script type="application/ld+json" set:html={JSON.stringify(schemaArticle)} />

  <!-- Reading Progress Bar at the top -->
  <div id="read-progress" class="fixed top-0 left-0 h-1.5 bg-gradient-to-r from-amber-400 via-sky-400 to-emerald-400 z-50 transition-all duration-75 w-0 shadow-sm"></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-8 pb-28">
    
    <!-- Top Breadcrumbs -->
    <nav class="flex items-center gap-2 text-xs text-slate-500 dark:text-slate-400 mb-6 overflow-x-auto whitespace-nowrap pb-1">
      <a href="/" class="hover:text-brand-600 dark:hover:text-sky-400 transition-colors font-medium">Anasayfa</a>
      <span>/</span>
      {post.categories && post.categories[0] ? (
        <>
          <a href={`/category/${post.categories[0].slug}/`} class="hover:text-brand-600 dark:hover:text-sky-400 transition-colors font-medium">
            {post.categories[0].name}
          </a>
          <span>/</span>
        </>
      ) : (
        <>
          <span>Sayfa</span>
          <span>/</span>
        </>
      )}
      <span class="text-slate-800 dark:text-slate-200 font-bold truncate max-w-sm">{post.title}</span>
    </nav>

    <!-- 2-Column Editorial Grid -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-10">
      
      <!-- Main Content (8 Cols) -->
      


<article class="lg:col-span-8 min-w-0">
        
        <!-- Post Header -->
        <header class="mb-7">
          <div class="flex flex-wrap items-center gap-2.5 mb-3.5">
            {post.categories && post.categories.map(c => (
              <a href={`/category/${c.slug}/`} class={`text-[11px] font-black uppercase tracking-wider px-3.5 py-1 rounded-full border ${catStyle.badge} transition-all hover:scale-105 shadow-xs`}>
                {c.name}
              </a>
            ))}
            {post.is_quiz ? (
              <span class="text-[11px] font-black uppercase tracking-wider px-3.5 py-1 rounded-full bg-gradient-to-r from-amber-400 to-amber-500 text-slate-950 shadow-md flex items-center gap-1.5 animate-pulse-subtle">
                <svg class="w-3.5 h-3.5 fill-current" viewBox="0 0 24 24"><path d="M13 10V3L4 14h7v7l9-11h-7z"/></svg>
                <span>Çözümlü İnteraktif Sınav</span>
              </span>
            ) : (
              <span class="inline-flex items-center gap-1.5 text-[11px] font-bold text-slate-500 dark:text-slate-400 bg-slate-100 dark:bg-slate-800 px-3 py-1 rounded-full border border-slate-200 dark:border-slate-700">
                <svg class="w-3.5 h-3.5 text-slate-500 dark:text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"/></svg>
                <span>Konu Anlatımı & Mevzuat</span>
              </span>
            )}
          </div>

          <h1 class="text-2xl sm:text-4xl md:text-[38px] font-black text-slate-900 dark:text-white tracking-tight leading-tight mb-5">
            {post.title}
          </h1>

          <!-- Toolbar (Author, Reading Time, TTS, Font Size, Print) -->
          <div class="py-3 px-4.5 rounded-2xl bg-white dark:bg-[#0c1827] border-2 border-slate-200/90 dark:border-slate-800 flex flex-wrap items-center justify-between gap-3 text-xs text-slate-500 dark:text-slate-400 shadow-sm">
            <div class="flex items-center gap-3">
              <div class="w-9 h-9 rounded-xl bg-gradient-to-br from-brand-900 to-brand-800 p-1 flex items-center justify-center shadow-md shrink-0">
                <img src="/brand/mufettis-emblem-dark.png" class="w-7 h-auto object-contain" alt="Müfettiş Amblemi" />
              </div>
              <div>
                <span class="font-bold text-slate-900 dark:text-white block text-[13px]">mufettis.org Denetim Kurulu</span>
                <div class="flex items-center gap-2 text-[11px]">
                  <time datetime={post.date}>{formattedDate}</time>
                  <span>•</span>
                  <span class="inline-flex items-center gap-1">
                    <svg class="w-3 h-3 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                    <span>{post.reading_time} dk okuma ({post.word_count} kelime)</span>
                  </span>
                </div>
              </div>
            </div>

            <!-- Toolbar Actions -->
            <div class="flex items-center gap-2">
              
              <!-- Text-to-speech with speed control -->
              <div class="flex items-center rounded-xl border border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-slate-900/60 p-0.5">
                <button id="tts-btn" type="button" title="Yazıyı Sesli Oku" class="px-3 py-1.5 rounded-lg hover:bg-white dark:hover:bg-slate-800 text-slate-700 dark:text-slate-200 transition-colors flex items-center gap-1.5 font-bold text-xs cursor-pointer">
                  <span id="tts-icon" class="inline-flex items-center">
                    <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.536 8.464a5 5 0 010 7.072m2.828-9.9a9 9 0 010 12.728M5.586 15H4a1 1 0 01-1-1v-4a1 1 0 011-1h1.586l4.707-4.707C10.923 3.663 12 4.109 12 5v14c0 .891-1.077 1.337-1.707.707L5.586 15z"/></svg>
                  </span>
                  <span id="tts-text">Sesli Dinle</span>
                </button>
                <button id="tts-speed-btn" type="button" title="Okuma Hızı" class="px-2 py-1.5 text-[11px] font-black text-brand-600 dark:text-sky-400 hover:bg-white dark:hover:bg-slate-800 rounded-lg cursor-pointer">
                  1.0x
                </button>
              </div>

              <!-- Font Size Toggle -->
              <button id="font-toggle-btn" type="button" title="Yazı Boyutunu Değiştir" class="px-2.5 py-1.5 rounded-xl border border-slate-200 dark:border-slate-700 hover:bg-slate-100 dark:hover:bg-slate-800 text-slate-700 dark:text-slate-200 transition-colors font-black text-xs cursor-pointer active:scale-95">
                A+
              </button>

              <!-- Print (Hidden on small mobile screens to keep toolbar one-line) -->
              <button id="print-btn" type="button" title="Yazdır veya PDF Kaydet" class="hidden sm:inline-flex p-1.5 rounded-xl border border-slate-200 dark:border-slate-700 hover:bg-slate-100 dark:hover:bg-slate-800 text-slate-700 dark:text-slate-200 transition-colors text-xs cursor-pointer active:scale-95">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 17h2a2 2 0 002-2v-4a2 2 0 00-2-2H5a2 2 0 00-2 2v4a2 2 0 002 2h2m2 4h6a2 2 0 002-2v-4a2 2 0 00-2-2H9a2 2 0 00-2 2v4a2 2 0 002 2zm8-12V5a2 2 0 00-2-2H9a2 2 0 00-2 2v4h10z"/></svg>
              </button>
            </div>
          </div>
        </header>

        <!-- Full-Bleed Featured Cover Image -->
        {post.featured_image && (
          <div class="mb-8 rounded-3xl overflow-hidden shadow-2xl border-2 border-slate-200 dark:border-slate-800 bg-slate-950">
            <img 
              src={post.featured_image} 
              alt={post.title} 
              class="w-full h-auto max-h-[480px] object-cover"
              loading="eager"
              fetchpriority="high"
              decoding="async"
              width="1200"
              height="630"
            />
          </div>
        )}

        <!-- Excerpt / Summary Lead Box -->
        {post.excerpt && (
          <div class="mb-8 p-6 rounded-3xl bg-gradient-to-r from-brand-50/70 to-slate-50 dark:from-[#0c1c2e] dark:to-[#091524] border-l-4 border-brand-600 dark:border-sky-400 text-slate-800 dark:text-slate-200 text-base sm:text-lg leading-relaxed font-medium shadow-sm">
            <div class="text-xs font-black uppercase tracking-wider text-brand-700 dark:text-sky-400 mb-2 flex items-center gap-2">
              <svg class="w-4 h-4 text-brand-600 dark:text-sky-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
              <span>Özet & Kritik Odak Noktası:</span>
            </div>
            {post.excerpt}
          </div>
        )}

        <!-- ARTICLE BODY & QUESTIONS -->
        <div 
          id="article-body" 
          class="prose prose-slate dark:prose-invert max-w-none text-base sm:text-[17px] leading-[1.85] text-slate-800 dark:text-slate-200 prose-headings:font-black prose-headings:tracking-tight prose-headings:text-slate-900 dark:prose-headings:text-white prose-h2:text-2xl sm:prose-h2:text-3xl prose-h2:mt-12 prose-h2:mb-5 prose-h3:text-xl prose-a:text-brand-600 dark:prose-a:text-sky-400 prose-a:font-bold hover:prose-a:underline prose-img:rounded-3xl prose-img:shadow-lg prose-table:border-collapse prose-table:border prose-table:border-slate-300 dark:prose-table:border-slate-700 prose-th:bg-slate-100 dark:prose-th:bg-slate-800 prose-th:p-3 prose-td:p-3"
        >
          <div set:html={articleContent} />
        </div>

        <!-- EXAM KARNE / SCORE SUMMARY CARD (Only shows if questions exist) -->
        <div id="exam-score-card" class="hidden mt-12 p-6 sm:p-8 rounded-3xl bg-gradient-to-br from-[#07192a] via-[#0b2b46] to-[#061727] text-white border-2 border-brand-800 shadow-2xl">
          <div class="flex items-center justify-between pb-6 border-b border-brand-800/80 mb-6">
            <div>
              <span class="inline-flex items-center gap-1.5 text-xs font-black uppercase tracking-wider text-amber-400 bg-amber-950/60 px-3 py-1 rounded-full border border-amber-800/60 mb-2">
                <svg class="w-3.5 h-3.5 text-amber-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"/></svg>
                <span>Sınav Karnesi & Performans Raporu</span>
              </span>
              <h3 class="text-2xl sm:text-3xl font-black text-white">Deneme Sınavı Tamamlandı!</h3>
            </div>
            <div class="text-right">
              <span id="score-percent" class="text-3xl sm:text-4xl font-black text-amber-400">%0</span>
              <span class="text-xs text-slate-300 block font-semibold">Başarı Oranı</span>
            </div>
          </div>

          <div class="grid grid-cols-2 sm:grid-cols-4 gap-4 mb-6">
            <div class="p-4 rounded-2xl bg-white/5 border border-white/10 text-center">
              <span class="text-xs text-slate-300 block mb-1">Toplam Soru</span>
              <span id="stat-total" class="text-2xl font-black text-white">0</span>
            </div>
            <div class="p-4 rounded-2xl bg-emerald-500/10 border border-emerald-500/20 text-center">
              <span class="text-xs text-emerald-300 block mb-1">Doğru Sayısı</span>
              <span id="stat-correct" class="text-2xl font-black text-emerald-400">0</span>
            </div>
            <div class="p-4 rounded-2xl bg-rose-500/10 border border-rose-500/20 text-center">
              <span class="text-xs text-rose-300 block mb-1">Yanlış Sayısı</span>
              <span id="stat-wrong" class="text-2xl font-black text-rose-400">0</span>
            </div>
            <div class="p-4 rounded-2xl bg-amber-500/10 border border-amber-500/20 text-center">
              <span class="text-xs text-amber-300 block mb-1">Boş / Kalan</span>
              <span id="stat-empty" class="text-2xl font-black text-amber-400">0</span>
            </div>
          </div>

          <p id="score-evaluation" class="text-sm text-slate-300 leading-relaxed p-4 rounded-2xl bg-black/40 border border-white/5 mb-6"></p>

          <div class="flex flex-wrap items-center justify-between gap-4">
            <button id="reset-all-quiz-btn" type="button" class="px-5 py-3 rounded-xl bg-white/10 hover:bg-white/20 text-white font-bold text-xs transition-colors flex items-center gap-1.5 cursor-pointer">
              <span>↺</span> Tüm Soruları Sıfırla ve Baştan Çöz
            </button>
            <a href="/deneme-sinavlari/" class="px-6 py-3 rounded-xl bg-amber-500 hover:bg-amber-400 text-slate-950 font-black text-xs transition-colors">
              Diğer Deneme Sınavlarını Gör →
            </a>
          </div>
        </div>

        <!-- Next / Previous Lesson Navigation -->
        {(prevPost || nextPost) && (
          <div class="mt-14 pt-8 border-t-2 border-slate-200 dark:border-slate-800 grid grid-cols-1 sm:grid-cols-2 gap-4">
            {prevPost ? (
              <a href={prevPost.url} class="group p-5 rounded-2xl bg-white dark:bg-[#0c1827] border-2 border-slate-200 dark:border-slate-800 hover:border-brand-500 dark:hover:border-sky-500 shadow-sm transition-all flex flex-col justify-between">
                <div>
                  <span class="text-[10px] font-black uppercase tracking-wider text-slate-400 flex items-center gap-1 mb-1">
                    <span>←</span> Önceki Konu
                  </span>
                  <h4 class="font-bold text-sm text-slate-900 dark:text-white group-hover:text-brand-600 dark:group-hover:text-sky-400 transition-colors line-clamp-2">
                    {prevPost.title}
                  </h4>
                </div>
                <span class="text-xs font-semibold text-slate-400 mt-3 flex items-center gap-1.5">
                  <svg class="w-3.5 h-3.5 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><circle cx="12" cy="12" r="10" stroke-width="2"></circle><polyline points="12 6 12 12 16 14" stroke-width="2"></polyline></svg>
                  {prevPost.reading_time} dk
                </span>
              </a>
            ) : <div></div>}

            {nextPost && (
              <a href={nextPost.url} class="group p-5 rounded-2xl bg-white dark:bg-[#0c1827] border-2 border-slate-200 dark:border-slate-800 hover:border-brand-500 dark:hover:border-sky-500 shadow-sm transition-all flex flex-col justify-between sm:text-right">
                <div>
                  <span class="text-[10px] font-black uppercase tracking-wider text-slate-400 flex items-center gap-1 sm:justify-end mb-1">
                    Sonraki Konu <span>→</span>
                  </span>
                  <h4 class="font-bold text-sm text-slate-900 dark:text-white group-hover:text-brand-600 dark:group-hover:text-sky-400 transition-colors line-clamp-2">
                    {nextPost.title}
                  </h4>
                </div>
                <span class="text-xs font-semibold text-slate-400 mt-3 flex items-center gap-1.5 sm:justify-end">
                  <svg class="w-3.5 h-3.5 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><circle cx="12" cy="12" r="10" stroke-width="2"></circle><polyline points="12 6 12 12 16 14" stroke-width="2"></polyline></svg>
                  {nextPost.reading_time} dk
                </span>
              </a>
            )}
          </div>
        )}

        <!-- Social Share & Study Group Bar -->
        <div class="mt-12 p-6 sm:p-7 rounded-3xl bg-white dark:bg-[#0c1827] border-2 border-slate-200 dark:border-slate-800 shadow-sm flex flex-col sm:flex-row items-center justify-between gap-5">
          <div class="space-y-1 text-center sm:text-left">
            <div class="inline-flex items-center gap-1.5 text-xs font-black uppercase tracking-wider text-brand-600 dark:text-sky-400">
