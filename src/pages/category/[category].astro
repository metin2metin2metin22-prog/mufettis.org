---
import Layout from '../../layouts/Layout.astro';
import posts from '../../data/posts.json';
import categories from '../../data/categories.json';

export async function getStaticPaths() {
  return categories.map(cat => ({
    params: { category: cat.slug },
    props: { 
      category: cat,
      categoryPosts: posts.filter(p => p.categories && p.categories.some(c => c.slug === cat.slug))
    }
  }));
}

const { category, categoryPosts } = Astro.props;
---

<Layout 
  title={`${category.name} Ders Notları ve Çözümlü Sınavlar`}
  description={`${category.name} alanında kapsamlı sınav hazırlık notları, mevzuat özetleri ve çözümlü deneme soruları.`}
  canonical={`https://mufettis.org/category/${category.slug}/`}
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-12 pb-24">
    
    <!-- Category Header -->
    <header class="border-b border-slate-200 dark:border-slate-800 pb-8 mb-10">
      <div class="flex items-center gap-2 text-xs text-slate-500 dark:text-slate-400 mb-3">
        <a href="/" class="hover:text-brand-600 dark:hover:text-brand-400">Anasayfa</a>
        <span>/</span>
        <span>Kategori</span>
        <span>/</span>
        <span class="text-slate-800 dark:text-slate-200 font-semibold">{category.name}</span>
      </div>

      <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4">
        <div>
          <h1 class="text-3xl sm:text-4xl font-extrabold text-slate-900 dark:text-white tracking-tight">
            {category.name}
          </h1>
          <p class="text-slate-600 dark:text-slate-400 text-sm sm:text-base mt-2">
            Bu kategoride toplam <strong class="text-brand-600 dark:text-brand-400">{categoryPosts.length}</strong> adet ders notu ve deneme sınavı bulunmaktadır.
          </p>
        </div>

        <a href="/deneme-sinavlari/" class="px-4 py-2.5 rounded-xl bg-amber-500 hover:bg-amber-400 text-slate-950 font-bold text-xs shadow-sm flex items-center gap-2">
          <span>⚡ Çözümlü Testler</span>
        </a>
      </div>
    </header>

    <!-- Articles Grid -->
    {categoryPosts.length > 0 ? (
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {categoryPosts.map(post => (
          <a href={post.url} class="bg-white dark:bg-slate-900 rounded-2xl border border-slate-200 dark:border-slate-800 p-6 shadow-sm hover:shadow-lg transition-all duration-200 flex flex-col justify-between group">
            <div>
              <div class="flex items-center justify-between text-xs text-slate-400 mb-3">
                {post.is_quiz ? (
                  <span class="font-bold text-amber-600 dark:text-amber-400">⚡ Çözümlü Test</span>
                ) : (
                  <span class="font-semibold text-brand-600 dark:text-brand-400">Ders Notu</span>
                )}
                <span>⏱️ {post.reading_time} dk</span>
              </div>

              <h2 class="font-bold text-slate-900 dark:text-white text-lg group-hover:text-brand-600 dark:group-hover:text-brand-400 transition-colors leading-snug mb-3">
                {post.title}
              </h2>

              <p class="text-slate-600 dark:text-slate-400 text-sm leading-relaxed line-clamp-3">
                {post.excerpt}
              </p>
            </div>

            <div class="pt-5 mt-5 border-t border-slate-100 dark:border-slate-800 text-xs font-semibold text-slate-500 group-hover:text-brand-600 dark:group-hover:text-brand-400 flex items-center justify-between">
              <span>{post.is_quiz ? 'Soruları Çöz' : 'Notu Oku'}</span>
              <span>→</span>
            </div>
          </a>
        ))}
      </div>
    ) : (
      <div class="text-center py-20 bg-white dark:bg-slate-900 rounded-2xl border border-slate-200 dark:border-slate-800 p-8">
        <p class="text-slate-500 dark:text-slate-400">Bu kategoride henüz yayınlanmış yazı bulunmuyor.</p>
        <a href="/" class="mt-4 inline-block text-sm font-semibold text-brand-600 hover:underline">Anasayfaya Dön →</a>
      </div>
    )}

  </div>
</Layout>
