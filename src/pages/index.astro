                <svg class="w-3.5 h-3.5 text-slate-300" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                <span>{leadStory.reading_time} dk okuma</span>
              </span>
            </div>
          </div>
          
          <!-- Editoryal Metin Bloğu -->
          <div class="p-5 sm:p-7 flex flex-col justify-between flex-grow">
            <div>
              <div class="flex items-center gap-2 mb-3">
                <span class="inline-flex items-center gap-1 text-[11px] text-emerald-600 dark:text-emerald-400 font-bold bg-emerald-50 dark:bg-emerald-950/60 px-2.5 py-0.5 rounded-full border border-emerald-200 dark:border-emerald-800/60">
                  <svg class="w-3 h-3 text-emerald-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"/></svg>
                  <span>2026 Resmî Veriler</span>
                </span>
                <span class="text-xs text-slate-300 dark:text-slate-600">•</span>
                <span class="text-xs text-slate-500 dark:text-slate-400 font-medium">Banka Teftiş Kurulu Dosyası</span>
              </div>
              
              <h3 class="text-xl sm:text-2xl lg:text-[26px] font-black text-slate-900 dark:text-white leading-tight group-hover:text-amber-500 dark:group-hover:text-amber-400 transition-colors">
                {leadStory.title}
              </h3>
              
              <p class="text-slate-600 dark:text-slate-300 text-xs sm:text-sm mt-3 line-clamp-3 leading-relaxed font-normal">
                {leadStory.excerpt}
              </p>
            </div>

            <div class="mt-6 pt-4 border-t border-slate-100 dark:border-slate-800 flex items-center justify-between">
              <span class="text-xs sm:text-sm font-bold text-brand-600 dark:text-sky-400 flex items-center gap-1 group-hover:gap-2 transition-all">
                <span>Kapsamlı Raporu İncele</span>
                <span>→</span>
              </span>
              <span class="text-[11px] text-slate-400 dark:text-slate-500 font-medium">mufettis.org Özel Analiz</span>
            </div>
          </div>
        </a>
      </div>

      <!-- Yan Manşetler (4 Kart - 5 Kolon - 2x2 Grid) -->
      <div class="lg:col-span-5 grid grid-cols-1 sm:grid-cols-2 gap-4">
        {subManset.map((sub) => {
          const cat = sub.categories && sub.categories[0] ? sub.categories[0].name : 'Ders Notu';
          return (
            <a href={sub.url} class="group flex flex-col justify-between rounded-3xl overflow-hidden shadow-sm hover:shadow-xl bg-white dark:bg-[#0c1827] border-2 border-slate-200 dark:border-slate-800 hover:border-amber-500/80 dark:hover:border-amber-400/80 transition-all duration-300">
              
              <!-- Temiz Görsel Çerçevesi -->
              <div class="relative aspect-[16/10] w-full overflow-hidden bg-slate-950 border-b border-slate-100 dark:border-slate-800">
                <img 
                  src={getWebp(sub.featured_image)} 
                  alt={sub.title} 
                  class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                  loading="lazy"
                  decoding="async"
                  width="600"
                  height="375"
                />
                <div class="absolute top-2 left-2">
                  <span class="inline-block text-[9.5px] font-black text-amber-300 bg-slate-950/80 backdrop-blur-md uppercase tracking-wider px-2 py-0.5 rounded-md border border-amber-500/30">
