---
import Layout from '../layouts/Layout.astro';
import { getAllPosts } from '../utils/posts';
import fs from 'node:fs';
import path from 'node:path';

function getWebp(url?: string): string {
  if (!url) return '';
  const webp = url.replace(/\.(png|jpe?g)$/i, '.webp');
  const disk = path.join(process.cwd(), 'public', webp.replace(/^\//, ''));
  return fs.existsSync(disk) ? webp : url;
}

const posts = getAllPosts();

// Filter actual blog articles with cover images
const blogPosts = posts.filter(p => p.post_type === 'post' && p.featured_image);

// 1. Manşet (Lead Story + 4 Sub-Lead Deep Dives)
const leadStory = blogPosts.find(p => p.slug.includes('2026-banka-mufettisi-maaslari')) || blogPosts[0];
const leadImageWebp = getWebp(leadStory.featured_image);

// Carefully select 4 diverse sub-stories covering SPL, MASAK, CIA, and Mali Analiz
const splStory = blogPosts.find(p => p.slug !== leadStory.slug && p.categories?.some(c => c.slug.includes('spl')));
const masakStory = blogPosts.find(p => p.slug !== leadStory.slug && p.categories?.some(c => c.slug.includes('masak')));
const ciaStory = blogPosts.find(p => p.slug !== leadStory.slug && p.categories?.some(c => c.slug.includes('cia')));
const financialStory = blogPosts.find(p => p.slug !== leadStory.slug && (p.slug.includes('cek-riski') || p.categories?.some(c => c.slug.includes('mali'))));

const subManset = [
  splStory || blogPosts[1],
  masakStory || blogPosts[2],
  ciaStory || blogPosts[3],
  financialStory || blogPosts[4]
].filter((item, index, self) => item && self.findIndex(t => t.slug === item.slug) === index);

// 2. Interactive Quizzes & Exams (12 sets)
const quizList = blogPosts.filter(p => p.is_quiz);

// 3. Category Specific Curated Sets
const splPosts = blogPosts.filter(p => p.categories && p.categories.some(c => c.slug.includes('spl')));
const masakPosts = blogPosts.filter(p => p.categories && p.categories.some(c => c.slug.includes('masak')));
const ciaPosts = blogPosts.filter(p => p.categories && p.categories.some(c => c.slug.includes('cia')));
const bankaPosts = blogPosts.filter(p => p.categories && p.categories.some(c => c.slug.includes('banka') || c.slug.includes('kariyer') || c.slug.includes('denetim')));

// 4. Latest Articles
const latestNews = blogPosts.filter(p => !p.is_quiz && p.slug !== leadStory.slug).slice(0, 8);
---

<Layout 
  title="Müfettiş | Sınav Hazırlık Notları, Makaleler ve Çözümlü Deneme Sınavları"
  description="Banka Müfettişliği, SPL Lisanslama, MASAK Uyum Görevlisi ve CIA sınavlarına hazırlık için kapsamlı ders notları, mevzuat özetleri ve çözümlü testler."
  preloadImage={leadImageWebp}
>

  <!-- ======================================================== -->
  <!-- 1. RESMÎ MEVZUAT VE DENETİM PORTALI BAŞLIĞI & ARAMA       -->
  <!-- ======================================================== -->
  <section class="relative overflow-hidden pt-6 sm:pt-10 pb-8 sm:pb-12 border-b border-slate-200/90 dark:border-slate-800/90 bg-slate-50/60 dark:bg-[#071322] transition-colors">
