      <!-- Resmî Portal Başlığı & Açıklama (Ortalanmış ve Genişletilmiş) -->
      <div class="max-w-5xl mx-auto text-center">
        <h1 class="text-2xl sm:text-4xl lg:text-[44px] font-extrabold text-slate-900 dark:text-white tracking-tight leading-tight">
          Banka Müfettişliği, SPL ve MASAK <br class="hidden sm:inline" /> Mevzuat Kütüphanesi
