        <a href="/category/kariyer-meslek-rehberi/" class="px-3 py-1.5 rounded-xl bg-white dark:bg-slate-800 hover:bg-slate-100 dark:hover:bg-slate-700 text-slate-700 dark:text-slate-200 border border-slate-200 dark:border-slate-700 text-xs font-semibold shadow-2xs hover:border-brand-500 dark:hover:border-sky-500 transition-all">
          Banka Müfettişliği Rehberi
        </a>
        <a href="/deneme-sinavlari/" class="px-3 py-1.5 rounded-xl bg-white dark:bg-slate-800 hover:bg-slate-100 dark:hover:bg-slate-700 text-slate-700 dark:text-slate-200 border border-slate-200 dark:border-slate-700 text-xs font-semibold shadow-2xs hover:border-brand-500 dark:hover:border-sky-500 transition-all">
