                  <span class="text-[11px] font-bold text-brand-600 dark:text-sky-400 group-hover:text-amber-500 dark:group-hover:text-amber-400 transition-colors flex items-center gap-0.5">
                    İncele →
                  </span>
                  <span class="text-[9.5px] text-slate-400 dark:text-slate-500 font-bold">2026</span>
                </div>
              </div>
            </a>
          );
        })}
