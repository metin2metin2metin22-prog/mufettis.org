---
import Layout from '../layouts/Layout.astro';
import posts from '../data/posts.json';
import categories from '../data/categories.json';

// Filter actual blog articles (ignore standalone utility pages)
const blogPosts = posts.filter(p => p.post_type === 'post' && p.featured_image);

// 1. Manşet (5 Lead Stories with Cover Images)
const leadStory = blogPosts.find(p => p.slug.includes('2026-banka-mufettisi-maaslari')) || blogPosts[0];
const subManset = blogPosts
  .filter(p => p.slug !== leadStory.slug)
  .slice(0, 4);

// 2. Interactive Quizzes
const quizList = blogPosts.filter(p => p.is_quiz).slice(0, 6);

// 3. Category Modules
const splPosts = blogPosts.filter(p => p.categories && p.categories.some(c => c.slug.includes('spl'))).slice(0, 4);
const masakPosts = blogPosts.filter(p => p.categories && p.categories.some(c => c.slug.includes('masak'))).slice(0, 4);
const ciaPosts = blogPosts.filter(p => p.categories && p.categories.some(c => c.slug.includes('cia') || c.slug.includes('denetim'))).slice(0, 4);

// 4. Latest Articles
const latestNews = blogPosts.slice(5, 14);
---

<Layout 
  title="Müfettiş | Sınav Hazırlık Notları, Makaleler ve Çözümlü Deneme Sınavları"
  description="Banka Müfettişliği, SPL Lisanslama, MASAK Uyum Görevlisi ve CIA sınavlarına hazırlık için kapsamlı ders notları, mevzuat özetleri ve çözümlü testler."
>
  
  <!-- MANŞET BÖLÜMÜ (Pars Theme Style 5'li Manşet Bloğu) -->
  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-6 pb-4">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-4">
      
      <!-- Ana Manşet (Lead Story - 7 Kolon) -->
      <div class="lg:col-span-7">
        <a href={leadStory.url} class="group relative block aspect-[16/10] sm:aspect-[16/9] lg:aspect-auto lg:h-[480px] rounded-2xl overflow-hidden shadow-md bg-slate-900 border border-slate-200 dark:border-slate-800">
          <img 
            src={leadStory.featured_image} 
            alt={leadStory.title} 
            class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500 opacity-90"
            loading="eager"
          />
          <div class="absolute inset-0 bg-gradient-to-t from-slate-950 via-slate-950/60 to-transparent"></div>
          
          <div class="absolute bottom-0 inset-x-0 p-6 sm:p-8 flex flex-col justify-end">
            <div class="flex items-center gap-2 mb-3">
              <span class="px-3 py-1 rounded-full bg-amber-500 text-slate-950 text-xs font-black uppercase tracking-wider shadow">
                Öne Çıkan Rehber
              </span>
              <span class="text-xs text-slate-300 font-medium bg-black/40 backdrop-blur-sm px-2.5 py-1 rounded-full">
                ⏱️ {leadStory.reading_time} dk okuma
              </span>
            </div>
            
            <h2 class="text-xl sm:text-3xl font-black text-white leading-tight group-hover:text-amber-300 transition-colors drop-shadow-sm">
              {leadStory.title}
            </h2>
            
            <p class="text-slate-300 text-xs sm:text-sm mt-3 line-clamp-2 leading-relaxed hidden sm:block">
              {leadStory.excerpt}
            </p>
          </div>
        </a>
      </div>

      <!-- Yan Manşetler (4 Kart - 5 Kolon) -->
      <div class="lg:col-span-5 grid grid-cols-1 sm:grid-cols-2 gap-4">
        {subManset.map((sub, idx) => (
          <a href={sub.url} class="group relative aspect-[16/10] sm:aspect-auto lg:h-[232px] rounded-2xl overflow-hidden shadow-sm bg-slate-900 border border-slate-200 dark:border-slate-800">
            <img 
              src={sub.featured_image} 
              alt={sub.title} 
              class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500 opacity-90"
              loading="lazy"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-slate-950 via-slate-950/50 to-transparent"></div>
            
            <div class="absolute bottom-0 inset-x-0 p-4 flex flex-col justify-end">
              <span class="inline-block text-[10px] font-bold text-amber-400 uppercase tracking-wider mb-1">
                {sub.categories && sub.categories[0] ? sub.categories[0].name : 'Ders Notu'}
              </span>
              <h3 class="text-xs sm:text-sm font-bold text-white leading-snug group-hover:text-amber-300 transition-colors line-clamp-2">
                {sub.title}
              </h3>
            </div>
          </a>
        ))}
      </div>

    </div>
  </section>

  <!-- HIZLI BRANŞ ÇUBUĞU (Kategori Hapları) -->
  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-4">
    <div class="bg-white dark:bg-[#0b1726] rounded-2xl p-4 border border-slate-200 dark:border-slate-800 shadow-sm flex items-center justify-between gap-4 overflow-x-auto whitespace-nowrap scrollbar-none">
      <div class="flex items-center gap-2">
        <span class="text-xs font-bold text-slate-500 dark:text-slate-400 uppercase tracking-wider pl-1">Branşlar:</span>
        <a href="/category/spl-ders-notlari/" class="px-3.5 py-1.5 rounded-xl bg-slate-100 dark:bg-slate-800 text-slate-800 dark:text-slate-200 hover:bg-brand-600 hover:text-white dark:hover:bg-brand-600 text-xs font-bold transition-colors flex items-center gap-1.5">
          <span>📈 SPL Lisanslama</span>
        </a>
        <a href="/category/masak-uyum-gorevlisi-yetkilendirme-ders-notlari/" class="px-3.5 py-1.5 rounded-xl bg-slate-100 dark:bg-slate-800 text-slate-800 dark:text-slate-200 hover:bg-brand-600 hover:text-white dark:hover:bg-brand-600 text-xs font-bold transition-colors flex items-center gap-1.5">
          <span>🛡️ MASAK Uyum</span>
        </a>
        <a href="/category/cia-ders-notlari/" class="px-3.5 py-1.5 rounded-xl bg-slate-100 dark:bg-slate-800 text-slate-800 dark:text-slate-200 hover:bg-brand-600 hover:text-white dark:hover:bg-brand-600 text-xs font-bold transition-colors flex items-center gap-1.5">
          <span>🎓 CIA Part 1</span>
        </a>
        <a href="/category/banka-denetimi/" class="px-3.5 py-1.5 rounded-xl bg-slate-100 dark:bg-slate-800 text-slate-800 dark:text-slate-200 hover:bg-brand-600 hover:text-white dark:hover:bg-brand-600 text-xs font-bold transition-colors flex items-center gap-1.5">
          <span>🏛️ Banka Denetimi</span>
        </a>
        <a href="/category/mali-analiz-kutuphanesi/" class="px-3.5 py-1.5 rounded-xl bg-slate-100 dark:bg-slate-800 text-slate-800 dark:text-slate-200 hover:bg-brand-600 hover:text-white dark:hover:bg-brand-600 text-xs font-bold transition-colors flex items-center gap-1.5">
          <span>📊 Mali Analiz</span>
        </a>
      </div>
      <a href="/deneme-sinavlari/" class="px-4 py-1.5 rounded-xl bg-amber-500 hover:bg-amber-400 text-slate-950 font-black text-xs shadow-sm flex items-center gap-1">
        <span>⚡ 12+ Çözümlü Deneme Sınavı</span>
      </a>
    </div>
  </section>

  <!-- İNTERAKTİF DENEME SINAVLARI MODÜLÜ (Görsel Kartlar) -->
  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 mt-10">
    <div class="bg-gradient-to-br from-[#0b2b46] via-[#092237] to-[#061726] rounded-3xl p-6 sm:p-10 border border-brand-800 shadow-xl text-white">
      
      <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 mb-8 pb-6 border-b border-brand-800/80">
        <div>
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-amber-500/20 text-amber-300 text-xs font-bold mb-2 border border-amber-500/30">
            <span>⚡ Sınav Pratik Merkezi</span>
          </div>
          <h2 class="text-2xl sm:text-3xl font-black text-white tracking-tight">
            Gerçek Sınav Formatında Çözümlü Denemeler
          </h2>
          <p class="text-slate-300 text-xs sm:text-sm mt-1">
            Soruları çözün, şıkka tıklayıp anında doğru cevabı ve kapsamlı mevzuat açıklamasını inceleyin.
          </p>
        </div>
        <a href="/deneme-sinavlari/" class="px-6 py-3 rounded-xl bg-amber-500 hover:bg-amber-400 text-slate-950 font-bold text-xs shadow-lg shadow-amber-500/20 whitespace-nowrap transition-transform hover:-translate-y-0.5">
          Tüm Sınavları Gör →
        </a>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {quizList.map(quiz => (
          <a href={quiz.url} class="group bg-slate-900/80 hover:bg-slate-900 rounded-2xl border border-brand-800/80 overflow-hidden shadow-md transition-all duration-300 flex flex-col justify-between hover:border-amber-400/80">
            <div class="relative aspect-[16/9] overflow-hidden bg-slate-950">
              <img 
                src={quiz.featured_image} 
                alt={quiz.title} 
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500 opacity-90"
                loading="lazy"
              />
              <div class="absolute top-3 left-3">
                <span class="px-2.5 py-1 rounded-md bg-amber-500 text-slate-950 font-black text-[10px] uppercase shadow">
                  Çözümlü Test
                </span>
              </div>
              <div class="absolute bottom-3 right-3">
                <span class="px-2 py-0.5 rounded bg-black/60 backdrop-blur-sm text-white text-[11px] font-medium">
                  ⏱️ {quiz.reading_time} dk
                </span>
              </div>
            </div>

            <div class="p-5 flex-grow flex flex-col justify-between">
              <h3 class="font-bold text-white text-base leading-snug group-hover:text-amber-300 transition-colors line-clamp-2 mb-2">
                {quiz.title}
              </h3>
              <p class="text-slate-400 text-xs line-clamp-2 leading-relaxed">
                {quiz.excerpt}
              </p>
              
              <div class="pt-4 mt-4 border-t border-slate-800 flex items-center justify-between text-xs font-bold text-amber-400">
                <span>Soruları Çözmeye Başla</span>
                <span class="transform group-hover:translate-x-1 transition-transform">→</span>
              </div>
            </div>
          </a>
        ))}
      </div>

    </div>
  </section>

  <!-- KATEGORİ MODÜLÜ 1: SPL LİSANSLAMA (Magazine Module - Pars Stili) -->
  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 mt-16">
    <div class="flex items-center justify-between pb-3 mb-6 border-b-2 border-brand-900">
      <div class="flex items-center gap-3">
        <span class="w-3.5 h-7 rounded-sm bg-brand-600 inline-block"></span>
        <h2 class="text-xl sm:text-2xl font-black text-slate-900 dark:text-white tracking-tight uppercase">
          SPL Lisanslama Sınav Notları
        </h2>
      </div>
      <a href="/category/spl-ders-notlari/" class="text-xs font-bold text-brand-600 dark:text-sky-400 hover:underline">
        Tüm SPL Notları ({splPosts.length}) →
      </a>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
      {splPosts.map(post => (
        <a href={post.url} class="group bg-white dark:bg-[#0b1726] rounded-2xl border border-slate-200 dark:border-slate-800 overflow-hidden shadow-sm hover:shadow-lg transition-all duration-300 flex flex-col justify-between">
          <div class="relative aspect-[16/10] overflow-hidden bg-slate-100 dark:bg-slate-800">
            <img 
              src={post.featured_image} 
              alt={post.title} 
              class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
              loading="lazy"
            />
            <div class="absolute bottom-2 left-2">
              <span class="px-2 py-0.5 rounded bg-black/60 backdrop-blur-sm text-white text-[10px] font-semibold">
                ⏱️ {post.reading_time} dk
              </span>
            </div>
          </div>
          <div class="p-4 flex-grow flex flex-col justify-between">
            <h3 class="font-bold text-slate-900 dark:text-white text-sm leading-snug group-hover:text-brand-600 dark:group-hover:text-sky-400 transition-colors line-clamp-2">
              {post.title}
            </h3>
            <span class="text-[11px] font-semibold text-slate-400 group-hover:text-brand-600 dark:group-hover:text-sky-400 mt-3 block">
              Ders Notunu Oku →
            </span>
          </div>
        </a>
      ))}
    </div>
  </section>

  <!-- KATEGORİ MODÜLÜ 2: MASAK UYUM GÖREVLİSİ (Magazine Module) -->
  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 mt-16">
    <div class="flex items-center justify-between pb-3 mb-6 border-b-2 border-emerald-600">
      <div class="flex items-center gap-3">
        <span class="w-3.5 h-7 rounded-sm bg-emerald-600 inline-block"></span>
        <h2 class="text-xl sm:text-2xl font-black text-slate-900 dark:text-white tracking-tight uppercase">
          MASAK Uyum Görevlisi Yetkilendirme
        </h2>
      </div>
      <a href="/category/masak-uyum-gorevlisi-yetkilendirme-ders-notlari/" class="text-xs font-bold text-emerald-600 dark:text-emerald-400 hover:underline">
        Tüm MASAK Notları →
      </a>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
      {masakPosts.map(post => (
        <a href={post.url} class="group bg-white dark:bg-[#0b1726] rounded-2xl border border-slate-200 dark:border-slate-800 overflow-hidden shadow-sm hover:shadow-lg transition-all duration-300 flex flex-col justify-between">
          <div class="relative aspect-[16/10] overflow-hidden bg-slate-100 dark:bg-slate-800">
            <img 
              src={post.featured_image} 
              alt={post.title} 
              class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
              loading="lazy"
            />
            <div class="absolute bottom-2 left-2">
              <span class="px-2 py-0.5 rounded bg-black/60 backdrop-blur-sm text-white text-[10px] font-semibold">
                ⏱️ {post.reading_time} dk
              </span>
            </div>
          </div>
          <div class="p-4 flex-grow flex flex-col justify-between">
            <h3 class="font-bold text-slate-900 dark:text-white text-sm leading-snug group-hover:text-emerald-600 dark:group-hover:text-emerald-400 transition-colors line-clamp-2">
              {post.title}
            </h3>
            <span class="text-[11px] font-semibold text-slate-400 group-hover:text-emerald-600 dark:group-hover:text-emerald-400 mt-3 block">
              Konuyu İncele →
            </span>
          </div>
        </a>
      ))}
    </div>
  </section>

  <!-- KATEGORİ MODÜLÜ 3: CIA PART 1 & İÇ DENETİM (Magazine Module) -->
  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 mt-16">
    <div class="flex items-center justify-between pb-3 mb-6 border-b-2 border-purple-600">
      <div class="flex items-center gap-3">
        <span class="w-3.5 h-7 rounded-sm bg-purple-600 inline-block"></span>
        <h2 class="text-xl sm:text-2xl font-black text-slate-900 dark:text-white tracking-tight uppercase">
          CIA Part 1 & İç Denetim Standartları
        </h2>
      </div>
      <a href="/category/cia-ders-notlari/" class="text-xs font-bold text-purple-600 dark:text-purple-400 hover:underline">
        Tüm CIA Notları →
      </a>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
      {ciaPosts.map(post => (
        <a href={post.url} class="group bg-white dark:bg-[#0b1726] rounded-2xl border border-slate-200 dark:border-slate-800 overflow-hidden shadow-sm hover:shadow-lg transition-all duration-300 flex flex-col justify-between">
          <div class="relative aspect-[16/10] overflow-hidden bg-slate-100 dark:bg-slate-800">
            <img 
              src={post.featured_image} 
              alt={post.title} 
              class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
              loading="lazy"
            />
            <div class="absolute bottom-2 left-2">
              <span class="px-2 py-0.5 rounded bg-black/60 backdrop-blur-sm text-white text-[10px] font-semibold">
                ⏱️ {post.reading_time} dk
              </span>
            </div>
          </div>
          <div class="p-4 flex-grow flex flex-col justify-between">
            <h3 class="font-bold text-slate-900 dark:text-white text-sm leading-snug group-hover:text-purple-600 dark:group-hover:text-purple-400 transition-colors line-clamp-2">
              {post.title}
            </h3>
            <span class="text-[11px] font-semibold text-slate-400 group-hover:text-purple-600 dark:group-hover:text-purple-400 mt-3 block">
              Soruları Çöz →
            </span>
          </div>
        </a>
      ))}
    </div>
  </section>

  <!-- SON EKLENEN MAKALE VE REHBERLER (Grid with Cover Thumbnails) -->
  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 mt-20 mb-16">
    <div class="flex items-center justify-between pb-3 mb-8 border-b border-slate-200 dark:border-slate-800">
      <div>
        <h2 class="text-2xl font-black text-slate-900 dark:text-white tracking-tight">
          Son Eklenen Sınav Makaleleri & Rehberler
        </h2>
        <p class="text-xs text-slate-500 dark:text-slate-400 mt-1">Müfettişlik, mevzuat ve kariyer kütüphanesinden güncel notlar</p>
      </div>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      {latestNews.map(item => (
        <a href={item.url} class="group bg-white dark:bg-[#0b1726] rounded-2xl border border-slate-200 dark:border-slate-800 overflow-hidden shadow-sm hover:shadow-xl transition-all duration-300 flex flex-col justify-between">
          <div>
            <div class="relative aspect-[16/10] overflow-hidden bg-slate-100 dark:bg-slate-800">
              <img 
                src={item.featured_image} 
                alt={item.title} 
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                loading="lazy"
              />
              <div class="absolute top-3 left-3">
                {item.categories && item.categories[0] && (
                  <span class="px-2.5 py-1 rounded bg-slate-900/80 backdrop-blur-sm text-white text-[10px] font-bold uppercase">
                    {item.categories[0].name}
                  </span>
                )}
              </div>
            </div>
            
            <div class="p-5">
              <span class="text-[11px] text-slate-400 font-semibold mb-2 block">⏱️ {item.reading_time} dakika okuma</span>
              <h3 class="font-bold text-slate-900 dark:text-white text-base leading-snug group-hover:text-brand-600 dark:group-hover:text-sky-400 transition-colors line-clamp-2 mb-2">
                {item.title}
              </h3>
              <p class="text-slate-500 dark:text-slate-400 text-xs leading-relaxed line-clamp-3">
                {item.excerpt}
              </p>
            </div>
          </div>

          <div class="px-5 py-3.5 bg-slate-50 dark:bg-slate-800/40 border-t border-slate-100 dark:border-slate-800 flex items-center justify-between text-xs font-bold text-slate-600 dark:text-slate-300 group-hover:text-brand-600 dark:group-hover:text-sky-400">
            <span>Devamını Oku</span>
            <span>→</span>
          </div>
        </a>
      ))}
    </div>
  </section>

</Layout>
