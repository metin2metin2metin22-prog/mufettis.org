                <div class="absolute bottom-2 right-2">
                  <span class="inline-flex items-center gap-1 text-[9px] text-white/90 bg-black/70 backdrop-blur-sm px-2 py-0.5 rounded-md">
                    <svg class="w-2.5 h-2.5 text-slate-300" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                    <span>{sub.reading_time} dk</span>
                  </span>
                </div>
              </div>
              
              <!-- Editoryal Başlık Bloğu -->
              <div class="p-4 flex flex-col justify-between flex-grow">
                <h4 class="text-xs sm:text-[13.5px] font-bold text-slate-900 dark:text-white leading-snug group-hover:text-amber-500 dark:group-hover:text-amber-400 transition-colors line-clamp-2">
                  {sub.title}
                </h4>
