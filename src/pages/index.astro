---
import Layout from '../layouts/Layout.astro';
import { getAllPosts } from '../utils/posts';
import categories from '../data/categories.json';

const posts = getAllPosts();

// Filter actual blog articles
const blogPosts = posts.filter(p => p.post_type === 'post' && p.featured_image);

// 1. Manşet (5 Lead Stories with Cover Images)
const leadStory = blogPosts.find(p => p.slug.includes('2026-banka-mufettisi-maaslari')) || blogPosts[0];
const subManset = blogPosts
  .filter(p => p.slug !== leadStory.slug)
  .slice(0, 4);

// 2. Interactive Quizzes & Exams (12 sets)
const quizList = blogPosts.filter(p => p.is_quiz);

// 3. Category Specific Curated Sets
const splPosts = blogPosts.filter(p => p.categories && p.categories.some(c => c.slug.includes('spl')));
const masakPosts = blogPosts.filter(p => p.categories && p.categories.some(c => c.slug.includes('masak')));
const ciaPosts = blogPosts.filter(p => p.categories && p.categories.some(c => c.slug.includes('cia')));
const bankaPosts = blogPosts.filter(p => p.categories && p.categories.some(c => c.slug.includes('banka') || c.slug.includes('kariyer') || c.slug.includes('denetim')));
const maliPosts = blogPosts.filter(p => p.categories && p.categories.some(c => c.slug.includes('mali') || c.slug.includes('bilanco')));

// Latest Articles
const latestNews = blogPosts.filter(p => !p.is_quiz).slice(0, 8);
---

<Layout 
  title="Müfettiş | Sınav Hazırlık Notları, Makaleler ve Çözümlü Deneme Sınavları"
  description="Banka Müfettişliği, SPL Lisanslama, MASAK Uyum Görevlisi ve CIA sınavlarına hazırlık için kapsamlı ders notları, mevzuat özetleri ve çözümlü testler."
>
  
  <!-- HERO: MANŞET & AKILLI DERS ARAMA -->
  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-6 pb-2">
    
    <!-- EDITORIAL 5'Lİ MANŞET GRID -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-5">
      
      <!-- Ana Manşet (Lead Story - 7 Kolon) -->
      <div class="lg:col-span-7">
        <a href={leadStory.url} class="group relative block aspect-[16/10] sm:aspect-[16/9] lg:aspect-auto lg:h-[490px] rounded-none overflow-hidden shadow-xl bg-slate-950 border-2 border-slate-200 dark:border-slate-800 hover:border-amber-500/60 dark:hover:border-amber-400/60 transition-all duration-300">
          <img 
            src={leadStory.featured_image} 
            alt={leadStory.title} 
            class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700 opacity-90"
            loading="eager"
          />
          <div class="absolute inset-0 bg-gradient-to-t from-slate-950 via-slate-950/65 to-transparent"></div>
          
          <div class="absolute bottom-0 inset-x-0 p-6 sm:p-9 flex flex-col justify-end">
            <div class="flex flex-wrap items-center gap-2 mb-3.5">
              <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-sm bg-gradient-to-r from-amber-400 to-amber-500 text-slate-950 text-xs font-black uppercase tracking-wider shadow-md">
                <svg class="w-3.5 h-3.5 fill-current" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/></svg>
                <span>Özel Araştırma Dosyası</span>
              </span>
              <span class="inline-flex items-center gap-1.5 text-xs text-slate-300 font-bold bg-black/60 backdrop-blur-md px-2.5 py-1 rounded-sm border border-white/10">
                <svg class="w-3.5 h-3.5 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                <span>{leadStory.reading_time} dk okuma</span>
              </span>
              <span class="inline-flex items-center gap-1 text-xs text-emerald-400 font-bold bg-emerald-950/70 backdrop-blur-md px-2.5 py-1 rounded-sm border border-emerald-500/30 hidden sm:inline-flex">
                <svg class="w-3.5 h-3.5 text-emerald-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"/></svg>
                <span>2026 Güncel Veriler</span>
              </span>
            </div>
            
            <h2 class="text-xl sm:text-3xl lg:text-[32px] font-black text-white leading-tight group-hover:text-amber-300 transition-colors drop-shadow-md">
              {leadStory.title}
            </h2>
            
            <p class="text-slate-300 text-xs sm:text-sm mt-3 line-clamp-2 leading-relaxed font-normal">
              {leadStory.excerpt}
            </p>
          </div>
        </a>
      </div>

      <!-- Yan Manşetler (4 Kart - 5 Kolon) -->
      <div class="lg:col-span-5 grid grid-cols-1 sm:grid-cols-2 gap-4">
        {subManset.map((sub) => {
          const cat = sub.categories && sub.categories[0] ? sub.categories[0].name : 'Ders Notu';
          return (
            <a href={sub.url} class="group relative aspect-[16/10] sm:aspect-auto lg:h-[237px] rounded-none overflow-hidden shadow-md bg-slate-950 border-2 border-slate-200 dark:border-slate-800 hover:border-amber-500/60 dark:hover:border-amber-400/60 transition-all duration-300">
              <img 
                src={sub.featured_image} 
                alt={sub.title} 
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700 opacity-85"
                loading="lazy"
              />
              <div class="absolute inset-0 bg-gradient-to-t from-slate-950 via-slate-950/60 to-transparent"></div>
              
              <div class="absolute bottom-0 inset-x-0 p-4 sm:p-5 flex flex-col justify-end">
                <span class="inline-block text-[10.5px] font-black text-amber-400 uppercase tracking-wider mb-1.5">
                  {cat}
                </span>
                <h3 class="text-xs sm:text-[13.5px] font-bold text-white leading-snug group-hover:text-amber-300 transition-colors line-clamp-2">
                  {sub.title}
                </h3>
              </div>
            </a>
          );
        })}
      </div>

    </div>

    <!-- AKILLI DERS VE SINAV SEÇİCİ BANT (HIZLI ERİŞİM) -->
    <div class="mt-6 bg-white dark:bg-[#0c1827] rounded-none sm:rounded-2xl p-5 sm:p-6 border-2 border-slate-200 dark:border-slate-800 shadow-md">
      <div class="flex flex-col lg:flex-row items-start lg:items-center justify-between gap-4">
        
        <div class="flex items-center gap-3">
          <div class="w-10 h-10 rounded-2xl bg-brand-50 dark:bg-brand-950/80 text-brand-600 dark:text-sky-400 flex items-center justify-center font-black text-lg border border-brand-200 dark:border-brand-800">
            <svg class="w-5 h-5 text-brand-600 dark:text-sky-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4M7.835 4.697a3.42 3.42 0 001.946-.806 3.42 3.42 0 014.438 0 3.42 3.42 0 001.946.806 3.42 3.42 0 013.138 3.138 3.42 3.42 0 00.806 1.946 3.42 3.42 0 010 4.438 3.42 3.42 0 00-.806 1.946 3.42 3.42 0 01-3.138 3.138 3.42 3.42 0 00-1.946.806 3.42 3.42 0 01-4.438 0 3.42 3.42 0 00-1.946-.806 3.42 3.42 0 01-3.138-3.138 3.42 3.42 0 00-.806-1.946 3.42 3.42 0 010-4.438 3.42 3.42 0 00.806-1.946 3.42 3.42 0 013.138-3.138z"/></svg>
          </div>
          <div>
            <h3 class="text-sm font-black text-slate-900 dark:text-white uppercase tracking-wider">Hızlı Sınav Hazırlık Hub</h3>
            <p class="text-xs text-slate-500 dark:text-slate-400">Çalışmak istediğiniz alanı seçip doğrudan ilgili notlara veya denemelere geçin:</p>
          </div>
        </div>

        <div class="flex flex-wrap items-center gap-2 w-full lg:w-auto">
          <a href="/category/spl-ders-notlari/" class="px-3.5 py-2 rounded-xl bg-sky-50 dark:bg-sky-950/60 text-sky-800 dark:text-sky-300 border border-sky-200 dark:border-sky-800 hover:bg-sky-600 hover:text-white dark:hover:bg-sky-600 font-bold text-xs transition-colors flex items-center gap-1.5">
            <svg class="w-3.5 h-3.5 text-sky-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6"/></svg>
            <span>SPL Lisanslama ({splPosts.length})</span>
          </a>
          
          <a href="/category/masak-uyum-gorevlisi-yetkilendirme-ders-notlari/" class="px-3.5 py-2 rounded-xl bg-emerald-50 dark:bg-emerald-950/60 text-emerald-800 dark:text-emerald-300 border border-emerald-200 dark:border-emerald-800 hover:bg-emerald-600 hover:text-white dark:hover:bg-emerald-600 font-bold text-xs transition-colors flex items-center gap-1.5">
            <svg class="w-3.5 h-3.5 text-emerald-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/></svg>
            <span>MASAK Uyum ({masakPosts.length})</span>
          </a>

          <a href="/category/cia-ders-notlari/" class="px-3.5 py-2 rounded-xl bg-purple-50 dark:bg-purple-950/60 text-purple-800 dark:text-purple-300 border border-purple-200 dark:border-purple-800 hover:bg-purple-600 hover:text-white dark:hover:bg-purple-600 font-bold text-xs transition-colors flex items-center gap-1.5">
            <svg class="w-3.5 h-3.5 text-purple-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 14l9-5-9-5-9 5 9 5z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 14l6.16-3.422a12.083 12.083 0 01.665 6.479A11.952 11.952 0 0012 20.055a11.952 11.952 0 00-6.824-2.998 12.078 12.078 0 01.665-6.479L12 14z"/></svg>
            <span>CIA Part 1 ({ciaPosts.length})</span>
          </a>

          <a href="/category/denetim-kutuphanesi/" class="px-3.5 py-2 rounded-xl bg-amber-50 dark:bg-amber-950/60 text-amber-800 dark:text-amber-300 border border-amber-200 dark:border-amber-800 hover:bg-amber-600 hover:text-white dark:hover:bg-amber-600 font-bold text-xs transition-colors flex items-center gap-1.5">
            <svg class="w-3.5 h-3.5 text-amber-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"/></svg>
            <span>Banka Denetimi ({bankaPosts.length})</span>
          </a>

          <a href="/deneme-sinavlari/" class="px-4 py-2 rounded-xl bg-gradient-to-r from-amber-500 to-amber-600 hover:from-amber-400 hover:to-amber-500 text-slate-950 font-black text-xs shadow-md transition-all flex items-center gap-1.5 ml-auto">
            <svg class="w-3.5 h-3.5 fill-current" viewBox="0 0 24 24"><path d="M13 10V3L4 14h7v7l9-11h-7z"/></svg>
            <span>12+ Çözümlü Deneme</span>
          </a>
        </div>

      </div>
    </div>

  </section>

  <!-- 4 BÜYÜK DİSİPLİN: KATEGORİ REHBERİ (Bespoke Category Showcase) -->
  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 mt-14">
    <div class="mb-8">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-brand-50 dark:bg-brand-950/80 text-brand-700 dark:text-sky-300 border border-brand-200 dark:border-brand-800 text-xs font-black uppercase tracking-wider mb-2">
        <svg class="w-3.5 h-3.5 text-brand-600 dark:text-sky-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"/></svg>
        <span>Müfredat ve Sertifikasyonlar</span>
      </div>
      <h2 class="text-2xl sm:text-4xl font-black text-slate-900 dark:text-white tracking-tight">
        Sınav ve Kariyer Odakları
      </h2>
      <p class="text-slate-600 dark:text-slate-400 text-sm sm:text-base mt-1">
        Türkiye'de en çok tercih edilen denetim, uyum ve sermaye piyasası sınavlarına özel ayrılmış kütüphaneler.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
      
      <!-- CARD 1: SPL LİSANSLAMA -->
      <div class="group relative rounded-3xl bg-white dark:bg-[#0c1827] border-2 border-sky-100 dark:border-sky-950 p-6 sm:p-7 shadow-md hover:shadow-2xl transition-all duration-300 flex flex-col justify-between hover:border-sky-500">
        <div class="absolute top-0 right-0 w-32 h-32 bg-sky-500/10 rounded-full blur-2xl -mr-10 -mt-10 pointer-events-none"></div>
        <div>
          <div class="w-12 h-12 rounded-2xl bg-sky-50 dark:bg-sky-950 text-sky-600 dark:text-sky-400 flex items-center justify-center mb-5 border border-sky-200 dark:border-sky-800">
            <svg class="w-6 h-6 text-sky-600 dark:text-sky-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6"/></svg>
          </div>
          <span class="text-[11px] font-black uppercase tracking-wider text-sky-600 dark:text-sky-400 block mb-1">SPK & Borsa İstanbul</span>
          <h3 class="text-xl font-black text-slate-900 dark:text-white leading-tight mb-3 group-hover:text-sky-600 dark:group-hover:text-sky-400 transition-colors">
            SPL Lisanslama Sınavları
          </h3>
          <p class="text-xs text-slate-600 dark:text-slate-400 leading-relaxed mb-5">
            Sermaye Piyasası Araçları 1, Takas Saklama ve Operasyon, Yatırım Kuruluşları ve Meslek Kuralları ders notları.
          </p>
          <div class="space-y-1.5 text-xs font-semibold text-slate-700 dark:text-slate-300 border-t border-slate-100 dark:border-slate-800/80 pt-4 mb-6">
            <div class="flex items-center justify-between">
              <span class="text-slate-400 font-normal">Ders Notu:</span>
              <span class="font-bold">5 Kapsamlı Not</span>
            </div>
            <div class="flex items-center justify-between">
              <span class="text-slate-400 font-normal">Çözümlü Sınav:</span>
              <span class="text-amber-500 font-bold">4 Deneme Seti</span>
            </div>
          </div>
        </div>
        <div class="space-y-2">
          <a href="/category/spl-ders-notlari/" class="block w-full py-2.5 rounded-xl bg-sky-50 hover:bg-sky-100 dark:bg-sky-950/60 dark:hover:bg-sky-900/60 text-sky-700 dark:text-sky-300 font-black text-xs text-center transition-colors border border-sky-200 dark:border-sky-800">
            Konu Anlatımlarını Gör →
          </a>
          <a href="/spl-sermaye-piyasasi-araclari-1-deneme-sinavi/" class="flex items-center justify-center gap-1.5 w-full py-2 rounded-xl bg-slate-100 hover:bg-slate-200 dark:bg-slate-800 dark:hover:bg-slate-700 text-slate-700 dark:text-slate-200 font-bold text-[11px] text-center transition-colors">
            <svg class="w-3.5 h-3.5 text-amber-500 fill-current" viewBox="0 0 24 24"><path d="M13 10V3L4 14h7v7l9-11h-7z"/></svg>
            <span>SPL Denemesi Çöz</span>
          </a>
        </div>
      </div>

      <!-- CARD 2: MASAK UYUM GÖREVLİSİ -->
      <div class="group relative rounded-3xl bg-white dark:bg-[#0c1827] border-2 border-emerald-100 dark:border-emerald-950 p-6 sm:p-7 shadow-md hover:shadow-2xl transition-all duration-300 flex flex-col justify-between hover:border-emerald-500">
        <div class="absolute top-0 right-0 w-32 h-32 bg-emerald-500/10 rounded-full blur-2xl -mr-10 -mt-10 pointer-events-none"></div>
        <div>
          <div class="w-12 h-12 rounded-2xl bg-emerald-50 dark:bg-emerald-950 text-emerald-600 dark:text-emerald-400 flex items-center justify-center mb-5 border border-emerald-200 dark:border-emerald-800">
            <svg class="w-6 h-6 text-emerald-600 dark:text-emerald-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/></svg>
          </div>
          <span class="text-[11px] font-black uppercase tracking-wider text-emerald-600 dark:text-emerald-400 block mb-1">Mali Suçlar & AML/CFT</span>
          <h3 class="text-xl font-black text-slate-900 dark:text-white leading-tight mb-3 group-hover:text-emerald-600 dark:group-hover:text-emerald-400 transition-colors">
            MASAK Uyum Görevlisi
          </h3>
          <p class="text-xs text-slate-600 dark:text-slate-400 leading-relaxed mb-5">
            5549 Sayılı Kanun, Suç Gelirlerinin Aklanması, Şüpheli İşlem Bildirimleri (ŞİB), Modül 1 ve Modül 2 sınav hazırlığı.
          </p>
          <div class="space-y-1.5 text-xs font-semibold text-slate-700 dark:text-slate-300 border-t border-slate-100 dark:border-slate-800/80 pt-4 mb-6">
            <div class="flex items-center justify-between">
              <span class="text-slate-400 font-normal">Ders Notu:</span>
              <span class="font-bold">6 Modül & Özet</span>
            </div>
            <div class="flex items-center justify-between">
              <span class="text-slate-400 font-normal">Çözümlü Sınav:</span>
              <span class="text-amber-500 font-bold">2 Kapsamlı Deneme</span>
            </div>
          </div>
        </div>
        <div class="space-y-2">
          <a href="/category/masak-uyum-gorevlisi-yetkilendirme-ders-notlari/" class="block w-full py-2.5 rounded-xl bg-emerald-50 hover:bg-emerald-100 dark:bg-emerald-950/60 dark:hover:bg-emerald-900/60 text-emerald-700 dark:text-emerald-300 font-black text-xs text-center transition-colors border border-emerald-200 dark:border-emerald-800">
            MASAK Notlarını Gör →
          </a>
          <a href="/masak-uyum-gorevlisi-yetkilendirme-deneme-sinavi-modul-1/" class="flex items-center justify-center gap-1.5 w-full py-2 rounded-xl bg-slate-100 hover:bg-slate-200 dark:bg-slate-800 dark:hover:bg-slate-700 text-slate-700 dark:text-slate-200 font-bold text-[11px] text-center transition-colors">
            <svg class="w-3.5 h-3.5 text-amber-500 fill-current" viewBox="0 0 24 24"><path d="M13 10V3L4 14h7v7l9-11h-7z"/></svg>
            <span>Modül 1 Sınavı Çöz</span>
          </a>
        </div>
      </div>

      <!-- CARD 3: CIA PART 1 -->
      <div class="group relative rounded-3xl bg-white dark:bg-[#0c1827] border-2 border-purple-100 dark:border-purple-950 p-6 sm:p-7 shadow-md hover:shadow-2xl transition-all duration-300 flex flex-col justify-between hover:border-purple-500">
        <div class="absolute top-0 right-0 w-32 h-32 bg-purple-500/10 rounded-full blur-2xl -mr-10 -mt-10 pointer-events-none"></div>
        <div>
          <div class="w-12 h-12 rounded-2xl bg-purple-50 dark:bg-purple-950 text-purple-600 dark:text-purple-400 flex items-center justify-center mb-5 border border-purple-200 dark:border-purple-800">
            <svg class="w-6 h-6 text-purple-600 dark:text-purple-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 14l9-5-9-5-9 5 9 5z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 14l6.16-3.422a12.083 12.083 0 01.665 6.479A11.952 11.952 0 0012 20.055a11.952 11.952 0 00-6.824-2.998 12.078 12.078 0 01.665-6.479L12 14z"/></svg>
          </div>
          <span class="text-[11px] font-black uppercase tracking-wider text-purple-600 dark:text-purple-400 block mb-1">IIA Küresel Standartları</span>
          <h3 class="text-xl font-black text-slate-900 dark:text-white leading-tight mb-3 group-hover:text-purple-600 dark:group-hover:text-purple-400 transition-colors">
            CIA Part 1 Sertifikasyon
          </h3>
          <p class="text-xs text-slate-600 dark:text-slate-400 leading-relaxed mb-5">
            İç Denetimin Temelleri, Üç Hat Modeli, Bağımsızlık ve Objektiflik, Kurumsal Yönetişim ve Kontrol Ortamı.
          </p>
          <div class="space-y-1.5 text-xs font-semibold text-slate-700 dark:text-slate-300 border-t border-slate-100 dark:border-slate-800/80 pt-4 mb-6">
            <div class="flex items-center justify-between">
              <span class="text-slate-400 font-normal">Ders Notu:</span>
              <span class="font-bold">14 Kapsamlı Konu</span>
            </div>
