    <!-- 5'li Magazin Düzeni: 7 Kolon Ana Dosya + 5 Kolon Yan Dosyalar -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 items-stretch">
      
      <!-- Ana Manşet (Lead Story - 7 Kolon) -->
      <div class="lg:col-span-7 flex flex-col">
        <a href={leadStory.url} class="group flex flex-col h-full rounded-3xl overflow-hidden shadow-lg bg-white dark:bg-[#0c1827] border-2 border-slate-200 dark:border-slate-800 hover:border-amber-500/80 dark:hover:border-amber-400/80 transition-all duration-300 hover:shadow-2xl hover:shadow-amber-500/10">
          
          <!-- Görsel Alanı: Yazısız ve tertemiz sunum -->
          <div class="relative aspect-[16/9] w-full overflow-hidden bg-slate-950">
            <img 
              src={leadImageWebp} 
              alt={leadStory.title} 
              class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700"
              loading="eager"
              fetchpriority="high"
              decoding="async"
              width="1200"
              height="675"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-slate-950/80 via-transparent to-transparent"></div>

            <div class="absolute top-4 left-4 flex flex-wrap gap-2">
              <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-xl bg-gradient-to-r from-amber-400 to-amber-500 text-slate-950 text-xs font-black uppercase tracking-wider shadow-lg">
                <svg class="w-3.5 h-3.5 fill-current" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/></svg>
                <span>Özel Araştırma Dosyası</span>
              </span>
            </div>
            
            <div class="absolute bottom-3.5 right-4">
