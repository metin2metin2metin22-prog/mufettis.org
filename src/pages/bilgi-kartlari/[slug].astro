---
import Layout from '../../layouts/Layout.astro';
import { flashcards, type Flashcard } from '../../data/flashcards';

export function getStaticPaths() {
  return flashcards.map((card, idx) => {
    const prevCard = idx > 0 ? flashcards[idx - 1] : flashcards[flashcards.length - 1];
    const nextCard = idx < flashcards.length - 1 ? flashcards[idx + 1] : flashcards[0];
    return {
      params: { slug: card.slug },
      props: {
        card,
        prevCard,
        nextCard,
        totalCards: flashcards.length,
        currentIndex: idx + 1
      }
    };
  });
}

interface Props {
  card: Flashcard;
  prevCard: Flashcard;
  nextCard: Flashcard;
  totalCards: number;
  currentIndex: number;
}

const { card, prevCard, nextCard, totalCards, currentIndex } = Astro.props;

// JSON-LD Schema for Google Rich Snippets (FAQPage + BreadcrumbList)
const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": card.question,
      "acceptedAnswer": {
        "@type": "Answer",
        "text": `${card.answer}\n\nMevzuat Notu: ${card.legalNote}`
      }
    }
  ]
};

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "Anasayfa",
      "item": "https://mufettis.org/"
    },
    {
      "@type": "ListItem",
      "position": 2,
      "name": "Bilgi Kartları",
      "item": "https://mufettis.org/bilgi-kartlari/"
    },
    {
      "@type": "ListItem",
      "position": 3,
      "name": card.title,
      "item": `https://mufettis.org/bilgi-kartlari/${card.slug}/`
    }
  ]
};
---

<Layout 
  title={`${card.title} - Bilgi Kartı | mufettis.org`}
  description={`${card.question} - Banka Müfettişliği, SPL, MASAK ve CIA sınavları için interaktif bilgi kartı ve mevzuat özeti.`}
  canonical={`https://mufettis.org/bilgi-kartlari/${card.slug}/`}
>
  <!-- Injected SEO Structured Data -->
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />

  <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 pt-8 pb-24">
    
    <!-- Top Breadcrumb -->
    <nav class="flex items-center gap-2 text-xs text-slate-500 dark:text-slate-400 mb-6 overflow-x-auto whitespace-nowrap scrollbar-none pb-1">
      <a href="/" class="hover:text-brand-600 dark:hover:text-sky-400">Anasayfa</a>
      <span>/</span>
      <a href="/bilgi-kartlari/" class="hover:text-brand-600 dark:hover:text-sky-400">Bilgi Kartları</a>
      <span>/</span>
      <span class="text-slate-700 dark:text-slate-300 font-bold truncate">{card.title}</span>
    </nav>

    <!-- Header & Badges -->
    <header class="mb-8">
      <div class="flex items-center justify-between gap-2 mb-3">
        <div class="flex items-center gap-2">
          <span class="text-[11px] font-black uppercase tracking-wider px-3 py-1 rounded-full bg-brand-50 dark:bg-brand-950/80 text-brand-700 dark:text-sky-300 border border-brand-200 dark:border-brand-800">
            {card.category}
          </span>
          <span class="text-[11px] font-bold px-3 py-1 rounded-full bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300 border border-slate-200 dark:border-slate-700">
            {card.tag}
          </span>
        </div>
        <span class="text-xs text-slate-400 font-bold">
          Kart #{currentIndex} / {totalCards}
        </span>
      </div>

      <h1 class="text-2xl sm:text-3xl font-black text-slate-900 dark:text-white tracking-tight leading-snug">
        {card.title}
      </h1>
    </header>

    <!-- 3D INTERACTIVE FLIP CARD -->
    <div class="perspective-1000 min-h-[340px] cursor-pointer mb-6" id="main-flip-container">
      <div class="flashcard-inner relative w-full h-full min-h-[340px] transition-transform duration-500 transform-style-3d rounded-3xl border-2 border-slate-200 dark:border-slate-800 shadow-xl hover:shadow-2xl hover:border-brand-500">
        
        <!-- Front Face -->
        <div class="flashcard-front absolute inset-0 backface-hidden rounded-3xl p-8 sm:p-10 bg-white dark:bg-[#0c1827] flex flex-col justify-between">
          <div>
            <div class="flex items-center justify-between mb-4">
              <span class="text-xs font-black uppercase tracking-wider text-brand-600 dark:text-sky-400">
                SORU
              </span>
              <span class="text-xs font-bold px-2.5 py-1 rounded-lg bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-300">
                #{currentIndex}
              </span>
            </div>
            <h2 class="text-lg sm:text-2xl font-black text-slate-900 dark:text-white leading-snug">
              {card.question}
            </h2>
          </div>

          <div class="pt-5 border-t border-slate-100 dark:border-slate-800 flex items-center justify-between text-xs font-bold">
            <span class="text-brand-600 dark:text-sky-400 inline-flex items-center gap-1.5">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"></path></svg>
              Cevabı görmek için dokunun
            </span>
            <span class="text-slate-400">Çevir ↻</span>
          </div>
        </div>

        <!-- Back Face -->
        <div class="flashcard-back absolute inset-0 backface-hidden rotate-y-180 rounded-3xl p-8 sm:p-10 bg-gradient-to-br from-[#07192a] via-[#092237] to-[#05111d] text-white flex flex-col justify-between border-2 border-amber-500/50 shadow-2xl">
          <div>
            <div class="flex items-center justify-between mb-3 pb-2 border-b border-brand-800/80">
              <span class="text-xs font-black uppercase tracking-wider text-amber-400 flex items-center gap-1.5">
                <svg class="w-4 h-4 text-emerald-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"></path></svg>
                Doğru Cevap & Özet
              </span>
              <span class="text-xs text-slate-400 font-bold">#{currentIndex}</span>
            </div>
            <p class="text-slate-100 text-sm sm:text-base leading-relaxed whitespace-pre-line font-medium">
              {card.answer}
            </p>
          </div>

          <div class="pt-4 border-t border-brand-800 flex items-center justify-between text-xs font-bold text-slate-400">
            <span class="text-amber-400">Tekrar çevirmek için dokunun ↻</span>
            <span class="text-slate-400">Mevzuat notu aşağıda ↓</span>
          </div>
        </div>

      </div>
    </div>

    <!-- MEVZUAT NOTU -->
    {card.legalNote && (
      <div class="mb-10 p-5 rounded-2xl bg-white dark:bg-[#0c1827] border border-slate-200 dark:border-slate-800 shadow-xs">
        <div class="flex items-center gap-2 mb-2 text-xs font-black uppercase tracking-wider text-slate-800 dark:text-slate-200">
          <span>⚖️ Mevzuat & Dayanak Notu</span>
        </div>
        <p class="text-xs sm:text-sm text-slate-600 dark:text-slate-300 leading-relaxed font-medium">
          {card.legalNote}
        </p>
      </div>
    )}

    <!-- BOTTOM NAVIGATION -->
    <footer class="pt-6 border-t border-slate-200 dark:border-slate-800 flex items-center justify-between gap-3 text-xs font-bold">
      <a 
        href={`/bilgi-kartlari/${prevCard.slug}/`}
        class="inline-flex items-center gap-1.5 px-4 py-2.5 rounded-xl bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300 hover:bg-slate-200 dark:hover:bg-slate-700 transition-colors"
      >
        <span>← Önceki</span>
      </a>

      <a 
        href="/bilgi-kartlari/"
        class="inline-flex items-center gap-1.5 px-4 py-2.5 rounded-xl bg-brand-600 text-white hover:bg-brand-700 shadow-xs transition-all"
      >
        <span>Tüm Bilgi Kartları</span>
      </a>

      <a 
        href={`/bilgi-kartlari/${nextCard.slug}/`}
        class="inline-flex items-center gap-1.5 px-4 py-2.5 rounded-xl bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300 hover:bg-slate-200 dark:hover:bg-slate-700 transition-colors"
      >
        <span>Sonraki →</span>
      </a>
    </footer>

  </div>

  <style>
    .perspective-1000 {
      perspective: 1000px;
    }
    .transform-style-3d {
      transform-style: preserve-3d;
    }
    .backface-hidden {
      backface-visibility: hidden;
      -webkit-backface-visibility: hidden;
    }
    .rotate-y-180 {
      transform: rotateY(180deg);
    }
    .flashcard-flipped {
      transform: rotateY(180deg);
    }
  </style>

  <script>
    // 3D Flip Handler
    const flipContainer = document.getElementById('main-flip-container');
    flipContainer?.addEventListener('click', () => {
      const inner = flipContainer.querySelector('.flashcard-inner');
      inner?.classList.toggle('flashcard-flipped');
    });
  </script>
</Layout>
