---
import Layout from '../layouts/Layout.astro';
import { flashcards } from '../data/flashcards';
---

<Layout 
  title="İnteraktif Sınav Bilgi Kartları (Flashcards) | SPL, MASAK, CIA"
  description="Banka Müfettişliği, SPL, MASAK ve CIA sınavları için 3D çevrilebilir interaktif akıl ve hafıza kartları. Mevzuat tüyoları ve çözümlü sorular."
  canonical="https://mufettis.org/bilgi-kartlari/"
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-10 pb-28">
    
    <!-- Breadcrumb -->
    <nav class="flex items-center gap-2 text-xs text-slate-500 dark:text-slate-400 mb-6">
      <a href="/" class="hover:text-brand-600 dark:hover:text-sky-400">Anasayfa</a>
      <span>/</span>
      <span class="text-slate-800 dark:text-slate-200 font-bold">İnteraktif Bilgi Kartları</span>
    </nav>

    <!-- Header -->
    <header class="max-w-3xl mb-10">
      <div class="inline-flex items-center gap-1.5 px-3.5 py-1.5 rounded-full bg-brand-50 dark:bg-brand-950/80 text-brand-700 dark:text-sky-300 border border-brand-200 dark:border-brand-800 text-xs font-black uppercase tracking-wider mb-3">
        <svg class="w-3.5 h-3.5 text-brand-600 dark:text-sky-400 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"></path></svg>
        <span>3D Çevrilebilir Hafıza Kartları & Mikro Mevzuat Hub</span>
      </div>
      <h1 class="text-3xl sm:text-5xl font-black text-slate-900 dark:text-white tracking-tight leading-tight">
        Sınav Akıl Kartları
      </h1>
      <p class="text-slate-600 dark:text-slate-300 text-sm sm:text-base mt-3 leading-relaxed">
        Telefonda veya bilgisayarda hızlı tekrar yapın. Kartın üzerine tıklayarak cevabı görün, öğrendiklerinizi pekiştirin veya doğrudan her konunun derinlemesine mevzuat ve çözümlü soru sayfasına geçin.
      </p>
    </header>

    <!-- Filter Buttons (Smooth Horizontal Carousel on Mobile) -->
    <div class="flex items-center gap-2.5 pb-6 mb-8 border-b border-slate-200 dark:border-slate-800 overflow-x-auto whitespace-nowrap no-scrollbar scrollbar-none -mx-4 px-4 sm:mx-0 sm:px-0 text-xs">
      <button type="button" class="fc-filter active px-4 py-2 rounded-xl bg-brand-600 text-white font-bold cursor-pointer shrink-0 active:scale-95 transition-transform" data-filter="all">Tüm Kartlar ({flashcards.length})</button>
      <button type="button" class="fc-filter px-4 py-2 rounded-xl bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300 font-bold hover:bg-sky-100 dark:hover:bg-sky-950/60 cursor-pointer inline-flex items-center gap-1.5 shrink-0 active:scale-95 transition-transform" data-filter="spl">
        <svg class="w-3.5 h-3.5 text-sky-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6"></path></svg>
        <span>SPL</span>
      </button>
      <button type="button" class="fc-filter px-4 py-2 rounded-xl bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300 font-bold hover:bg-emerald-100 dark:hover:bg-emerald-950/60 cursor-pointer inline-flex items-center gap-1.5 shrink-0 active:scale-95 transition-transform" data-filter="masak">
        <svg class="w-3.5 h-3.5 text-emerald-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"></path></svg>
        <span>MASAK</span>
      </button>
      <button type="button" class="fc-filter px-4 py-2 rounded-xl bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300 font-bold hover:bg-purple-100 dark:hover:bg-purple-950/60 cursor-pointer inline-flex items-center gap-1.5 shrink-0 active:scale-95 transition-transform" data-filter="cia">
        <svg class="w-3.5 h-3.5 text-purple-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 14l9-5-9-5-9 5 9 5z"></path><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 14l6.16-3.422a12.083 12.083 0 01.665 6.479A11.952 11.952 0 0012 20.055a11.952 11.952 0 00-6.824-2.998 12.078 12.078 0 01.665-6.479L12 14z"></path></svg>
        <span>CIA</span>
      </button>
      <button type="button" class="fc-filter px-4 py-2 rounded-xl bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300 font-bold hover:bg-amber-100 dark:hover:bg-amber-950/60 cursor-pointer inline-flex items-center gap-1.5 shrink-0 active:scale-95 transition-transform" data-filter="banka">
        <svg class="w-3.5 h-3.5 text-amber-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 14v3m4-3v3m4-3v3M3 21h18M3 10h18M3 7l9-4 9 4M4 10h16v11H4V10z"></path></svg>
        <span>Banka</span>
      </button>
    </div>

    <!-- 3D Flashcards Grid -->
    <div id="flashcards-grid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
      {flashcards.map((card, idx) => (
        <div class="flashcard-container perspective-1000 min-h-[320px] cursor-pointer" data-category={card.catSlug}>
          <div class="flashcard-inner relative w-full h-full min-h-[320px] transition-transform duration-500 transform-style-3d rounded-3xl border-2 border-slate-200 dark:border-slate-800 shadow-md hover:shadow-2xl hover:border-brand-500">
            
            <!-- Front Face -->
            <div class="flashcard-front absolute inset-0 backface-hidden rounded-3xl p-7 bg-white dark:bg-[#0c1827] flex flex-col justify-between">
              <div>
                <div class="flex items-center justify-between mb-4">
                  <span class="text-[10px] font-black uppercase tracking-wider px-3 py-1 rounded-full bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300 border border-slate-200 dark:border-slate-700">
                    {card.category}
                  </span>
                  <span class="text-xs text-slate-400 font-bold">#{idx + 1} / {flashcards.length}</span>
                </div>
                <span class="text-xs font-bold text-brand-600 dark:text-sky-400 block mb-2">{card.tag}</span>
                <h3 class="text-base sm:text-lg font-black text-slate-900 dark:text-white leading-snug">
                  {card.question}
                </h3>
              </div>

              <div class="pt-4 border-t border-slate-100 dark:border-slate-800/80 flex items-center justify-between text-xs font-bold text-slate-400">
                <span class="flex items-center gap-1.5 text-brand-600 dark:text-sky-400">
                  <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"></path></svg>
                  Cevabı görmek için dokunun
                </span>
              </div>
            </div>

            <!-- Back Face (Answer + Micro-Hub Page Link) -->
            <div class="flashcard-back absolute inset-0 backface-hidden rotate-y-180 rounded-3xl p-7 bg-gradient-to-br from-[#07192a] via-[#092237] to-[#05111d] text-white flex flex-col justify-between border border-amber-500/40">
              <div>
                <div class="flex items-center justify-between mb-3 pb-2 border-b border-brand-800/80">
                  <span class="text-[10.5px] font-black uppercase tracking-wider text-amber-400 flex items-center gap-1.5">
                    <svg class="w-3.5 h-3.5 text-emerald-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"></path></svg>
                    Doğru Cevap & Özet
                  </span>
                  <span class="text-xs text-slate-400 font-bold">#{idx + 1}</span>
                </div>
                <p class="text-slate-200 text-xs sm:text-[13.5px] leading-relaxed whitespace-pre-line font-medium line-clamp-4">
                  {card.answer}
                </p>
              </div>

              <div class="pt-3 border-t border-brand-800 flex flex-col gap-2">
                <a 
                  href={`/bilgi-kartlari/${card.slug}/`} 
                  class="w-full text-center py-2 px-3 rounded-xl bg-amber-500 hover:bg-amber-400 text-slate-950 font-black text-xs inline-flex items-center justify-center gap-1.5 shadow-sm transition-transform active:scale-95"
                  onclick="event.stopPropagation();"
                >
                  <span>Mevzuat Dayanağı & Çözümlü Soru ➔</span>
                </a>
                <div class="flex items-center justify-between text-[11px] font-medium text-slate-400">
                  <span>Tekrar çevirmek için kart boşluğuna tıklayın ↻</span>
                </div>
              </div>
            </div>

          </div>
        </div>
      ))}
    </div>

  </div>

  <style>
    .perspective-1000 {
      perspective: 1000px;
    }
    .transform-style-3d {
      transform-style: preserve-3d;
    }
    .backface-hidden {
      backface-visibility: hidden;
      -webkit-backface-visibility: hidden;
    }
    .rotate-y-180 {
      transform: rotateY(180deg);
    }
    .flashcard-flipped {
      transform: rotateY(180deg);
    }
  </style>

  <script>
    // Flip card handler
    const cards = document.querySelectorAll('.flashcard-container');
    cards.forEach(card => {
      card.addEventListener('click', (e) => {
        // Prevent flipping if clicking the dedicated link button
        if ((e.target as HTMLElement).closest('a')) return;
        const inner = card.querySelector('.flashcard-inner');
        inner?.classList.toggle('flashcard-flipped');
      });
    });

    // Category filter handler
    const filterBtns = document.querySelectorAll('.fc-filter');
    filterBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        filterBtns.forEach(b => {
          b.classList.remove('bg-brand-600', 'text-white');
          b.classList.add('bg-slate-100', 'dark:bg-slate-800', 'text-slate-700', 'dark:text-slate-300');
        });
        btn.classList.remove('bg-slate-100', 'dark:bg-slate-800', 'text-slate-700', 'dark:text-slate-300');
        btn.classList.add('bg-brand-600', 'text-white');

        const filter = btn.getAttribute('data-filter');
        cards.forEach(c => {
          const cat = c.getAttribute('data-category');
          if (filter === 'all' || cat === filter) {
            (c as HTMLElement).style.display = 'block';
          } else {
            (c as HTMLElement).style.display = 'none';
          }
        });
      });
    });
  </script>
</Layout>
