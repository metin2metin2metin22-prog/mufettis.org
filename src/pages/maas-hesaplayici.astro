---
import Layout from '../layouts/Layout.astro';
---

<Layout 
  title="2026 Banka Müfettişi ve Uyum Görevlisi Maaş Hesaplayıcı"
  description="Kamu, özel ve katılım bankaları ile BDDK/SPK müfettiş yardımcısı, yetkili müfettiş, başmüfettiş ve MASAK uyum görevlisi net maaş, turne harcırahı, YDS dil tazminatı ve CIA/CISA sertifika primi hesaplama motoru."
  canonical="https://mufettis.org/maas-hesaplayici/"
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-10 pb-28">
    
    <!-- Breadcrumb -->
    <nav class="flex items-center gap-2 text-xs text-slate-500 dark:text-slate-400 mb-6">
      <a href="/" class="hover:text-brand-600 dark:hover:text-sky-400">Anasayfa</a>
      <span>/</span>
      <span class="text-slate-800 dark:text-slate-200 font-bold">Maaş & Kariyer Hesaplayıcı</span>
    </nav>

    <!-- Header -->
    <header class="max-w-3xl mb-10">
      <div class="inline-flex items-center gap-1.5 px-3.5 py-1.5 rounded-full bg-amber-500/10 text-amber-600 dark:text-amber-400 border border-amber-500/30 text-xs font-black uppercase tracking-wider mb-3 shadow-xs">
        <svg class="w-3.5 h-3.5 text-amber-500 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
        <span>2026 Teftiş Kurulu Bordro ve Harcırah Skalası</span>
      </div>
      <h1 class="text-3xl sm:text-5xl font-black text-slate-900 dark:text-white tracking-tight leading-tight">
        Banka Müfettişi & Uyum Maaş Hesaplayıcı
      </h1>
      <p class="text-slate-600 dark:text-slate-300 text-sm sm:text-base mt-3 leading-relaxed">
        Banka teftiş kurullarındaki fiili bordro parametrelerini (16 maaş ikramiye sistemi, GVK 24 vergiden muaf turne harcırahı, kuruma göre kademeli YDS/TOEFL dil tazminatları ve CIA/CISA mesleki sertifika primleri) baz alarak net aylık ve yıllık kümülatif kazancınızı hesaplayın.
      </p>
    </header>

    <!-- Calculator Grid -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
      
      <!-- Input Controls (7 Cols) -->
      <div class="lg:col-span-7 space-y-6">
        
        <!-- Control Card 1: Kurum ve Unvan -->
        <div class="bg-white dark:bg-[#0c1827] rounded-3xl border-2 border-slate-200 dark:border-slate-800 p-6 sm:p-7 shadow-sm space-y-5">
          <div class="flex items-center gap-2 pb-3 border-b border-slate-100 dark:border-slate-800">
            <span class="w-6 h-6 rounded-lg bg-brand-50 dark:bg-brand-950 text-brand-600 dark:text-sky-400 text-xs font-black flex items-center justify-center">1</span>
            <h2 class="text-sm font-black uppercase tracking-wider text-slate-900 dark:text-white">Kurum ve Mesleki Kıdem</h2>
          </div>

          <!-- Kurum Türü Seçimi -->
          <div>
            <label class="block text-xs font-bold text-slate-600 dark:text-slate-400 mb-2">
              Banka / Denetim Otoritesi Türü:
            </label>
            <div class="grid grid-cols-2 sm:grid-cols-4 gap-2.5">
              <label class="cursor-pointer">
                <input type="radio" name="bank_type" value="kamu" class="peer sr-only" checked />
                <div class="p-3 rounded-2xl border-2 border-slate-200 dark:border-slate-800 peer-checked:border-brand-600 dark:peer-checked:border-sky-400 peer-checked:bg-brand-50/50 dark:peer-checked:bg-brand-950/40 text-center transition-all h-full flex flex-col justify-center">
                  <span class="block font-black text-xs text-slate-900 dark:text-white">Kamu Bankası</span>
                  <span class="text-[10px] text-slate-400 mt-0.5">Ziraat, Halk, Vakıf</span>
                </div>
              </label>

              <label class="cursor-pointer">
                <input type="radio" name="bank_type" value="ozel" class="peer sr-only" />
                <div class="p-3 rounded-2xl border-2 border-slate-200 dark:border-slate-800 peer-checked:border-brand-600 dark:peer-checked:border-sky-400 peer-checked:bg-brand-50/50 dark:peer-checked:bg-brand-950/40 text-center transition-all h-full flex flex-col justify-center">
                  <span class="block font-black text-xs text-slate-900 dark:text-white">Büyük Özel Banka</span>
                  <span class="text-[10px] text-slate-400 mt-0.5">İş, Garanti, Akbank, YKB</span>
                </div>
              </label>

              <label class="cursor-pointer">
                <input type="radio" name="bank_type" value="katilim" class="peer sr-only" />
                <div class="p-3 rounded-2xl border-2 border-slate-200 dark:border-slate-800 peer-checked:border-brand-600 dark:peer-checked:border-sky-400 peer-checked:bg-brand-50/50 dark:peer-checked:bg-brand-950/40 text-center transition-all h-full flex flex-col justify-center">
                  <span class="block font-black text-xs text-slate-900 dark:text-white">Katılım Bankası</span>
                  <span class="text-[10px] text-slate-400 mt-0.5">Kuveyt Türk, Albaraka</span>
                </div>
              </label>

              <label class="cursor-pointer">
                <input type="radio" name="bank_type" value="regulator" class="peer sr-only" />
                <div class="p-3 rounded-2xl border-2 border-slate-200 dark:border-slate-800 peer-checked:border-brand-600 dark:peer-checked:border-sky-400 peer-checked:bg-brand-50/50 dark:peer-checked:bg-brand-950/40 text-center transition-all h-full flex flex-col justify-center">
                  <span class="block font-black text-xs text-slate-900 dark:text-white">BDDK / SPK</span>
                  <span class="text-[10px] text-slate-400 mt-0.5">Düzenleyici Otorite</span>
                </div>
              </label>
            </div>
          </div>

          <!-- Unvan Seçimi -->
          <div>
            <label class="block text-xs font-bold text-slate-600 dark:text-slate-400 mb-2">
              Unvan ve Sorumluluk Alanı:
            </label>
            <select id="calc-title" class="w-full p-3.5 rounded-2xl border-2 border-slate-200 dark:border-slate-800 bg-slate-50 dark:bg-slate-900 text-slate-900 dark:text-white font-bold text-sm outline-none focus:border-brand-600 dark:focus:border-sky-400 transition-colors">
              <option value="yardimci">Müfettiş Yardımcısı (1 - 3 Yıl / Yetki Öncesi)</option>
              <option value="yetkili" selected>Yetkili Müfettiş (4 - 7 Yıl / Bağımsız Denetçi)</option>
              <option value="basmufettis">Kıdemli / Başmüfettiş (8+ Yıl / Ekip Lideri)</option>
              <option value="it_denetci">Bilgi Sistemleri (IT) Müfettişi / Siber Güvenlik Denetçisi</option>
              <option value="uyum">MASAK Uyum Görevlisi / AML-CFT Uzmanı</option>
            </select>
          </div>

          <!-- İkramiye Sistemi Seçimi -->
          <div>
            <label class="block text-xs font-bold text-slate-600 dark:text-slate-400 mb-2">
              İkramiye & Prim Dağıtım Modeli:
            </label>
            <div class="grid grid-cols-1 sm:grid-cols-3 gap-2.5">
              <label class="cursor-pointer">
                <input type="radio" name="bonus_model" value="16_maas" class="peer sr-only" checked />
                <div class="p-3 rounded-2xl border-2 border-slate-200 dark:border-slate-800 peer-checked:border-sky-500 peer-checked:bg-sky-50/50 dark:peer-checked:bg-sky-950/40 text-left transition-all">
                  <span class="block font-bold text-xs text-slate-900 dark:text-white">16 Maaş Sistemi</span>
                  <span class="text-[10px] text-slate-400">Yılda 4 net ikramiye (Kamu & İş Bankası)</span>
                </div>
              </label>
              <label class="cursor-pointer">
                <input type="radio" name="bonus_model" value="performans" class="peer sr-only" />
                <div class="p-3 rounded-2xl border-2 border-slate-200 dark:border-slate-800 peer-checked:border-sky-500 peer-checked:bg-sky-50/50 dark:peer-checked:bg-sky-950/40 text-left transition-all">
                  <span class="block font-bold text-xs text-slate-900 dark:text-white">Performans Primi</span>
                  <span class="text-[10px] text-slate-400">Yılda 2.5 - 4 maaş primi (Özel Sektör)</span>
                </div>
              </label>
              <label class="cursor-pointer">
                <input type="radio" name="bonus_model" value="12_maas" class="peer sr-only" />
                <div class="p-3 rounded-2xl border-2 border-slate-200 dark:border-slate-800 peer-checked:border-sky-500 peer-checked:bg-sky-50/50 dark:peer-checked:bg-sky-950/40 text-left transition-all">
                  <span class="block font-bold text-xs text-slate-900 dark:text-white">12 Düz Maaş</span>
                  <span class="text-[10px] text-slate-400">İkramiyesiz çıplak maaş modeli</span>
                </div>
              </label>
            </div>
          </div>
        </div>

        <!-- Control Card 2: Turne & Saha Harcırahı (GVK 24 Muafiyeti) -->
        <div class="bg-white dark:bg-[#0c1827] rounded-3xl border-2 border-slate-200 dark:border-slate-800 p-6 sm:p-7 shadow-sm space-y-4">
          <div class="flex items-center justify-between pb-3 border-b border-slate-100 dark:border-slate-800">
            <div class="flex items-center gap-2">
              <span class="w-6 h-6 rounded-lg bg-amber-50 dark:bg-amber-950 text-amber-600 dark:text-amber-400 text-xs font-black flex items-center justify-center">2</span>
              <h2 class="text-sm font-black uppercase tracking-wider text-slate-900 dark:text-white">Şehir Dışı Turne & Saha Harcırahı</h2>
            </div>
            <span class="text-[10.5px] font-bold text-emerald-600 dark:text-emerald-400 bg-emerald-50 dark:bg-emerald-950/60 px-2 py-0.5 rounded-md border border-emerald-500/20">
              GVK Madde 24 Vergiden Muaf
            </span>
          </div>

          <div>
            <div class="flex items-center justify-between mb-2">
              <span class="text-xs text-slate-600 dark:text-slate-400 font-semibold">
                Aylık Ortalama Turne / Şube Denetimi Günü:
              </span>
              <span id="turne-display" class="text-sm font-black text-amber-500 bg-amber-50 dark:bg-amber-950/60 px-3 py-0.5 rounded-lg border border-amber-300 dark:border-amber-800">14 Gün</span>
            </div>
            <input id="calc-turne" type="range" min="0" max="25" value="14" class="w-full accent-amber-500 cursor-pointer h-2.5 bg-slate-200 dark:bg-slate-800 rounded-lg" />
            <div class="flex justify-between text-[11px] text-slate-400 mt-2 font-medium">
              <span>0 Gün (Genel Müdürlük / Sürekli Merkez)</span>
              <span>10 - 15 Gün (Tipik Şube Teftişi)</span>
              <span>25 Gün (Yoğun Dönem)</span>
            </div>
          </div>

          <div class="p-3.5 rounded-2xl bg-slate-50 dark:bg-slate-900/60 border border-slate-200/80 dark:border-slate-800 text-xs text-slate-600 dark:text-slate-400 flex items-center justify-between">
            <span>Uygulanan Günlük Net Harcırah Tutarı:</span>
            <span id="daily-harcirah-rate" class="font-black text-slate-900 dark:text-white">2.400 TL / Gün</span>
          </div>
        </div>

        <!-- Control Card 3: Yabancı Dil ve Mesleki Sertifika Tazminatları -->
        <div class="bg-white dark:bg-[#0c1827] rounded-3xl border-2 border-slate-200 dark:border-slate-800 p-6 sm:p-7 shadow-sm space-y-5">
          <div class="flex items-center gap-2 pb-3 border-b border-slate-100 dark:border-slate-800">
            <span class="w-6 h-6 rounded-lg bg-sky-50 dark:bg-sky-950 text-sky-600 dark:text-sky-400 text-xs font-black flex items-center justify-center">3</span>
            <h2 class="text-sm font-black uppercase tracking-wider text-slate-900 dark:text-white">Yabancı Dil & Mesleki Sertifika Primleri</h2>
          </div>

          <!-- Yabancı Dil Seviyesi (YDS / TOEFL / Kurum Sınavı) -->
          <div>
            <label class="block text-xs font-bold text-slate-600 dark:text-slate-400 mb-2">
              Yabancı Dil Tazminatı (YDS / TOEFL / IELTS):
            </label>
            <div class="grid grid-cols-2 sm:grid-cols-4 gap-2.5">
              <label class="cursor-pointer">
                <input type="radio" name="lang_level" value="none" class="peer sr-only" />
                <div class="p-3 rounded-2xl border-2 border-slate-200 dark:border-slate-800 peer-checked:border-sky-500 peer-checked:bg-sky-50/50 dark:peer-checked:bg-sky-950/40 text-center transition-all h-full flex flex-col justify-center">
                  <span class="block font-bold text-xs text-slate-800 dark:text-slate-200">Yok / Temel</span>
                  <span class="text-[10px] text-slate-400 mt-0.5">Tazminat Yok</span>
                </div>
              </label>

              <label class="cursor-pointer">
                <input type="radio" name="lang_level" value="yds_c" class="peer sr-only" />
                <div class="p-3 rounded-2xl border-2 border-slate-200 dark:border-slate-800 peer-checked:border-sky-500 peer-checked:bg-sky-50/50 dark:peer-checked:bg-sky-950/40 text-center transition-all h-full flex flex-col justify-center">
                  <span class="block font-bold text-xs text-slate-800 dark:text-slate-200">YDS C (70 - 79)</span>
                  <span class="text-[10px] text-emerald-500 font-bold mt-0.5">+2.000 TL/ay</span>
                </div>
              </label>

              <label class="cursor-pointer">
                <input type="radio" name="lang_level" value="yds_b" class="peer sr-only" checked />
                <div class="p-3 rounded-2xl border-2 border-slate-200 dark:border-slate-800 peer-checked:border-sky-500 peer-checked:bg-sky-50/50 dark:peer-checked:bg-sky-950/40 text-center transition-all h-full flex flex-col justify-center">
                  <span class="block font-bold text-xs text-slate-800 dark:text-slate-200">YDS B (80 - 89)</span>
                  <span class="text-[10px] text-emerald-500 font-bold mt-0.5">+4.500 TL/ay</span>
                </div>
              </label>

              <label class="cursor-pointer">
                <input type="radio" name="lang_level" value="yds_a" class="peer sr-only" />
                <div class="p-3 rounded-2xl border-2 border-slate-200 dark:border-slate-800 peer-checked:border-sky-500 peer-checked:bg-sky-50/50 dark:peer-checked:bg-sky-950/40 text-center transition-all h-full flex flex-col justify-center">
                  <span class="block font-bold text-xs text-slate-800 dark:text-slate-200">YDS A (90 - 100)</span>
                  <span class="text-[10px] text-emerald-500 font-bold mt-0.5">+8.500 TL/ay</span>
                </div>
              </label>
            </div>
            
            <div class="mt-2.5">
              <label class="inline-flex items-center gap-2 cursor-pointer text-xs font-semibold text-slate-700 dark:text-slate-300">
                <input type="checkbox" id="calc-second-lang" class="rounded border-slate-300 dark:border-slate-700 text-brand-600 focus:ring-0 w-4 h-4" />
                <span>İkinci Yabancı Dil Tazminatı Mevcut (+3.000 TL / ay net katkı)</span>
              </label>
            </div>
          </div>

          <!-- Mesleki Sertifikalar (CIA, CISA, SPL, CAMS) -->
          <div>
            <label class="block text-xs font-bold text-slate-600 dark:text-slate-400 mb-2">
              Mesleki Sertifikasyon Tazminatları (Bordroya Yansıyan Net Ek Ödemeler):
            </label>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-2.5">
              <label class="flex items-center gap-2.5 p-3 rounded-2xl border-2 border-slate-200 dark:border-slate-800 hover:border-slate-300 dark:hover:border-slate-700 cursor-pointer bg-slate-50/50 dark:bg-slate-900/40 transition-colors">
                <input type="checkbox" name="cert" value="cia" class="rounded border-slate-300 dark:border-slate-700 text-sky-500 focus:ring-0 w-4 h-4 cert-checkbox" />
                <div class="text-xs">
                  <span class="font-bold text-slate-900 dark:text-white block">CIA (Uluslararası İç Denetçi)</span>
                  <span class="text-[10.5px] text-sky-600 dark:text-sky-400 font-semibold">+5.000 TL / ay net</span>
                </div>
              </label>

              <label class="flex items-center gap-2.5 p-3 rounded-2xl border-2 border-slate-200 dark:border-slate-800 hover:border-slate-300 dark:hover:border-slate-700 cursor-pointer bg-slate-50/50 dark:bg-slate-900/40 transition-colors">
                <input type="checkbox" name="cert" value="cisa" class="rounded border-slate-300 dark:border-slate-700 text-sky-500 focus:ring-0 w-4 h-4 cert-checkbox" />
                <div class="text-xs">
                  <span class="font-bold text-slate-900 dark:text-white block">CISA (Bilgi Sistemleri Denetçisi)</span>
                  <span class="text-[10.5px] text-sky-600 dark:text-sky-400 font-semibold">+6.500 TL / ay net</span>
                </div>
              </label>

              <label class="flex items-center gap-2.5 p-3 rounded-2xl border-2 border-slate-200 dark:border-slate-800 hover:border-slate-300 dark:hover:border-slate-700 cursor-pointer bg-slate-50/50 dark:bg-slate-900/40 transition-colors">
                <input type="checkbox" name="cert" value="spl3" class="rounded border-slate-300 dark:border-slate-700 text-sky-500 focus:ring-0 w-4 h-4 cert-checkbox" />
                <div class="text-xs">
                  <span class="font-bold text-slate-900 dark:text-white block">SPL Düzey 3 / Türev Araçlar</span>
                  <span class="text-[10.5px] text-sky-600 dark:text-sky-400 font-semibold">+3.500 TL / ay net</span>
                </div>
              </label>

              <label class="flex items-center gap-2.5 p-3 rounded-2xl border-2 border-slate-200 dark:border-slate-800 hover:border-slate-300 dark:hover:border-slate-700 cursor-pointer bg-slate-50/50 dark:bg-slate-900/40 transition-colors">
                <input type="checkbox" name="cert" value="cams" class="rounded border-slate-300 dark:border-slate-700 text-sky-500 focus:ring-0 w-4 h-4 cert-checkbox" />
                <div class="text-xs">
                  <span class="font-bold text-slate-900 dark:text-white block">CAMS (Uluslararası AML Uzmanı)</span>
                  <span class="text-[10.5px] text-sky-600 dark:text-sky-400 font-semibold">+4.500 TL / ay net</span>
                </div>
              </label>
            </div>
          </div>
        </div>

      </div>

      <!-- Result Dashboard (5 Cols Sticky) -->
      <div class="lg:col-span-5 bg-gradient-to-br from-[#07192b] via-[#09223b] to-[#04101d] rounded-3xl p-6 sm:p-8 text-white border-2 border-brand-800 shadow-2xl sticky top-24 space-y-6">
        
        <!-- Header Total -->
        <div class="pb-6 border-b border-brand-800/80">
          <span class="text-[11px] font-black uppercase tracking-wider text-amber-400 bg-amber-950/60 px-3 py-1 rounded-full border border-amber-800/60 inline-block mb-3">
            Aylık Ortalama Net Ele Geçen (Take-Home Pay)
          </span>
          <div class="flex items-baseline gap-2">
            <span id="result-total" class="text-4xl sm:text-5xl font-black text-amber-400 tracking-tight">142.100</span>
            <span class="text-xl font-bold text-slate-300">TL / Ay</span>
          </div>
          <p class="text-xs text-slate-400 mt-2 leading-relaxed">
            Sabit çıplak maaş, turne harcırahı (vergiden muaf), aylık ikramiye karşılığı ve tüm tazminatlar dahil fiili aylık nakit tutar.
          </p>
        </div>

        <!-- Annual Projection -->
        <div class="p-4 rounded-2xl bg-white/5 border border-white/10 flex items-center justify-between">
          <div>
            <span class="text-[11px] text-slate-400 block font-medium">Yıllık Toplam Net Paket:</span>
            <span id="result-annual" class="text-lg font-black text-white">1.705.200 TL</span>
          </div>
          <span class="text-[11px] font-bold text-emerald-400 bg-emerald-950/70 border border-emerald-500/30 px-2.5 py-1 rounded-lg">
            12 Ay Kümülatif
          </span>
        </div>

        <!-- Breakdown List -->
        <div class="space-y-2.5 text-xs font-semibold">
          <div class="flex items-center justify-between p-3 rounded-xl bg-slate-900/80 border border-slate-800">
            <span class="text-slate-300">Net Sabit Çıplak Maaş:</span>
            <span id="result-salary" class="font-bold text-white text-sm">86.000 TL</span>
          </div>

          <div class="flex items-center justify-between p-3 rounded-xl bg-slate-900/80 border border-slate-800">
            <div class="flex flex-col">
              <span class="text-slate-300">Turne Harcırahı:</span>
              <span id="result-harcirah-sub" class="text-[10px] text-emerald-400 font-normal">14 gün x 2.400 TL (Vergisiz net)</span>
            </div>
            <span id="result-harcirah" class="font-bold text-emerald-400 text-sm">33.600 TL</span>
          </div>

          <div class="flex items-center justify-between p-3 rounded-xl bg-slate-900/80 border border-slate-800">
            <div class="flex flex-col">
              <span class="text-slate-300">Aylık İkramiye / Prim Payı:</span>
              <span id="result-ikramiye-sub" class="text-[10px] text-slate-400 font-normal">16 Maaş (Maaşın 1/3'ü)</span>
            </div>
            <span id="result-ikramiye" class="font-bold text-sky-400 text-sm">28.667 TL</span>
          </div>

          <div class="flex items-center justify-between p-3 rounded-xl bg-slate-900/80 border border-slate-800">
            <span class="text-slate-300">Yabancı Dil Tazminatı:</span>
            <span id="result-dil" class="font-bold text-amber-300 text-sm">4.500 TL</span>
          </div>

          <div class="flex items-center justify-between p-3 rounded-xl bg-slate-900/80 border border-slate-800">
            <span class="text-slate-300">Mesleki Sertifika Tazminatı:</span>
            <span id="result-cert" class="font-bold text-purple-300 text-sm">0 TL</span>
          </div>
        </div>

        <!-- Composition Bar Indicator -->
        <div class="p-3.5 rounded-2xl bg-slate-900/60 border border-slate-800 space-y-2">
          <div class="flex items-center justify-between text-[11px]">
            <span class="text-slate-400">Turne Harcırahının Gelirdeki Payı:</span>
            <span id="harcirah-ratio" class="font-black text-amber-400">%24</span>
          </div>
          <div class="w-full h-2 rounded-full bg-slate-800 overflow-hidden flex">
            <div id="ratio-bar-salary" class="h-full bg-sky-500" style="width: 60%"></div>
            <div id="ratio-bar-bonus" class="h-full bg-blue-400" style="width: 20%"></div>
            <div id="ratio-bar-harcirah" class="h-full bg-emerald-400" style="width: 20%"></div>
          </div>
          <div class="flex items-center justify-between text-[9.5px] text-slate-400 pt-1">
            <span class="flex items-center gap-1"><span class="w-2 h-2 rounded-full bg-sky-500 inline-block"></span> Maaş</span>
            <span class="flex items-center gap-1"><span class="w-2 h-2 rounded-full bg-blue-400 inline-block"></span> İkramiye</span>
            <span class="flex items-center gap-1"><span class="w-2 h-2 rounded-full bg-emerald-400 inline-block"></span> Harcırah</span>
          </div>
        </div>

        <!-- Action Links -->
        <div class="pt-2 space-y-2.5 text-xs">
          <a href="/banka-mufettisi-nasil-olunur-adim-adim-2026-kariyer-rehberi/" class="block w-full py-3.5 rounded-2xl bg-amber-500 hover:bg-amber-400 text-slate-950 font-black text-center transition-colors shadow-md">
            Müfettişlik Sınavına Nasıl Hazırlanılır? →
          </a>
          <a href="/2026-banka-mufettisi-maaslari-kamu-ve-ozel-bankalarda-net-rakamlar-kidem-ve-ikramiyeler/" class="block w-full py-3 rounded-2xl bg-white/10 hover:bg-white/20 text-white font-bold text-center transition-colors">
            2026 Maaş ve Harcırah Araştırma Raporunu Oku
          </a>
        </div>

      </div>

    </div>

    <!-- Editorial Knowledge & Methodology Box -->
    <div class="mt-16 p-6 sm:p-8 rounded-3xl bg-white dark:bg-[#0c1827] border-2 border-slate-200 dark:border-slate-800 text-xs text-slate-600 dark:text-slate-400 leading-relaxed shadow-sm">
      <h3 class="text-sm font-black text-slate-900 dark:text-white uppercase tracking-wider mb-3 flex items-center gap-2">
        <svg class="w-4 h-4 text-brand-600 dark:text-sky-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
        2026 Banka Teftiş Kurulu Bordro Hesaplama Metodolojisi
      </h3>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6 pt-2">
        <div>
          <h4 class="font-bold text-slate-800 dark:text-slate-200 mb-1">1. GVK Madde 24 ve Harcırah İstisnası:</h4>
          <p>
            Müfettiş harcırahları Gelir Vergisi Kanunu 24. maddesi gereğince gelir vergisinden istisnadır. Dolayısıyla turne harcırahı brüt değil, doğrudan net nakit olarak müfettişin hesabına yatar ve vergi dilimlerinden etkilenmez.
          </p>
        </div>
        <div>
          <h4 class="font-bold text-slate-800 dark:text-slate-200 mb-1">2. 16 Maaş ve İkramiye Dinamiği:</h4>
          <p>
            Kamu bankaları (Ziraat, Halk, Vakıf) ve Türkiye İş Bankası 12 maaş + 4 ikramiye (toplam 16 maaş) sistemiyle çalışır. İkramiyeler genellikle Mart, Haziran, Eylül ve Aralık aylarında ödenir. Hesaplayıcı, aylık ortalama nakit akışını gösterebilmek adına bu tutarı aylık 1/3 oranında dağıtır.
          </p>
        </div>
        <div>
          <h4 class="font-bold text-slate-800 dark:text-slate-200 mb-1">3. Yabancı Dil ve Sertifika Primleri:</h4>
          <p>
            Kamu bankalarında YDS tazminatları sabit gösterge katsayılarıyla belirlenirken, büyük özel bankalarda YDS A / TOEFL seviyesi için bordroya 8.500 - 12.000 TL bandında sabit net dil tazminatı eklenir. CIA ve CISA sertifikaları ise unvana ek aylık mesleki uzmanlık primi sağlar.
          </p>
        </div>
      </div>
    </div>

  </div>

  <script>
    // 1. Element Selectors
    const bankRadios = document.querySelectorAll('input[name="bank_type"]');
    const titleSelect = document.getElementById('calc-title') as HTMLSelectElement;
    const bonusRadios = document.querySelectorAll('input[name="bonus_model"]');
    const turneInput = document.getElementById('calc-turne') as HTMLInputElement;
    const turneDisplay = document.getElementById('turne-display');
    const dailyHarcirahRateDisplay = document.getElementById('daily-harcirah-rate');
    const langRadios = document.querySelectorAll('input[name="lang_level"]');
    const secondLangCheckbox = document.getElementById('calc-second-lang') as HTMLInputElement;
    const certCheckboxes = document.querySelectorAll('.cert-checkbox');

    // Outputs
    const resultTotal = document.getElementById('result-total');
    const resultAnnual = document.getElementById('result-annual');
    const resultSalary = document.getElementById('result-salary');
    const resultHarcirah = document.getElementById('result-harcirah');
    const resultHarcirahSub = document.getElementById('result-harcirah-sub');
    const resultIkramiye = document.getElementById('result-ikramiye');
    const resultIkramiyeSub = document.getElementById('result-ikramiye-sub');
    const resultDil = document.getElementById('result-dil');
    const resultCert = document.getElementById('result-cert');
    const harcirahRatioDisplay = document.getElementById('harcirah-ratio');
    const ratioBarSalary = document.getElementById('ratio-bar-salary');
    const ratioBarBonus = document.getElementById('ratio-bar-bonus');
    const ratioBarHarcirah = document.getElementById('ratio-bar-harcirah');

    // 2. Real Data Matrices (2026 Net Averages in TL)
    
    // Base Net Salaries by Bank Type & Title
    const baseSalaries: Record<string, Record<string, number>> = {
      kamu: {
        yardimci: 68500,
        yetkili: 86000,
        basmufettis: 114000,
        it_denetci: 90000,
        uyum: 76000
      },
      ozel: {
        yardimci: 76000,
        yetkili: 104000,
        basmufettis: 142000,
        it_denetci: 118000,
        uyum: 92000
      },
      katilim: {
        yardimci: 66000,
        yetkili: 84000,
        basmufettis: 110000,
        it_denetci: 88000,
        uyum: 74000
      },
      regulator: {
        yardimci: 78000,
        yetkili: 98000,
        basmufettis: 134000,
        it_denetci: 112000,
        uyum: 90000
      }
    };

    // Daily Net Harcırah Rates (TL per day)
    const dailyHarcirahRates: Record<string, Record<string, number>> = {
      kamu: {
        yardimci: 2000,
        yetkili: 2400,
        basmufettis: 2900,
        it_denetci: 2500,
        uyum: 1800
      },
      ozel: {
        yardimci: 2500,
        yetkili: 3000,
        basmufettis: 3700,
        it_denetci: 3200,
        uyum: 2200
      },
      katilim: {
        yardimci: 1900,
        yetkili: 2300,
        basmufettis: 2800,
        it_denetci: 2400,
        uyum: 1700
      },
      regulator: {
        yardimci: 2200,
        yetkili: 2700,
        basmufettis: 3300,
        it_denetci: 2800,
        uyum: 2000
      }
    };

    // Language Indemnity (Fixed TL amount based on institution & bracket)
    const langIndemnity: Record<string, Record<string, number>> = {
      kamu: {
        none: 0,
        yds_c: 1800,
        yds_b: 3500,
        yds_a: 5500
      },
      ozel: {
        none: 0,
        yds_c: 3000,
        yds_b: 6500,
        yds_a: 11000
      },
      katilim: {
        none: 0,
        yds_c: 2000,
        yds_b: 4000,
        yds_a: 7000
      },
      regulator: {
        none: 0,
        yds_c: 2500,
        yds_b: 5000,
        yds_a: 8500
      }
    };

    // Certification Bonuses (Fixed TL per month net)
    const certBonuses: Record<string, number> = {
      cia: 5000,
      cisa: 6500,
      spl3: 3500,
      cams: 4500
    };

    function calculate() {
      // 1. Get Bank Type
      let bank = 'kamu';
      bankRadios.forEach(r => {
        if ((r as HTMLInputElement).checked) bank = (r as HTMLInputElement).value;
      });

      // 2. Get Title
      const title = titleSelect.value;

      // 3. Get Bonus Model
      let bonusModel = '16_maas';
      bonusRadios.forEach(r => {
        if ((r as HTMLInputElement).checked) bonusModel = (r as HTMLInputElement).value;
      });

      // 4. Get Turne Days
      const turneDays = parseInt(turneInput.value, 10);
      if (turneDisplay) turneDisplay.textContent = `${turneDays} Gün`;

      // 5. Get Language Level
      let langLevel = 'yds_b';
      langRadios.forEach(r => {
        if ((r as HTMLInputElement).checked) langLevel = (r as HTMLInputElement).value;
      });

      const hasSecondLang = secondLangCheckbox ? secondLangCheckbox.checked : false;

      // 6. Compute Base Salary
      const baseSalary = baseSalaries[bank]?.[title] || 80000;

      // 7. Compute Harcırah
      const dailyRate = dailyHarcirahRates[bank]?.[title] || 2200;
      if (dailyHarcirahRateDisplay) {
        dailyHarcirahRateDisplay.textContent = `${dailyRate.toLocaleString('tr-TR')} TL / Gün`;
      }
      const monthlyHarcirah = turneDays * dailyRate;

      // 8. Compute Monthly Bonus Equivalent
      let monthlyBonus = 0;
      if (bonusModel === '16_maas') {
        // 4 net salaries per year spread into 12 months: baseSalary * 4 / 12 = baseSalary / 3
        monthlyBonus = Math.round(baseSalary / 3);
        if (resultIkramiyeSub) resultIkramiyeSub.textContent = '16 Maaş (Maaşın 1/3’ü)';
      } else if (bonusModel === 'performans') {
        // Average 3 salaries annual performance bonus: baseSalary * 3 / 12 = baseSalary * 0.25
        monthlyBonus = Math.round(baseSalary * 0.25);
        if (resultIkramiyeSub) resultIkramiyeSub.textContent = 'Yıllık 3 Maaş Prim Karşılığı';
      } else {
        monthlyBonus = 0;
        if (resultIkramiyeSub) resultIkramiyeSub.textContent = 'İkramiyesiz Düz Maaş';
      }

      // 9. Compute Language Indemnity
      let langBonus = langIndemnity[bank]?.[langLevel] || 0;
      if (hasSecondLang) {
        langBonus += 3000;
      }

      // 10. Compute Certifications
      let certTotal = 0;
      certCheckboxes.forEach(cb => {
        if ((cb as HTMLInputElement).checked) {
          const certKey = (cb as HTMLInputElement).value;
          certTotal += (certBonuses[certKey] || 0);
        }
      });

      // 11. Total Monthly Take-Home Pay
      const totalMonthly = baseSalary + monthlyHarcirah + monthlyBonus + langBonus + certTotal;
      const totalAnnual = totalMonthly * 12;

      // 12. Harcırah Ratio
      const harcirahRatio = totalMonthly > 0 ? Math.round((monthlyHarcirah / totalMonthly) * 100) : 0;
      const salaryRatio = totalMonthly > 0 ? Math.round((baseSalary / totalMonthly) * 100) : 60;
      const bonusRatio = totalMonthly > 0 ? Math.round((monthlyBonus / totalMonthly) * 100) : 20;

      // 13. Update DOM
      if (resultTotal) resultTotal.textContent = totalMonthly.toLocaleString('tr-TR');
      if (resultAnnual) resultAnnual.textContent = `${totalAnnual.toLocaleString('tr-TR')} TL`;
      if (resultSalary) resultSalary.textContent = `${baseSalary.toLocaleString('tr-TR')} TL`;
      if (resultHarcirah) resultHarcirah.textContent = `${monthlyHarcirah.toLocaleString('tr-TR')} TL`;
      if (resultHarcirahSub) {
        resultHarcirahSub.textContent = `${turneDays} gün x ${dailyRate.toLocaleString('tr-TR')} TL (Vergisiz net)`;
      }
      if (resultIkramiye) resultIkramiye.textContent = `${monthlyBonus.toLocaleString('tr-TR')} TL`;
      if (resultDil) resultDil.textContent = `${langBonus.toLocaleString('tr-TR')} TL`;
      if (resultCert) resultCert.textContent = `${certTotal.toLocaleString('tr-TR')} TL`;

      if (harcirahRatioDisplay) harcirahRatioDisplay.textContent = `%${harcirahRatio}`;
      if (ratioBarSalary) ratioBarSalary.style.width = `${salaryRatio}%`;
      if (ratioBarBonus) ratioBarBonus.style.width = `${bonusRatio}%`;
      if (ratioBarHarcirah) ratioBarHarcirah.style.width = `${harcirahRatio}%`;
    }

    // Attach Event Listeners
    bankRadios.forEach(r => r.addEventListener('change', calculate));
    titleSelect.addEventListener('change', calculate);
    bonusRadios.forEach(r => r.addEventListener('change', calculate));
    turneInput.addEventListener('input', calculate);
    langRadios.forEach(r => r.addEventListener('change', calculate));
    if (secondLangCheckbox) secondLangCheckbox.addEventListener('change', calculate);
    certCheckboxes.forEach(cb => cb.addEventListener('change', calculate));

    // Run initial calculation
    calculate();
  </script>
</Layout>
